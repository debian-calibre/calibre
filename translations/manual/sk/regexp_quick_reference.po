msgstr "zalomenie riadku"

#: ../../../__w/calibre/calibre/manual/regexp_quick_reference.rst:280
msgid "``\\x20``"
msgstr "``\\x20``"

#: ../../../__w/calibre/calibre/manual/regexp_quick_reference.rst:280
