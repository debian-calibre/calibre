msgstr "Upraviť obsah"

#: ../../../__w/calibre/calibre/manual/gui.rst:933
msgid ":kbd:`M`"
msgstr ":kbd:`M`"

#: ../../../__w/calibre/calibre/manual/gui.rst:934
msgid "Merge selected records"
msgstr "Zlúčiť vybrané záznamy"

#: ../../../__w/calibre/calibre/manual/gui.rst:935
msgid ":kbd:`Alt+M`"
msgstr ":kbd:`Alt+M`"

#: ../../../__w/calibre/calibre/manual/gui.rst:936
msgid "Merge selected records, keeping originals"
msgstr "Zlúčiť vybrané záznamy a zachovať originály"

#: ../../../__w/calibre/calibre/manual/gui.rst:937
msgid ":kbd:`O`"
msgstr ":kbd:`O`"

#: ../../../__w/calibre/calibre/manual/gui.rst:938
msgid "Open containing folder"
msgstr "Otvoriť nadradený priečinok"

#: ../../../__w/calibre/calibre/manual/gui.rst:939
msgid ":kbd:`P`"
msgstr ":kbd:`P`"

#: ../../../__w/calibre/calibre/manual/gui.rst:940
msgid "Polish books"
msgstr "Vyleštiť knihy"

#: ../../../__w/calibre/calibre/manual/gui.rst:941
msgid ":kbd:`S`"
msgstr ":kbd:`S`"

#: ../../../__w/calibre/calibre/manual/gui.rst:943
