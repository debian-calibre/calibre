#: /__w/calibre/calibre/src/calibre/gui2/preferences/create_custom_column.py:427
msgid "Show heading to the side of the text"
msgstr "Показать заголовок сбоку от текста"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/create_custom_column.py:433
msgid ""
"Choose whether or not the column heading is shown in the Book details panel "
"and, if shown, where. Setting this to 'Show heading to the side of the text'"
" moves the information from displayed with other comments to displayed with "
"the non-comments columns."
msgstr "Выберите, будет ли заголовок столбца отображаться на панели сведений о книге, и если будет, то где. Установка для этого параметра значения «Показывать заголовок сбоку от текста» перемещает информацию из отображаемой с другими комментариями в отображаемую в столбцах без комментариев"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/create_custom_column.py:441
msgid "Heading position:"
msgstr "Размещение заголовка:"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/create_custom_column.py:446
msgid "Short text, like a title"
msgstr "Короткий текст, как название"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/create_custom_column.py:448
msgid "Plain text formatted using Markdown"
msgstr "Текст с форматированием Markdown"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/create_custom_column.py:452
msgid ""
"Choose how the data in this column is interpreted.\n"
"This controls how the data is displayed in the Book details panel\n"
"and how it is edited."
msgstr "Выберите способ интерпретации данных в этом столбце.\nЭто позволит управлять отображением данных на панели описания книги\nи их редактированием."

#: /__w/calibre/calibre/src/calibre/gui2/preferences/create_custom_column.py:454
msgid "Interpret this column as:"
msgstr "Интерпретировать этот столбец как:"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/create_custom_column.py:460
msgid ""
"A comma-separated list of permitted values. The empty value is always\n"
"included, and is the default. For example, the list 'one,two,three' has\n"
"four values, the first of them being the empty value."
msgstr "Разделённый запятыми список допустимых значений. Пустое значение \nвсегда включено и по умолчанию. Напр., список 'one,two,three' имеет \nчетыре значения и одно из них - пустое значение."

#: /__w/calibre/calibre/src/calibre/gui2/preferences/create_custom_column.py:465
msgid "&Values:"
msgstr "З&начения:"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/create_custom_column.py:467
msgid ""
"A list of color names to use when displaying an item. The\n"
"list must be empty or contain a color for each value."
msgstr "Список названий цветов, используемых при отображении элемента. \nСписок должен быть пуст или иметь цвет для каждого значения."

#: /__w/calibre/calibre/src/calibre/gui2/preferences/create_custom_column.py:468
msgid "Colors:"
msgstr "Цвета:"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/create_custom_column.py:471
msgid "Allow half stars"
msgstr "Разрешить половины звёзд"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/create_custom_column.py:472
msgid "Allow half star ratings, for example: "
msgstr "Разрешить оценки с половинками звёзд, напр.: "

#: /__w/calibre/calibre/src/calibre/gui2/preferences/create_custom_column.py:477
msgid "&Sort/search column by"
msgstr "&Сортировать/искать по столбцу по"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/create_custom_column.py:479
msgid "How this column should handled in the GUI when sorting and searching"
msgstr "Как обрабатывать этот столбец в интерфейсе при поиске и сортировке"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/create_custom_column.py:481
msgid "Show in Tag browser"
msgstr "Показать в браузере тегов"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/create_custom_column.py:482
msgid "If checked, this column will appear in the Tag browser as a category"
msgstr "Если отмечено, этот столбец появится в Браузере Тегов как категория"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/create_custom_column.py:484
msgid "Show as HTML in Book details"
msgstr "Показывать как HTML в описании книги"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/create_custom_column.py:488
#, python-brace-format
msgid ""
"If checked, this column will be displayed as HTML in Book details and the "
"Content server. This can be used to construct links with the template "
"language. For example, the template {0} will create a field displaying the "
"title in bold large characters, along with the series, for example "
"<br>\"<big><b>An Oblique Approach</b></big> [Belisarius [1]]\". The template"
" {1} will generate a link to the book on the Beam e-books site."
msgstr "Если этот флажок установлен, этот столбец будет отображаться в виде HTML в сведениях о книге и на сервере контента. Это можно использовать для создания связей с языком шаблонов. Напр., шаблон {0} создаст поле, отображающее заголовок жирным шрифтом и серию, напр. <br>\"<big><b>An Oblique Approach</b></big> [Belisarius [1]]\". Шаблон {1} создаст ссылку на книгу на сайте электронных книг Beam."

#: /__w/calibre/calibre/src/calibre/gui2/preferences/create_custom_column.py:507
msgid "Show with comments in Book details"
msgstr "Показать с комментариями в деталях книги"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/create_custom_column.py:511
msgid ""
"If you check this box then the column contents will show in the Comments "
"section in the Book details. You can indicate whether not to have a header "
"or to put a header above the column. If you want a header beside the data, "
"don't check this box. If this box is checked then the output of the column "
"template must be plain text or html."
msgstr "Если вы установите этот флажок, содержимое столбца будет отображаться в разделе «Комментарии» в сведениях о книге. Вы можете указать, следует ли не иметь заголовка или поместить заголовок над столбцом. Если вам нужен заголовок рядом с данными, не устанавливайте этот флажок. Если этот флажок установлен, вывод шаблона столбца должен быть простым текстом или html."

#: /__w/calibre/calibre/src/calibre/gui2/preferences/create_custom_column.py:530
msgid ""
"Choose whether or not the column heading is shown in the Book\n"
"details panel and, if shown, where"
msgstr "Выберите, будет ли заголовок столбца отображаться на панели описания\nкниги, и если да, то где"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/create_custom_column.py:531
msgid "Column heading:"
msgstr "Заголовок столбца:"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/create_custom_column.py:536
msgid "Store this column's value in an OPF"
msgstr "Хранить значение этого столбца в OPF"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/create_custom_column.py:540
msgid ""
"If you check this box then the result of evaluating this column's template "
"will be stored in the backup OPF stored in the library. The same is true "
"when sending to a device, assuming the format has an OPF. One reason to "
"uncheck this box is that the column contains large images."
msgstr "Если вы установите этот флажок, то результат оценки шаблона этого столбца будет сохранен в резервном файле OPF, хранящемся в библиотеке. То же самое верно при отправке на устройство, предполагая, что формат имеет OPF. Одна из причин снять этот флажок заключается в том, что столбец содержит изображения большого размера."

#: /__w/calibre/calibre/src/calibre/gui2/preferences/create_custom_column.py:549
msgid ""
"Note that some background functions require data for a column to be in the "
"OPF, for example book jackets. If you uncheck this box and some function "
"stops working then check the box."
msgstr "Обратите внимание, что некоторые фоновые функции требуют наличия данных для столбца в OPF, напр., для обложек книг. Если вы снимите этот флажок и какая-либо функция перестанет работать, установите флажок."

#: /__w/calibre/calibre/src/calibre/gui2/preferences/create_custom_column.py:564
msgid ""
"Default value when a new book is added to the library. For Date columns "
"enter the word \"Now\", or the date as yyyy-mm-dd. For Yes/No columns enter "
"\"Yes\" or \"No\". For Text with a fixed set of values enter one of the "
"permitted values. For Rating columns enter a number between 0 and 5."
msgstr "Значение по умолчанию при добавлении новой книги в библиотеку. Для столбцов «Дата» введите слово «Сейчас» или дату в формате ГГГГ-ММ-ДД. Для столбцов «Да/Нет» — «Да» или «Нет». Для «Текста с фиксированным набором значений» — одно из допустимых значений. Для столбцов «Оценка» — число между 0 и 5."

#: /__w/calibre/calibre/src/calibre/gui2/preferences/create_custom_column.py:572
msgid "&Default value:"
msgstr "&Значение по умолчанию:"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/create_custom_column.py:575
msgid "Search tem&plate:"
msgstr "Шаблон &поиска:"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/create_custom_column.py:581
#, python-brace-format
msgid ""
"Fill in this box if you want clicking on the value in book details to do a "
"web search instead of searching your calibre library. The book's metadata is"
" available to the template.</p><p>Additional fields '{0}', `{1}`, and '{2}' "
"are also available to the template. For multiple-valued (tags-like) columns "
"they are the value being examined, telling you which value to use to "
"generate the link. The two values '{1}' and '{2}' are automatically escaped "
"for use in URLs. In '{1}', spaces are replaced by plus signs. In '{2}' "
"spaces are replaced by '%20'.</p><p> The template functions '{3}' (the "
"easiest to use), '{4}', '{5}', and '{6}' are useful for constructing the "
"desired URL. There are examples in the template function documentation."
msgstr "Заполните это поле, если вы хотите, чтобы при нажатии на значение в сведениях о книге выполнялся поиск в Интернете, а не в вашей библиотеке calibre. Метаданные книги доступны в шаблоне.</p><p>Дополнительные поля '{0}', `{1}`, и '{2}' также доступны для шаблона. Для многозначных (похожих на теги) столбцов они являются проверяемым значением, указывающим вам, какое значение использовать для создания ссылки. Два значения '{1}' и '{2}' автоматически экранируются для использования в URL-адресах. В '{1}' пробелы заменяются знаками плюс. В '{2}' пробелы заменяются на '%20'. </p><p>Функции шаблона '{3}' (самая простая в использовании)), '{4}', '{5}', и '{6}' полезны для создания желаемого URL. Примеры приведены в документации по функции шаблона."

#: /__w/calibre/calibre/src/calibre/gui2/preferences/create_custom_column.py:635
#: /__w/calibre/calibre/src/calibre/gui2/preferences/create_custom_column.py:636
#: /__w/calibre/calibre/src/calibre/gui2/preferences/create_custom_column.py:637
#: /__w/calibre/calibre/src/calibre/gui2/preferences/create_custom_column.py:649
#: /__w/calibre/calibre/src/calibre/gui2/preferences/create_custom_column.py:650
#: /__w/calibre/calibre/src/calibre/gui2/preferences/create_custom_column.py:651
msgid "Item value"
msgstr "Значение пункта"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/create_custom_column.py:690
msgid "&Format for dates:"
msgstr "&Формат для дат:"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/create_custom_column.py:690
msgid "Default: dd MMM yyyy."
msgstr "По умолчанию: dd MMM yyyy"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/create_custom_column.py:693
msgid ""
"<p>Date format.</p><p>The formatting codes are:<ul><li>d    : the day as number without a leading zero (1 to 31)</li><li>dd   : the day as number with a leading zero (01 to 31)</li><li>ddd  : the abbreviated localized day name (e.g. \"Mon\" to \"Sun\").</li><li>dddd : the long localized day name (e.g. \"Monday\" to \"Sunday\").</li><li>M    : the <b>month</b> as number without a leading zero (1 to 12).</li><li>MM   : the <b>month</b> as number with a leading zero (01 to 12)</li><li>MMM  : the abbreviated localized <b>month</b> name (e.g. \"Jan\" to \"Dec\").</li><li>MMMM : the long localized <b>month</b> name (e.g. \"January\" to \"December\").</li><li>yy   : the year as two digit number (00 to 99).</li><li>yyyy : the year as four digit number.</li><li>h    : the hours without a leading 0 (0 to 11 or 0 to 23, depending on am/pm)</li><li>hh   : the hours with a leading 0 (00 to 11 or 00 to 23, depending on am/pm)</li><li>m    : the <b>minutes</b> without a leading 0 (0 to 59)</li><li>mm   : the <b>minutes</b> with a leading 0 (00 to 59)</li><li>s    : the seconds without a leading 0 (0 to 59)</li><li>ss   : the seconds with a leading 0 (00 to 59)</li><li>ap   : use a 12-hour clock instead of a 24-hour clock, with \"ap\" replaced by the localized string for am or pm</li><li>AP   : use a 12-hour clock instead of a 24-hour clock, with \"AP\" replaced by the localized string for AM or PM</li><li>iso  : the date with time and timezone. Must be the only format present</li></ul></p><p>For example:\n"
"<ul>\n"
"<li>ddd, d MMM yyyy gives Mon, 5 Jan 2010</li>\n"
"<li>dd MMMM yy gives 05 January 10</li>\n"
"</ul> "
msgstr "<p>Формат даты.</p><p>Коды форматирования:<ul><li>d    : день как число без ведущего нуля (1—31)</li><li>dd   : день как число с ведущим нулём (01—31)</li><li>ddd  : локализованная аббревиатура дня (пн — вс).</li><li>dddd : локализованное имя дня (понедельник — воскресенье).</li><li>M    : <b>месяц</b> как число без ведущего нуля (1—12).</li><li>MM   : <b>месяц</b> как число с ведущим нулём (01—12)</li><li>MMM  : локализованная аббревиатура имени <b>месяца</b> (янв. — дек.).</li><li>MMMM : локализованное имя <b>месяца</b> (январь — декабрь).</li><li>yy   : год как двузначное число (00—99).</li><li>yyyy : год как четырёхзначное число.</li><li>h    : часы без ведущего нуля (0—11 или 0—23, зависит от am/pm)</li><li>hh   : часы с ведущим нулём (00—11 или 00—23, зависит от am/pm)</li><li>m    : <b>минуты</b> без ведущего нуля (0—59)</li><li>mm   :  <b>минуты</b> с ведущим нулём (00—59)</li><li>s    : секунды без ведущего нуля (0—59)</li><li>ss   : секунды с ведущим нулём (00—59)</li><li>ap   : использовать вместо 24-часового формата 12-часовой с «ap» — локализованной строкой для am или pm</li><li>AP   : использовать вместо 24-часового формата 12-часовой с «AP» — локализованной строкой для AM или PM</li><li>iso  : дата с временем и временной зоной. Должен быть единственный формат</li></ul></p><p>Напр.:\n<ul>\n<li>ddd, d MMM yyyy даёт Пн, 5 янв. 2010</li>\n<li>dd MMMM yy даёт 05 Январь 10</li>\n</ul> "

#: /__w/calibre/calibre/src/calibre/gui2/preferences/create_custom_column.py:725
msgid "&Format for numbers:"
msgstr "&Формат для чисел:"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/create_custom_column.py:728
#, python-brace-format
msgid ""
"Default: Not formatted. For format language details see <a href=\"{}\">the "
"Python documentation</a>"
msgstr "По умолчанию: Не форматируется. Подробности о языке формата см. в <a href=\"{}\">документации Python</a>"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/create_custom_column.py:737
#, python-brace-format
msgid ""
"Examples: The format <code>{0:0>4d}</code> gives a 4-digit number with "
"leading zeros. The format <code>{0:d}&nbsp;days</code> prints the number "
"then the word \"days\""
msgstr "Примеры: Формат <code>{0:0>4d}</code> даёт 4-значное число с ведущими нулями. Формат <code>{0:d}&nbsp;дни</code> печает число, затем слово \"дни\""

#: /__w/calibre/calibre/src/calibre/gui2/preferences/create_custom_column.py:747
msgid ""
"Examples: The format <code>{0:.1f}</code> gives a floating point number with"
" 1 digit after the decimal point. The format "
"<code>Price:&nbsp;$&nbsp;{0:,.2f}</code> prints \"Price&nbsp;$&nbsp;\" then "
"displays the number with 2 digits after the decimal point and thousands "
"separated by commas."
msgstr "Примеры: Формат <code>{0:.1f}</code> даёт число с плавающей точкой с одной цифрой после запятой. Формат <code>Цена:&nbsp;$&nbsp;{0:,.2f}</code> печатает \"Цена&nbsp;$&nbsp;\", затем отображает число с двумя цифрами после запятой и тысячи, отделённые запятой."

#: /__w/calibre/calibre/src/calibre/gui2/preferences/create_custom_column.py:805
msgid "No lookup name was provided"
msgstr "Имя для поиска не введено"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/create_custom_column.py:810
msgid ""
"The lookup name must contain only lower case letters, digits and "
"underscores, and start with a letter"
msgstr "Имя для поиска должно содержать только строчные буквы, цифры, подчёркивания и начинаться с буквы"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/create_custom_column.py:815
msgid ""
"Lookup names cannot end with _index, because these names are reserved for "
"the index of a series column."
msgstr "Названия поиска не могут заканчиваться на _index, потому что эти названия зарезервированы для колонки индекса серий."

#: /__w/calibre/calibre/src/calibre/gui2/preferences/create_custom_column.py:826
msgid "No column heading was provided"
msgstr "Не указан заголовок столбца"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/create_custom_column.py:832
#, python-format
msgid "The lookup name %s is already used"
msgstr "Имя для поиска %s уже используется"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/create_custom_column.py:845
#, python-brace-format
msgid ""
"The heading {} is already used by another column. Creating a second column "
"with the same heading can be confusing. Are you sure?"
msgstr "Заголовок {} уже используется другим столбцом. Создание второго столбца с тем же заголовком может сбить с толку. Вы уверены?"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/create_custom_column.py:872
#: /__w/calibre/calibre/src/calibre/gui2/preferences/create_custom_column.py:914
#: /__w/calibre/calibre/src/calibre/gui2/preferences/create_custom_column.py:936
#: /__w/calibre/calibre/src/calibre/gui2/preferences/create_custom_column.py:950
#: /__w/calibre/calibre/src/calibre/gui2/preferences/create_custom_column.py:952
#: /__w/calibre/calibre/src/calibre/gui2/preferences/create_custom_column.py:958
msgid "Invalid default value"
msgstr "Неверное значение по умолчанию"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/create_custom_column.py:872
msgid "The default value must be \"Now\" or a date"
msgstr "Значение по умолчанию должно быть «Сейчас» или дата"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/create_custom_column.py:876
msgid "You must enter a template for composite columns"
msgstr "Вы должны ввести шаблон для составных столбцов"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/create_custom_column.py:895
msgid "You must enter at least one value for enumeration columns"
msgstr "Вы должны ввести хотя бы одно значение для столбца"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/create_custom_column.py:907
msgid ""
"The colors box must be empty or contain the same number of items as the "
"value box"
msgstr "Количество цветов должно соответствовать количеству значений либо быть пустым."

#: /__w/calibre/calibre/src/calibre/gui2/preferences/create_custom_column.py:910
#, python-brace-format
msgid "The color {0} is unknown"
msgstr "Цвет {0} неизвестен"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/create_custom_column.py:914
msgid "The default value must be one of the permitted values"
msgstr "Значение по умолчанию должно быть одним из допустимых значений"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/create_custom_column.py:928
msgid "The default value must be an integer"
msgstr "Значением по умолчанию должно быть целое число"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/create_custom_column.py:932
msgid "The default value must be a real number"
