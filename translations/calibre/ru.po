#: /__w/calibre/calibre/src/calibre/gui2/preferences/device_debug.py:21
msgid "Debug device detection"
msgstr "Отладка обнаружения устройства"

#: /__w/calibre/calibre/src/calibre/debug.py:75
msgid ""
"Run the GUI with debugging enabled. Debug output is printed to stdout and "
"stderr. To pass command line arguments use -- followed by the arguments, for"
" example: calibre-debug -g -- /path/to/ebook"
msgstr "Запустить графический интерфейс с включенной отладкой. Выходные данные отладки печатаются в stdout и stderr. Для передачи аргументов командной строки используйте --, за которым следуют аргументы, напр.: calibre-debug -g -- /path/to/ebook"

#: /__w/calibre/calibre/src/calibre/debug.py:84
msgid ""
"Run the GUI with a debug console, logging to the specified path. For "
"internal use only, use the -g option to run the GUI in debug mode"
msgstr "Запустить графический интерфейс с отладочной консолью, фиксируя указанный путь. Только для внутреннего использования. Используйте ключ -g чтобы запустить графический интерфейс в отладочном режиме."

#: /__w/calibre/calibre/src/calibre/debug.py:86
msgid "Don't run with the DEBUG flag set"
msgstr "Не запускать с установленным флагом DEBUG"

#: /__w/calibre/calibre/src/calibre/debug.py:92
msgid ""
"Run the E-book viewer in debug mode. As with -g use -- to pass command line "
"arguments."
msgstr "Запустите просмотрщик электронных книг в режиме отладки. Как и в случае с -g, используйте -- для передачи аргументов командной строки."

#: /__w/calibre/calibre/src/calibre/debug.py:98
msgid "Output the paths necessary to setup the calibre environment"
msgstr "Вывести пути, необходимые для установки окружения для calibre"

#: /__w/calibre/calibre/src/calibre/debug.py:103
msgid ""
"Add a simple plugin (i.e. a plugin that consists of only a .py file), by "
"specifying the path to the py file containing the plugin code."
msgstr "Добавить простой плагин (т.е. плагин, который состоит только из .py файла), указав путь к .py файлу, содержащему код плагина."

#: /__w/calibre/calibre/src/calibre/debug.py:110
msgid "Inspect the MOBI file(s) at the specified path(s)"
msgstr "Посмотреть MOBI файл(файлы) по указанному пути(путях)"

#: /__w/calibre/calibre/src/calibre/debug.py:116
msgid ""
"Launch the calibre \"Edit book\" tool in debug mode. As with -g use -- to "
"pass command line arguments."
msgstr "Запустить инструмент Calibre «Редактировать книгу» в режиме отладки. Как и в случае с -g, используйте -- для передачи аргументов командной строки."

#: /__w/calibre/calibre/src/calibre/debug.py:124
msgid ""
"Explode the book into the specified folder.\n"
"Usage: -x file.epub output_dir\n"
"Exports the book as a collection of HTML files and metadata, which you can edit using standard HTML editing tools. Works with EPUB, AZW3, HTMLZ and DOCX files."
msgstr "Взорвать книгу в указанную папку.\nИспользование: -x file.epub output_dir\nЭкспортирует книгу как набор файлов HTML и метаданных, которые можно редактировать с помощью стандартных инструментов редактирования HTML. Работает с файлами EPUB, AZW3, HTMLZ и DOCX."

#: /__w/calibre/calibre/src/calibre/debug.py:137
msgid ""
"Implode a previously exploded book.\n"
"Usage: -i output_dir file.epub\n"
"Imports the book from the files in output_dir which must have been created by a previous call to --explode-book. Be sure to specify the same file type as was used when exploding."
msgstr "Исправить ранее развернутую книгу.\nИспользование: -i output_dir file.epub\nИмпортировать книгу из файлов в output_dir, которые созданы предыдущим вызовом -explode-book. Используйте тот же тип файла, который был при разворачивании."

#: /__w/calibre/calibre/src/calibre/debug.py:148
msgid ""
"Export all calibre data (books/settings/plugins). Normally, you will be asked for the export folder and the libraries to export. You can also specify them as command line arguments to skip the questions. Use absolute paths for the export folder and libraries. The special keyword \"all\" can be used to export all libraries. Examples:\n"
"\n"
"  calibre-debug --export-all-calibre-data  # for interactive use\n"
"  calibre-debug --export-all-calibre-data /path/to/empty/export/folder /path/to/library/folder1 /path/to/library2\n"
"  calibre-debug --export-all-calibre-data /export/folder all  # export all known libraries"
msgstr "Экспортировать все данные calibre (книги/настройки/плагины). Обычно вас попросят указать папку экспорта и библиотеки для экспорта. Вы также можете указать их в качестве аргументов командной строки, чтобы пропустить вопросы. Используйте абсолютные пути для папки экспорта и библиотек. Специальное ключевое слово all можно использовать для экспорта всех библиотек. Примеры:\n\ncalibre-debug --export-all-calibre-data # для интерактивного использования\ncalibre-debug --export-all-cale-data /путь/к/пустому/экспорту/папке /путь/к/библиотеке/папке1 /путь/к/библиотеке2\ncalibre-debug --export-all-dication-data /export/folder all # экспортировать все известные библиотеки"

#: /__w/calibre/calibre/src/calibre/debug.py:158
msgid "Import previously exported calibre data"
msgstr "Импорт ранее экспортированных данных calibre"

#: /__w/calibre/calibre/src/calibre/debug.py:165
#: /__w/calibre/calibre/src/calibre/gui2/main.py:69
msgid ""
"Cause a running calibre instance, if any, to be shutdown. Note that if there"
" are running jobs, they will be silently aborted, so use with care."
msgstr "Завершает работу запущенного экземпляра calibre, если такой имеется. Обратите внимание, что прервутся все выполняющиеся задания, поэтому используйте с осторожностью."

#: /__w/calibre/calibre/src/calibre/debug.py:168
msgid "Test binary modules in build"
msgstr "Тест бинарных модулей в сборке"

#: /__w/calibre/calibre/src/calibre/debug.py:173
msgid ""
"Run a plugin that provides a command line interface. For example:\n"
"calibre-debug -r \"Plugin name\" -- file1 --option1\n"
"Everything after the -- will be passed to the plugin as arguments."
msgstr "Запустить плагин, обеспечивающий интерфейс командной строки. Напр.:\ncalibre-debug -r \"Plugin name\" -- file1 --option1\nВсё после -- будет передано плагину в качестве параметров."

#: /__w/calibre/calibre/src/calibre/debug.py:182
msgid ""
"Run the named test(s). Use the special value \"all\" to run all tests. If "
"the test name starts with a period it is assumed to be a module name. If the"
" test name starts with @ it is assumed to be a category name."
msgstr "Запустить упомянутый(-е) тест(-ы). Специальное значение all - запустить все тесты. Если имя теста начинается с точки, предполагается, что это имя модуля. Если имя теста начинается с @, предполагается, что это имя категории."

#: /__w/calibre/calibre/src/calibre/debug.py:191
msgid ""
"Run the calibre diff tool. For example:\n"
"calibre-debug --diff file1 file2"
msgstr "Запустить инструмент сравнения. Напр.:\ncalibre-debug --diff file1 file2"

#: /__w/calibre/calibre/src/calibre/debug.py:197
msgid "(Un)register calibre from Windows Default Programs."
msgstr "Добавить (убрать) Calibre в список программ по умолчанию Windows"

#: /__w/calibre/calibre/src/calibre/debug.py:203
msgid ""
"Convert the specified EPUB file to KEPUB without doing a full conversion. "
"This is what the Kobo driver does when sending files to the device."
msgstr "Конвертировать указанный файл EPUB в KEPUB без полной конвертации. Это то, что делает драйвер Kobo при отправке файлов на устройство."

#: /__w/calibre/calibre/src/calibre/debug.py:210
msgid ""
"Convert the specified KEPUB file to EPUB without doing a full conversion. "
"This is what the Kobo driver does when importing files from the device."
msgstr "Конвертировать указанный файл KEPUB в EPUB без полной конвертации. Это то, что делает драйвер Kobo при импорте файлов с устройства."

