#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/tb_icon_rules.py:506
msgid ""
"The name of the category. Select a cell in this column to delete a row."
msgstr "Название категории. Выберите ячейку в этом столбце, чтобы удалить строку."

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/tb_icon_rules.py:511
msgid ""
"The value in the category the rule is applied to. If the value doesn't exist"
" in the library then an error icon is shown, in which case you can edit the "
"cell to pick the correct value."
msgstr "Значение в категории, к которой применяется правило. Если значение не существует в библиотеке, отображается значок ошибки, и в этом случае вы можете отредактировать ячейку, чтобы выбрать правильное значение."

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/tb_icon_rules.py:519
msgid "This icon shows in the row if the icon or template is modified."
msgstr "Этот значок отображается в строке, если значок или шаблон изменены."

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/tb_icon_rules.py:521
msgid "The file name of the icon or the text of the template."
msgstr "Имя файла значка или текст шаблона."

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/tb_icon_rules.py:524
