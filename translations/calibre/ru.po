#: /__w/calibre/calibre/src/calibre/utils/smtp.py:231
msgid ""
"%prog [options] [from to text]\n"
"\n"
"Send mail using the SMTP protocol. %prog has two modes of operation. In the\n"
"compose mode you specify from to and text and these are used to build and\n"
"send an email message. In the filter mode, %prog reads a complete email\n"
"message from STDIN and sends it.\n"
"\n"
"text is the body of the email message.\n"
"If text is not specified, a complete email message is read from STDIN.\n"
"from is the email address of the sender and to is the email address\n"
"of the recipient. When a complete email is read from STDIN, from and to\n"
"are only used in the SMTP negotiation, the message headers are not modified.\n"
msgstr "%prog [опции] [от_кого кому текст]\n\nОтправить почту по протоколу SMTP. В %prog два режима работы. В режиме\nсочинения вы указываете «от_кого», «кому» и «текст» — всё это используется\nдля создания и отправки почтового сообщения. В режиме фильтра %prog\nсчитывает полное сообщение электронной почты из STDIN и отправляет его.\n\n«Текст» — это содержимое сообщения электронной почты.\nЕсли «текст» не задан, полное сообщение электронной почты считывается из STDIN.\n«От_кого» — адрес отправителя, а «кому» — адрес электронной почты получателя.\nКогда полное сообщение читается из STDIN, «от_кого» и «кому» используются только\nв согласовании SMTP, заголовки сообщения не меняются.\n"

#: /__w/calibre/calibre/src/calibre/utils/smtp.py:246
msgid "Options to compose an email. Ignored if text is not specified"
msgstr "Параметры для составления письма. Игнорируются, если текст не задан"

#: /__w/calibre/calibre/src/calibre/utils/smtp.py:247
msgid "File to attach to the email"
msgstr "Файл для прикрепления к электронному письму"

#: /__w/calibre/calibre/src/calibre/utils/smtp.py:248
msgid "Subject of the email"
msgstr "Тема письма"

#: /__w/calibre/calibre/src/calibre/utils/smtp.py:250
msgid "Host name of localhost. Used when connecting to SMTP server."
msgstr "Имя локального хоста. Испольуется при подключении к серверу SMTP."

#: /__w/calibre/calibre/src/calibre/utils/smtp.py:253
msgid ""
"Options to use an SMTP relay server to send mail. calibre will try to send "
"the email directly unless --relay is specified."
msgstr "Параметры для отправки почты через SMTP релей сервер. calibre попытается отправить письмо напрямую, если --relay не задан."

#: /__w/calibre/calibre/src/calibre/utils/smtp.py:255
msgid "An SMTP relay server to use to send mail."
msgstr "SMTP релей сервер для отправки почты."

#: /__w/calibre/calibre/src/calibre/utils/smtp.py:260
msgid ""
"Port to connect to on relay server. Default is to use 465 if encryption "
"method is SSL and 25 otherwise."
msgstr "Порт подключения к почтовому релей серверу. По-умолчанию 465, если используется SSL шифрование, иначе 25."

#: /__w/calibre/calibre/src/calibre/utils/smtp.py:262
msgid "Username for relay"
msgstr "Имя для релея"

#: /__w/calibre/calibre/src/calibre/utils/smtp.py:263
msgid "Password for relay"
msgstr "Пароль для релея"

#: /__w/calibre/calibre/src/calibre/utils/smtp.py:269
msgid ""
"Encryption method to use when connecting to relay. Choices are TLS, SSL and "
"NONE. Default is TLS. WARNING: Choosing NONE is highly insecure"
msgstr "Метод шифрования при подключении к релею. Выбор из TLS, SSL и NONE. По-умолчанию TLS. ВНИМАНИЕ: опция NONE крайне небезопасна"

#: /__w/calibre/calibre/src/calibre/utils/smtp.py:274
msgid ""
"Do not verify the server certificate when connecting using TLS. This used to"
" be the default behavior in calibre versions before 3.27. If you are using a"
" relay with a self-signed or otherwise invalid certificate, you can use this"
" option to restore the pre 3.27 behavior"
msgstr "Не проверять сертификат сервера при подключении с помощью TLS. Раньше это было поведение по умолчанию в calibre до 3.27. Если вы используется релей с самоподписанным или иным образом недействительным сертификатом, вы можете использовать этот параметр для восстановления поведения до 3.27"

#: /__w/calibre/calibre/src/calibre/utils/smtp.py:283
msgid ""
"Path to a file of concatenated CA certificates in PEM format, used to verify"
" the server certificate when using TLS. By default, the system CA "
"certificates are used."
msgstr "Путь к файлу конкатенированных сертификатов CA в формате PEM, используемому для проверки сертификата сервера при использовании TLS. По умолчанию используются системные CA сертификаты."

#: /__w/calibre/calibre/src/calibre/utils/smtp.py:287
msgid "Path to maildir folder to store failed email messages in."
msgstr "Путь к папке почты для хранения недоставленных сообщений."

#: /__w/calibre/calibre/src/calibre/utils/smtp.py:293
msgid ""
"Fork and deliver message in background. If you use this option, you should "
"also use --outbox to handle delivery failures."
msgstr "Ветвление и доставка сообщений в фоне. Если вы используете этот вариант, вы должны также использовать --outbox для обработки отказов доставки."

