#: /__w/calibre/calibre/src/calibre/gui2/preferences/coloring.py:303
msgid ""
"Enter either an identifier type or an identifier type and value of the form "
"identifier:value"
msgstr "Введите либо тип идентификатора, либо тип идентификатора и значение в виде идентификатор:значение"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/coloring.py:306
msgid ""
"Enter a 3 letter ISO language code, like fra for French or deu for German or"
" eng for English. You can also use the full language name, in which case "
"calibre will try to automatically convert it to the language code."
msgstr "Введите 3 буквы ISO кода языка, напр. fra для Французского или deu для Немецкого или eng для Английского. Также можно использовать полное имя языка -  calibre попытается преобразовать его в языковой код."

#: /__w/calibre/calibre/src/calibre/gui2/preferences/coloring.py:312
msgid "Enter a number"
msgstr "Введите число"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/coloring.py:318
msgid ""
"Enter the maximum days old the item can be. Zero is today. Dates in the "
"future always match"
msgstr "Введите максимальный возраст элемента в днях. Ноль — это сегодня. Дата в будущем всегда верна."

#: /__w/calibre/calibre/src/calibre/gui2/preferences/coloring.py:321
msgid ""
"Enter the minimum days old the item can be. Zero is today. Dates in the "
"future never match"
msgstr "Введите минимальный возраст элемента в днях. Ноль — это сегодня. Дата в будущем всегда неверна."

#: /__w/calibre/calibre/src/calibre/gui2/preferences/coloring.py:324
msgid ""
"Enter the maximum days in the future the item can be. Zero is today. Dates "
"in the past always match"
msgstr "Введите максимальное количество дней в будущем, в течении которых элемент действителен. Ноль — это сегодня. Дата в прошлом всегда верна."

#: /__w/calibre/calibre/src/calibre/gui2/preferences/coloring.py:327
msgid ""
"Enter the minimum days in the future the item can be. Zero is today. Dates "
"in the past never match"
msgstr "Введите минимальное количество дней в будущем, после которых элемент станет действителен. Ноль — это сегодня. Дата в прошлом всегда не верна."

#: /__w/calibre/calibre/src/calibre/gui2/preferences/coloring.py:330
