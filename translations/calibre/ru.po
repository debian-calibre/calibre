#: /__w/calibre/calibre/src/calibre/gui2/fts/utils.py:57
#, python-brace-format
msgid ""
"\n"
"<div class=\"h\">Search for single words</div>\n"
"<p>Simply type the word:</p>\n"
"<div class=\"bq\">awesome<br>calibre</div>\n"
"\n"
"<div class=\"h\">Search for phrases</div>\n"
"<p>Enclose the phrase in quotes:</p>\n"
"<div class=\"bq\">\"early run\"<br>\"song of love\"</div>\n"
"\n"
"<div class=\"h\">Boolean searches</div>\n"
"<div class=\"bq\">(calibre AND ebook) NOT gun<br>simple NOT (\"high bar\" OR hard)</div>\n"
"\n"
"<div class=\"h\">Phrases near each other</div>\n"
"<div class=\"bq\">NEAR(\"people\" \"in Asia\" \"try\")<br>NEAR(\"Kovid\" \"calibre\", 30)</div>\n"
"<p>Here, 30 is the most words allowed between near groups. Defaults to 10 when unspecified.</p>\n"
"\n"
"<div style=\"margin-top: 1em\"><a href=\"{fts_url}\">Complete syntax reference</a></div></div>"
msgstr "\n<div class=\"h\">Поиск отдельных слов</div>\n<p>Просто введите слово:</p>\n<div class=\"bq\">потрясающий <br>calibre\n</div>\n\n<div class=\"h\">Поиск фраз</div>\n<p>Заключите фразу в кавычки:</p>\n<div class=\"bq\">\"early run\" <br>\"song of love\"</div>\n\n\n<div class=\"h\">Логический поиск</div>\n<div class=\"bq\">(calibre AND ebook) NOT gun <br>simple NOT (\"high bar\" OR hard)</div>\n\n<div class=\"h\">Фразы рядом друг с другом</div>\n<div class=\"bq\">NEAR(\"people\" \"in Asia\" \"try\") <br>NEAR(\"Kovid\" \"calibre\", 30)</div>\n<p>Здесь 30 — максимальное количество слов, разрешенное между ближайшими группами. По умолчанию 10, если не указано.</p>\n\n<div style=\"margin-top: 1em\"><a href=\"{fts_url}\">Полная справка по синтаксису</a></div></div>"

