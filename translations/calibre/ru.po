msgid "Name:"
msgstr "Название:"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_saved_searches.py:60
msgid "Search string:"
msgstr "Строка поиска:"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_saved_searches.py:64
msgid "Error: You must specify a name and a search string"
msgstr "Ошибка: Вы должны указать имя и строку поиска"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_saved_searches.py:66
#: /__w/calibre/calibre/src/calibre/gui2/add_filters.py:128
msgid "added"
msgstr "добавлено"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_saved_searches.py:69
msgid "Error: You must specify a name"
msgstr "Ошибка: Вы должны указать имя"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_saved_searches.py:71
msgid "removed"
msgstr "удалено"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_saved_searches.py:73
#, python-format
msgid "Error: Action %s not recognized, must be one of: (add|remove|list)"
msgstr "Ошибка: Действие %s не распознано, должно быть одно из: (добавить(add)|удалить(remove)|список(list))"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_search.py:18
#, python-brace-format
msgid "Failed to parse search query: ({0}) with error: {1}"
msgstr "Не удалось проанализировать поисковый запрос: ({0}) с ошибкой: {1}"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_search.py:26
#, python-brace-format
msgid ""
"%prog search [options] search expression\n"
"\n"
"Search the library for the specified search term, returning a comma separated\n"
"list of book ids matching the search expression. The output format is useful\n"
"to feed into other commands that accept a list of ids as input.\n"
"\n"
"The search expression can be anything from calibre's powerful search query\n"
"language, for example: %prog search {0}\n"
msgstr "%prog search [опции] поисковое выражение\n\nИскать в библиотеке указанный поисковый запрос, возвращая разделенный запятыми\nсписок идентификаторов книг, соответствующих поисковому запросу. Формат вывода полезен\nдля подачи в другие команды, которые принимают список идентификаторов в качестве входных данных.\n\nВыражение поиска может быть любым из языка поисковых запросов calibre,\nнапр.: %prog search {0}\n"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_search.py:43
msgid "The maximum number of results to return. Default is all results."
msgstr "Максимальное число возвращаемых результатов. По умолчанию - все результаты."

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_search.py:59
msgid "No books matching the search expression:"
msgstr "Нет книг, соответствующих поисковому выражению:"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_set_custom.py:18
#, python-brace-format
msgid "No book with id {} exists"
msgstr "Не существует книги с ИД {}"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_set_custom.py:22
#, python-brace-format
msgid "No column with name {} exists"
msgstr "Не существует столбца с именем {}"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_set_custom.py:28
#, python-brace-format
msgid "Data set to: {} [{}]"
msgstr "Набор данных: {} [{}]"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_set_custom.py:36
#, python-brace-format
msgid "Data set to: {}"
msgstr "Набор данных: {}"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_set_custom.py:45
msgid ""
"%prog set_custom [options] column id value\n"
"\n"
"Set the value of a custom column for the book identified by id.\n"
"You can get a list of ids using the search command.\n"
"You can get a list of custom column names using the custom_columns\n"
"command.\n"
"    "
msgstr "%prog set_custom [options] column id value\n\nЗадать значение настраиваемого столбца для книги определяемой по id.\nCписок идентификаторов получается командой поиска.\nСписок пользовательских имен столбцов получается командой\ncustom_columns"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_set_custom.py:61
msgid ""
"If the column stores multiple values, append the specified values to the "
"existing ones, instead of replacing them."
msgstr "Если столбец содержит несколько значений, добавить указанное значение к существующим, а не заменять их."

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_set_custom.py:68
msgid "Error: You must specify a field name, id and value"
msgstr "Ошибка: Вы должны указать имя поля, идентификатор и значение"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_set_metadata.py:60
msgid ""
"\n"
"%prog set_metadata [options] book_id [/path/to/metadata.opf]\n"
"\n"
"Set the metadata stored in the calibre database for the book identified by\n"
"book_id from the OPF file metadata.opf. book_id is a book id number from the\n"
"search command. You can get a quick feel for the OPF format by using the\n"
"--as-opf switch to the show_metadata command. You can also set the metadata of\n"
"individual fields with the --field option. If you use the --field option, there\n"
"is no need to specify an OPF file.\n"
msgstr "\n%prog set_metadata [options] book_id [/path/to/metadata.opf]\n\nУстановить метаданные, хранящиеся в базе данных calibre для книги, указанной\nbook_id из файла metadata.opf OPF. book_id — это идентификационный номер книги из\nкоманды поиска. Можно получить представление о формате OPF, используя\n--as-opf переключившись на команду show_metadata. Также можно установить метаданные\nотдельных полей опцией --field. Если вы используете опцию --field,\nнет необходимости указывать файл OPF.\n"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_set_metadata.py:78
#, python-brace-format
msgid ""
"The field to set. Format is field_name:value, for example: {0} "
"tags:tag1,tag2. Use {1} to get a list of all field names. You can specify "
"this option multiple times to set multiple fields. Note: For languages you "
"must use the ISO639 language codes (e.g. en for English, fr for French and "
"so on). For identifiers, the syntax is {0} {2}. For boolean (yes/no) fields "
"use true and false or yes and no."
msgstr "Поле для установки. Формат название_поля:значение. Напр.: {0} tags:tag1,tag2. Используйте {1} чтобы получить список названий полей. Вы можете указать эту настройку несколько раз для установки нескольких полей. Помните: для языков вы должны использовать ISO639 языковую кодировку (то есть en для English, fr для French и т.д.). Для идентификаторов, синтаксис {0} {2}. Для булевых (да/нет) полей используйте true и false или yes и no."

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_set_metadata.py:92
msgid "List the metadata field names that can be used with the --field option"
msgstr "Список названий полей метаданных, которые могут быть использованы с опцией --field."

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_set_metadata.py:116
msgid "Field name"
msgstr "Название поля"

