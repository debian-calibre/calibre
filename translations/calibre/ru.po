#: /__w/calibre/calibre/src/calibre/gui2/preferences/metadata_sources_ui.py:160
msgid ""
"Disable any metadata sources you do not want by unchecking them. You can "
"also set the cover priority. Covers from sources that have a higher "
"(smaller) priority will be preferred when bulk downloading metadata."
msgstr "Отключите любые нежелательные источники метаданных, сняв их флажок. Вы также можете установить приоритет обложки. Обложки из источников, имеющих более высокий (меньший) приоритет, будут предпочтительнее при массовой загрузке метаданных."

#: /__w/calibre/calibre/src/calibre/gui2/preferences/metadata_sources_ui.py:161
msgid ""
"Sources with a red X next to their names must be configured before they will"
" be used. "
msgstr "Источники с красным «X» возле имени нужно настроить перед использованием."

#: /__w/calibre/calibre/src/calibre/gui2/preferences/metadata_sources_ui.py:162
msgid "C&onfigure selected source"
msgstr "&Конфигурировать выбранный источник"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/metadata_sources_ui.py:163
msgid "&Add new source"
msgstr "&Добавить новый источник"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/metadata_sources_ui.py:165
msgid ""
"If you uncheck any fields, metadata for those fields will not be downloaded"
msgstr "Если снять флажок с каких-либо полей, метаданные для них загружены не будут"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/metadata_sources_ui.py:166
