#: /__w/calibre/calibre/src/calibre/db/cli/cmd_set_metadata.py:174
#, python-format
msgid "No book with id: %s in the database"
msgstr "В базе данных не найдено книг с ИД: %s"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_set_metadata.py:155
#, python-brace-format
msgid "{} is not a known field"
msgstr "{} неизвестное поле"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_set_metadata.py:169
