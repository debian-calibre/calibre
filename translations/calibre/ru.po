#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/main_interface_ui.py:190
msgid "E&xtra spacing to add between rows in the book list (can be negative):"
msgstr "Добаво&чный интервал между строками в списке книг (можно отрицательный):"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/main_interface_ui.py:191
msgid ""
"Disable popup notifications when calibre completes jobs such a conversion, "
"sending to device etc. The notifications are sent via the operating system "
"notification facility, if available."
msgstr "Отключить всплывающие уведомления, когда calibre завершает такие задачи, как преобразование книг, отправка на устройство и т. п. Уведомления отправляются средствами операционной системы при их доступности."

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/main_interface_ui.py:192
msgid "Disable n&otifications on job completion"
msgstr "Отключить у&ведомления по завершении задания"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/main_interface_ui.py:193
msgid "Adjust &colors"
msgstr "Настроить &цвета"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/main_interface_ui.py:194
msgid "Enable s&ystem tray icon (needs restart)"
msgstr "Включить значок в систем&ном трее (требуется перезапуск)"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/quickview_ui.py:58
msgid ""
"<p>Check this box to make Quickview show books only in the\n"
"current Virtual library. If unchecked, Quickview ignores Virtual libraries. If\n"
"unchecked then only row changes are taken into account.</p>"
msgstr "<p>Отметьте, чтобы быстрый просмотр показывал книги только в текущей\nвиртуальной библиотеке. Если не отмечено, быстрый просмотр\nигнорирует виртуальные библиотеки, и учитываются только изменения строк.</p>"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/quickview_ui.py:62
msgid ""
"<p>Check this box to make Quickview change the column being examined\n"
"when the column in the book list is changed using the cursor arrow keys</p>"
msgstr "<p>Отметьте, чтобы быстрый просмотр менял проверяемый\nстолбец при смене столбца в списке книг клавишами со стрелками</p>"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/quickview_ui.py:64
msgid "&Change Quickview item when book list column changes"
msgstr "&Изменять элемент Быстрого Просмотра при смене столбца в списке книг"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/quickview_ui.py:65
msgid ""
"<p>Pressing Enter in a cell changes both the book and the\n"
"column being examined (the left-hand panel)</p>"
msgstr "<p>Нажатие 'Enter' в ячейке изменяет как книгу, так и \nпроверяемый столбец (левая панель)</p>"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/quickview_ui.py:67
msgid "&Pressing Enter changes the examined column"
msgstr "&Нажатие 'Enter' изменяет проверяемый столбец"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/quickview_ui.py:68
msgid ""
"<p>Double-clicking in a cell changes both the book and the\n"
"column being examined (the left-hand panel)</p>"
msgstr "<p>Двойной щелчок на ячейке изменяет как книгу, так и \nтак и проверяемый столбец (левая панель)</p>"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/quickview_ui.py:70
msgid "&Double click changes examined column"
msgstr "Д&войной щелчок изменяет проверяемый столбец"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/quickview_ui.py:71
msgid "Select columns to display"
msgstr "Выберите столбцы для отображения"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/tb_display_ui.py:122
msgid "User categories and Saved searches cannot be moved"
msgstr "Пользовательские категории и сохранённые поиски нельзя переместить"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/tb_display_ui.py:123
msgid "Select the categories to display in the Tag browser, and their &order"
msgstr "Выберите видимые в браузере тегов категории и их &порядок"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/tb_display_ui.py:124
msgid ""
"<p>Click to move the row up 1. Shift+click to move the row up 5.\n"
"Ctrl+click to move the row up 10. Ctrl+Shift+click to move the row to the top.\n"
"User categories and Saved searches cannot be moved.\n"
"Keyboard shortcut: Ctrl+Up arrow</p>"
msgstr "<p>Щелчок, чтобы переместить строку вверх 1. Shift + щелчок, чтобы переместить строку вверх 5.\nCtrl + щелчок, чтобы переместить строку вверх 10. Ctrl + Shift + щелчок, чтобы переместить строку на верх.\nПользовательские категории и сохранённые поиски нельзя перемещать.\nКлавиатурное сокращение: Ctrl+Стрелка Вверх ↑</p>"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/tb_display_ui.py:128
msgid ""
"<p>Click to move the row down 1. Shift+click to move the row down 5.\n"
"Ctrl+click to move the row down 10. Ctrl+Shift+click to move the row to the bottom.\n"
"User categories and Saved searches cannot be moved.\n"
"Keyboard shortcut: Ctrl+Down arrow</p>"
msgstr "<p>Щелчок, чтобы переместить строку вниз 1. Shift + щелчок, чтобы переместить строку вниз 5.\nCtrl + щелчок, чтобы переместить строку вниз 10. Ctrl + Shift + щелчок, чтобы переместить строку в низ.\nПользовательские категории и сохранённые поиски нельзя перемещать.\nКлавиатурное сокращение: Ctrl+Стрелка Вниз ↓</p>"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/tb_display_ui.py:146
msgid "Show &average ratings"
msgstr "Показывать &средние оценки"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/tb_display_ui.py:147
msgid "Show an icon if the item has an attached link"
msgstr "Показывать значок, если к элементу прикреплена ссылка"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/tb_display_ui.py:148
msgid "Show &links icons"
msgstr "Показать значки &ссылок"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/tb_display_ui.py:149
msgid "Show &tooltips"
msgstr "Показывать по&дсказки"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/tb_display_ui.py:150
msgid ""
"<p>Show counts for items in the Tag browser. Such as the number of books\n"
"by each author, the number of authors, etc. If you turn it off, you can still\n"
"see the counts by hovering your mouse over any item.</p>"
msgstr "<p>Показ количества элементов в браузере тегов. Напр., количество книг\n каждого автора, количество авторов и т. д. Если вы отключите его, вы сможете\nпо-прежнему видеть подсчёты, наведя курсор мыши на любой элемент.</p>"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/tb_display_ui.py:153
msgid "Show &counts"
msgstr "Показывать &количество"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/tb_display_ui.py:154
msgid "Show an icon if the item has an attached note"
msgstr "Показывать значок, если к элементу прикреплена заметка"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/tb_display_ui.py:155
msgid "Show &notes icons"
msgstr "Показать значки &примечаний"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/tb_display_ui.py:156
msgid "Use &alternating row colors"
msgstr "Использовать переменные &цвета строк"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/tb_display_ui.py:157
msgid ""
"<p>When checked, calibre will automatically hide any category\n"
"(a column, custom or standard) that has no items to show. For example, some\n"
"categories might not have values when using Virtual libraries. Checking this\n"
"box will cause these empty categories to be hidden.</p>"
msgstr "<p>Когда отмечено, calibre автоматически скроет любую категорию\n(столбец, пользовательский или стандартный), в котором нет элементов для отображения. Напр., некоторые\nкатегории могут не иметь значений при использовании виртуальных библиотек. Отметка скроет пустые категории.</p>"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/tb_display_ui.py:161
msgid "Hide empt&y categories (columns)"
msgstr "Скрыть п&устые категории (столбцы)"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/tb_display_ui.py:162
msgid ""
"If checked the notes and links icons will be placed at the right, after\n"
"the count and in columns. If unchecked, the icons will be placed immediately after the text,\n"
"to the left of the count and not in columns."
msgstr "Если этот флажок установлен, значки заметок и ссылок будут располагаться справа после\nколичества и в столбцах. Если флажок не установлен, значки будут располагаться сразу после текста,\nслева от количества и не в столбцах."

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/tb_display_ui.py:165
msgid "Place icons on the &right, in columns"
msgstr "Размещать значки &справа, в столбцах"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/tb_display_ui.py:166
msgid ""
"<p>When checked, Find in the Tag browser will show all items\n"
"that match the search instead of the first one. If Hide empty categories is\n"
"also checked then only categories containing a matched item will be shown.</p>"
msgstr "<p>Если этот флажок установлен, в браузере тегов в поле «Поиск» будут показаны все элементы.\nкоторые соответствуют поиску вместо первого. Если Скрыть пустые категории\nтакже отмечен, тогда будут показаны только категории, содержащие соответствующий элемент.</p>"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/tb_display_ui.py:169
msgid "Find &shows all items that match"
msgstr "Найти и показать все соответствующие &элементы "

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/tb_display_ui.py:170
msgid ""
"<p>Ensure the last \"used\" item in the Tag browser is visible when opening a library.\n"
"An item is \"used\" when it is expanded, collapsed, or clicked.</p>"
msgstr "<p>Убедитесь, что последний «использованный» элемент в браузере тегов виден при открытии библиотеки.\nЭлемент «используется», когда его разворачивают, сворачивают или щёлкают.</p>"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/tb_display_ui.py:172
msgid "Expand tr&ee to show last used item"
msgstr "Развернуть &дерево, чтобы отобразить последний использованный элемент"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/tb_display_ui.py:173
msgid ""
"<p>When checked, the Tag browser can get keyboard focus, allowing\n"
"use of the keyboard to navigate the tree using the arrow keys. The Enter key simulates\n"
"a click on the selected item. The keyboard shortcut 'Tag browser /\n"
"Give the Tag browser keyboard focus' changes the keyboard focus without\n"
"using the mouse.</p>"
msgstr "<p>Если этот флажок установлен, Браузер тегов может получать фокус клавиатуры, и использовать\n клавиатуру для навигации клавишами со стрелками. Клавиша Enter имитирует\nщелчок по выбранному элементу. Сочетание клавиш 'Браузер тегов /\nДать Браузеру тегов фокус клавиатуры' изменяет фокус клавиатуры без\nиспользования мыши.</p>"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/tb_display_ui.py:178
msgid "Allow the Tag browser to have keyboard &focus"
msgstr "Разрешить Браузеру тегов иметь клавиатуру и &фокус"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/tb_display_ui.py:179
msgid ""
"<p style=\"text-indent: 2em; font-size:smaller\">\n"
"If you enable this option then you should set a keyboard shortcut to\n"
"focus the Tag browser under\n"
"<code>Preferences-&gt;Shortcuts-&gt;Tag browser-&gt;Give\n"
"the Tag browser keyboard focus</code></p>"
msgstr "<p style=\"text-indent: 2em; font-size:smaller\">Если вы включите эту опцию, вы должны установить сочетание клавиш для фокусировки браузера тегов в разделе<code> «Настройки» - «Комбинации клавиш» - «Браузер тегов» - «Отдать  фокус клавиатуры Браузеру тегов»</code></p>"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/tb_display_ui.py:184
msgid "Spacing between &items:"
msgstr "Интервал между &элементами:"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/tb_display_ui.py:185
msgid ""
"<p>The spacing between consecutive items in the Tag browser.\n"
"In units of (ex) which is the approximate height of the letter 'x' in the\n"
"currently used font.</p>"
msgstr "<p>Интервал между соседними элементами в браузере тегов.\nВ единицах (ex), которые приблизительно равны высоте буквы «x» в текущем шрифте.</p>"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/tb_display_ui.py:188
msgid "ex"
msgstr "ex"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/tb_hierarchy.py:85
msgid "Search for books containing the current item"
msgstr "Поиск книг, содержащих текущий элемент"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/tb_hierarchy.py:86
msgid "Search for books containing the current item or its children"
msgstr "Поиск книг, содержащих текущий элемент или его дочерние элементы"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/tb_hierarchy.py:87
msgid "Search for books not containing the current item"
msgstr "Поиск книг, не содержащих текущий элемент"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/tb_hierarchy.py:88
msgid "Search for books not containing the current item or its children"
msgstr "Поиск книг, не содержащих текущий элемент или его дочерние элементы"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/tb_hierarchy_ui.py:80
msgid ""
"<p>Check the box for an item if it is to be displayed as a\n"
"hierarchical tree in the Tag browser. For example, if you check\n"
"'tags' then tags of the form 'Mystery.English'\n"
"and 'Mystery.Thriller' will be displayed with English and Thriller\n"
"both under 'Mystery'. If 'tags' is not checked\n"
"then the tags will be displayed each on their own line.</p>\n"
"<p>The categories 'authors', 'publisher', 'news', 'formats', and 'rating'\n"
"cannot be hierarchical.</p>\n"
"<p>User categories are always hierarchical and so do not appear in this list.</p>"
msgstr "<p>Отметьте элемент для его отображения\n как иерархического дерева в браузере тегов. Если  отметить\n'Теги', то теги вида 'Детектив.Англия'\nи 'Детектив.Триллер' - будут отображаться как 'Англия' и 'Триллер'\nпод заголовком 'Детектив'. В противном случае\nтеги будут отображаться каждый на своей строке.</p>\n<p>Категории Авторы, Издатель, Новости, Форматы и Оценки\nне могут быть иерархическими.</p>\n<p>Пользовательские категории всегда иерархические \nи не показываются в этом списке.</p>"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/tb_hierarchy_ui.py:89
msgid "Select categories with &hierarchical items:"
msgstr "Выберите категории с &иерархической структурой:"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/tb_hierarchy_ui.py:92
#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/tb_partitioning_ui.py:97
msgid ""
"<p>Click this button to set the list to one\n"
"previously exported. This could be useful if you have several libraries with\n"
"similar structure and you want to use the same for each one.</p>"
msgstr "<p>Нажмите эту кнопку, чтобы заменить список ранее экспортированным. Полезно для нескольких библиотек с похожей структурой</p>"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/tb_hierarchy_ui.py:96
#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/tb_partitioning_ui.py:101
msgid ""
"<p>Click this button to write the current display\n"
"settings to a file. This could be useful if you have several libraries with similar\n"
"structure and you want to use the same for each one.</p>"
msgstr "<p>Нажмите эту кнопку, чтобы записать текущие настройки\nотображения в файл. Полезно для нескольких библиотек с похожей структурой.</p>"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/tb_hierarchy_ui.py:100
msgid ""
"<p>Set the order of the searches when clicking on an item in\n"
"the Tag browser. The 'or its children' options are ignored when clicking on\n"
"top-level categories, items that aren't in a hierarchical category, and items\n"
"that don't have children.</p>"
msgstr "<p>Установить порядок поиска при нажатии на элемент в\nБраузере тегов. Параметры 'or its children' игнорируются при нажатии на\nкатегории верхнего уровня, элементы, не входящие в иерархическую категорию, и элементы\nу которых нет потомков.</p>"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/tb_hierarchy_ui.py:104
msgid "Set the &order of searches when clicking on items"
msgstr "Установить &порядок поиска при нажатии на элементы"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/tb_hierarchy_ui.py:105
msgid "Move up. Keyboard shortcut: Ctrl+Up arrow"
msgstr "Вверх. Сочетание клавиш: Ctrl+Стрелка Вверх ↑"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/tb_hierarchy_ui.py:106
msgid "Move down. Keyboard shortcut: Ctrl+Down arrow"
msgstr "Вниз. Сочетание клавиш: Ctrl-стрелка вниз ↓"

