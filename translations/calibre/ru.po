#: /__w/calibre/calibre/src/calibre/db/cli/cmd_add.py:342
#, python-format
msgid "Added book ids: %s"
msgstr "Добавлены идентификаторы книг: %s"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_add.py:329
msgid ""
"The following books were not added as they already exist in the database "
"(see --duplicates option or --automerge option):"
msgstr "Следующие книги не были добавлены, т.к. они уже есть в базе данных (см. опцию --duplicates или опцию --automerge):"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_add.py:344
#, python-format
msgid "Merged book ids: %s"
msgstr "Идентификаторы объединённых книг: %s"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_add.py:350
msgid ""
"%prog add [options] file1 file2 file3 ...\n"
"\n"
"Add the specified files as books to the database. You can also specify folders, see\n"
"the folder related options below.\n"
msgstr "%prog добавить [параметры] файл1 файл2 файл3 ...\n\nДобавить указанные файлы как книги в базу данных. Вы также можете указать папки, см.\nпараметры, относящиеся к папке, ниже.\n"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_add.py:364
#, python-brace-format
msgid ""
"Add books to database even if they already exist. Comparison is done based "
"on book titles and authors. Note that the {} option takes precedence."
msgstr "Добавлять книги в базу данных, даже если они уже есть. Сравнение - по названиям книг и авторам. Параметр {} имеет приоритет."

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_add.py:374
msgid ""
"If books with similar titles and authors are found, merge the incoming "
"formats (files) automatically into existing book records. A value of "
"\"ignore\" means duplicate formats are discarded. A value of \"overwrite\" "
"means duplicate formats in the library are overwritten with the newly added "
"files. A value of \"new_record\" means duplicate formats are placed into a "
"new book record."
msgstr "Если будут найдены книги с похожими названиями и авторами, автоматически объединить входящие форматы (файлы) с существующими книжными записями. Значение «ignore» — повторяющиеся форматы отбрасываются. Значение «overwrite» — повторяющиеся форматы в библиотеке перезаписываются вновь добавленными файлами. Значение «new_record» — повторяющиеся форматы помещаются в новую запись книги."

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_add.py:380
msgid "Add an empty book (a book with no formats)"
msgstr "Добавить пустую книгу (книгу без форматов)"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_add.py:381
msgid "Set the title of the added book(s)"
msgstr "Установить название добавляемой книги (книг)"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_add.py:382
msgid "Set the authors of the added book(s)"
msgstr "Указать авторов добавляемых книг"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_add.py:383
msgid "Set the ISBN of the added book(s)"
msgstr "Указать ISBN добавляемых книг"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_add.py:389
msgid "Set the identifiers for this book, e.g. -I asin:XXX -I isbn:YYY"
msgstr "Задать идентификаторы книги, напр. -I asin:XXX -I isbn:YYY"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_add.py:391
msgid "Set the tags of the added book(s)"
msgstr "Указать теги добавляемых книг"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_add.py:392
msgid "Set the series of the added book(s)"
msgstr "Указать серию добавляемых книг"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_add.py:393
msgid "Set the series number of the added book(s)"
msgstr "Указать номер в серии у добавляемых книг"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_add.py:394
msgid "Path to the cover to use for the added book"
msgstr "Путь к обложке для использования в добавленной книге"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_add.py:399
msgid ""
"A comma separated list of languages (best to use ISO639 language codes, "
"though some language names may also be recognized)"
msgstr "Список языков через запятую (желательно использовать языкововую кодировку ISO639, хотя могут быть распознаны и некоторые обычные названия языков)"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_add.py:404
msgid "ADDING FROM FOLDERS"
msgstr "ДОБАВЛЕНИЕ ИЗ ПАПОК"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_add.py:405
msgid ""
"Options to control the adding of books from folders. By default only files "
"that have extensions of known e-book file types are added."
msgstr "Параметры для управления добавлением книг из папок. По умолчанию добавляются только файлы с расширениями известных форматов электронных книг."

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_add.py:420
msgid ""
"Assume that each folder has only a single logical book and that all files in"
" it are different e-book formats of that book"
msgstr "Предположим, что в каждой папке есть только одна логическая книга и что все файлы в ней представляют собой электронные книги разных форматов этой книги."

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_add.py:422
msgid "Process folders recursively"
msgstr "Рекурсивно обрабатывать папки"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_add.py:434
msgid "GLOB PATTERN"
msgstr "ШАБЛОН ИМЕНИ ФАЙЛА"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_add.py:442
msgid ""
"A filename (glob) pattern, files matching this pattern will be ignored when "
"scanning folders for files. Can be specified multiple times for multiple "
"patterns. For example: *.pdf will ignore all PDF files"
msgstr "Шаблон имени файла (glob), файлы, соответствующие этому шаблону, будут игнорироваться при сканировании папок на наличие файлов. Можно указать несколько раз для нескольких шаблонов. Напр.: *.pdf игнорирует все файлы PDF."

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_add.py:450
msgid ""
"A filename (glob) pattern, files matching this pattern will be added when "
"scanning folders for files, even if they are not of a known e-book file "
"type. Can be specified multiple times for multiple patterns."
msgstr "Шаблон имени файла (glob), файлы, соответствующие этому шаблону, будут добавлены при сканировании папок на наличие файлов, даже если они не относятся к известному типу файлов электронных книг. Можно указать несколько раз для нескольких шаблонов."

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_add.py:470
msgid "You must specify at least one file to add"
msgstr "Вы должны указать не менее одного файла для добавления"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_add_custom_column.py:34
#, python-brace-format
msgid ""
"%prog add_custom_column [options] label name datatype\n"
"\n"
"Create a custom column. label is the machine friendly name of the column. Should\n"
"not contain spaces or colons. name is the human friendly name of the column.\n"
"datatype is one of: {0}\n"
msgstr "%prog add_custom_column [опции] ярлык имя тип_данных\n\nСоздаёт пользовательский столбец, где «ярлык» — удобное для компьютера название\nстолбца, без пробелов и двоеточий; «имя» — удобное для человека название столбца;\n«тип_данных» один из: {0}\n"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_add_custom_column.py:48
msgid ""
"This column stores tag like data (i.e. multiple comma separated values). "
"Only applies if datatype is text."
msgstr "Этот столбец хранит теги как данные (напр., несколько значений, разделенных запятыми). Применяется только, если тип данных текст."

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_add_custom_column.py:54
msgid ""
"A dictionary of options to customize how the data in this column will be interpreted. This is a JSON  string. For enumeration columns, use --display=\"{\\\"enum_values\\\":[\\\"val1\\\", \\\"val2\\\"]}\"\n"
"There are many options that can go into the display variable.The options by column type are:\n"
"composite: composite_template, composite_sort, make_category,contains_html, use_decorations\n"
"datetime: date_format\n"
"enumeration: enum_values, enum_colors, use_decorations\n"
"int, float: number_format\n"
"text: is_names, use_decorations\n"
"\n"
"The best way to find legal combinations is to create a custom column of the appropriate type in the GUI then look at the backup OPF for a book (ensure that a new OPF has been created since the column was added). You will see the JSON for the \"display\" for the new column in the OPF."
msgstr "Словарь настроек для указания того, как данные в столбцах будут интерпретированы. Это JSON строка. Для перечисления столбцов используйте --display=\"{\\\"enum_values\\\":[\\\"val1\\\", \\\"val2\\\"]}\"\nЕсть много настроек, которые можно использовать в переменной отображения. Эти настройки по типу столбца бывают:\nсоставными: composite_template, composite_sort, make_category,contains_html, use_decorations\nдаты и времени: date_format\nперечисление: enum_values, enum_colors, use_decorations\nцелочисленные или с плавающей точкой: number_format\nтекстовые: is_names, use_decorations\n\nДля поиска правильных сочетаний лучше всего создать пользовательский столбец соответствующего типа в GUI и посмотреть резервный OPF книги (убедитесь что новый OPF был создан после добавления столбца). Вы увидите JSON для \"отображения\" для нового столбца в OPF."

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_add_custom_column.py:85
msgid "You must specify label, name and datatype"
msgstr "Вы должны указать заголовок, имя и тип данных"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_add_format.py:35
msgid ""
"%prog add_format [options] id ebook_file\n"
"\n"
"Add the e-book in ebook_file to the available formats for the logical book identified by id. You can get id by using the search command. If the format already exists, it is replaced, unless the do not replace option is specified."
msgstr "%prog add_format [опции] id файл_электронной_книги\n\nДобавьте файл_электронной_книги в доступные форматы логической книги, определённой по id. Идентификатор можно получить с помощью команды search (искать). Если формат уже существует, он заменяется, если не указана опция --dont-replace (не заменять)."

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_add_format.py:49
msgid "Do not replace the format if it already exists"
msgstr "Не заменять формат, если он уже существует"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_add_format.py:55
msgid "Add the file as an extra data file to the book, not an ebook format"
msgstr "Добавьте файл как дополнительный файл данных в книгу, а не как электронную книгу."

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_add_format.py:63
msgid "You must specify an id and an e-book file"
msgstr "Вы должны указать идентификатор и файл электронной книги"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_add_format.py:71
msgid "e-book file must have an extension"
msgstr "Файл электронной книги должен иметь расширение"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_add_format.py:75
#, python-format
msgid "A %(fmt)s file already exists for book: %(id)d, not replacing"
msgstr "Файл %(fmt)s уже существует для книги: %(id)d, не заменяется"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_backup_metadata.py:19
msgid ""
"%prog backup_metadata [options]\n"
"\n"
"Backup the metadata stored in the database into individual OPF files in each\n"
"books folder. This normally happens automatically, but you can run this\n"
"command to force re-generation of the OPF files, with the --all option.\n"
"\n"
"Note that there is normally no need to do this, as the OPF files are backed up\n"
"automatically, every time metadata is changed.\n"
msgstr "%prog backup_metadata [параметры]\n\nРезервное копирование метаданных, хранящихся в базе данных, в отдельные файлы OPF в каждой\nпапке с книгами. Обычно это происходит автоматически, но вы можете запустить эту\nкоманду для принудительного повторного создания файлов OPF с параметром --all.\n\nОбратите внимание, что обычно в этом нет необходимости, так как файлы OPF сохраняются.\nавтоматически, каждый раз при изменении метаданных.\n"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_backup_metadata.py:35
msgid ""
"Normally, this command only operates on books that have out of date OPF "
"files. This option makes it operate on all books."
msgstr "Обычно команда работает только с книгами, имеющими устаревшие OPF файлы. Эта опция заставляет её работать со всеми книгами."

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_catalog.py:26
#, python-brace-format
msgid "{} OPTIONS"
msgstr "ОПЦИИ {}"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_catalog.py:35
#, python-brace-format
msgid ""
"%prog catalog /path/to/destination.(csv|epub|mobi|xml...) [options]\n"
"\n"
"Export a catalog in format specified by path/to/destination extension.\n"
"Options control how entries are displayed in the generated catalog output.\n"
"Note that different catalog formats support different sets of options. To\n"
"see the different options, specify the name of the output file and then the\n"
"{} option.\n"
msgstr "%pкаталог rog /path/to/destination.(csv|epub|mobi|xml ...) [параметры]\n\nЭкспортировать каталог в формате, указанном расширением путь/к/назначению.\nПараметры управляют тем, как записи отображаются в сгенерированном выводе каталога.\nОбратите внимание, что разные форматы каталогов поддерживают разные наборы параметров. Чтобы\nпросмотреть различные параметры, укажите имя выходного файла, а затем\n{} опцию.\n"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_catalog.py:52
msgid ""
"Comma-separated list of database IDs to catalog.\n"
"If declared, --search is ignored.\n"
"Default: all"
msgstr "Разделённый запятыми список идентификаторов из базы данных для каталога.\nЕсли указано, --search игнорируется.\nПо умолчанию: all"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_catalog.py:60
msgid ""
"Filter the results by the search query. For the format of the search query, please see the search-related documentation in the User Manual.\n"
"Default: no filtering"
msgstr "Фильтровать результаты по поисковому запросу. О формате поискового запроса читайте в связанной с поиском документации в руководстве пользователя.\nПо умолчанию: no filtering (не фильтровать)"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_catalog.py:72
#: /__w/calibre/calibre/src/calibre/web/fetch/simple.py:690
msgid "Show detailed output information. Useful for debugging"
msgstr "Показать детальную информацию. Используется для отладки."

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_catalog.py:93
msgid "You must specify a catalog output file"
msgstr "Вы должны указать каталог файла вывода"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_catalog.py:98
#, python-brace-format
msgid "Cannot generate a catalog in the {} format"
msgstr "Невозможно сгенерировать каталог в формате {}"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_check_library.py:25
#, python-brace-format
msgid ""
"%prog check_library [options]\n"
"\n"
"Perform some checks on the filesystem representing a library. Reports are {0}\n"
msgstr "%prog check_library [настройки]\n\nВыполняет некоторые проверки файловой системы представляющей библиотеку. Отчёты {0}\n"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_check_library.py:33
#: /__w/calibre/calibre/src/calibre/db/cli/cmd_list_categories.py:41
msgid "Output in CSV"
msgstr "Вывод в CSV"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_check_library.py:35
msgid ""
"Comma-separated list of reports.\n"
"Default: all"
msgstr "Разделённый запятыми список отчётов.\nПо умолчанию: все (all)."

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_check_library.py:42
msgid ""
"Comma-separated list of extensions to ignore.\n"
"Default: all"
msgstr "Разделённый запятыми список игнорируемых расширений.\nПо умолчанию: все (all)."

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_check_library.py:50
msgid ""
"Comma-separated list of names to ignore.\n"
"Default: all"
msgstr "Разделённый запятыми список игнорируемых названий.\nПо умолчанию: все (all)."

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_check_library.py:56
msgid ""
"Vacuum the full text search database. This can be very slow and memory "
"intensive, depending on the size of the database."
msgstr "Сжать (командой Vacuum) базу данных полнотекстового поиска. Если база данных велика, это может занять много времени и памяти."

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_check_library.py:94
msgid "Unknown report check"
msgstr "Неизвестная отметка отчёта"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_check_library.py:111
msgid "Vacuuming database..."
msgstr "Сжатие базы данных..."

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_clone.py:22
msgid ""
"%prog clone path/to/new/library\n"
"\n"
"Create a clone of the current library. This creates a new, empty library that has all the\n"
"same custom columns, Virtual libraries and other settings as the current library.\n"
"\n"
"The cloned library will contain no books. If you want to create a full duplicate, including\n"
"all books, then simply use your filesystem tools to copy the library folder.\n"
"    "
msgstr "%prog clone path/to/new/library\n\nСоздать клон текущей библиотеки. Создаётся новая пустая библиотека,  содержащая все\nпользовательские столбцы, виртуальные библиотеки и прочие параметры, аналогично текущей библиотеке.\n\nКлонированная библиотека не содержит книг. Чтобы создать полную копию\nсо всеми книгами просто скопируйте папку библиотеки."

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_clone.py:37
msgid "Error: You must specify the path to the cloned library"
msgstr "Ошибка: Вы должны указать путь к клонируемой библиотеке"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_clone.py:44
msgid "The location for the new library is the same as the current library"
msgstr "Путь к новой библиотеке совпадает с положением текущей библиотеки"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_clone.py:47
#, python-format
msgid "%s is not empty. You must choose an empty folder for the new library."
msgstr "%s не пусто. Вы должны выбрать пустую папку для новой библиотеки."

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_custom_columns.py:20
msgid ""
"%prog custom_columns [options]\n"
"\n"
"List available custom columns. Shows column labels and ids.\n"
"    "
msgstr "%prog custom_columns [options]\n\nСписок доступных пользовательских столбцов. Показ меток столбцов и идентификаторы.\n    "

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_custom_columns.py:27
msgid "Show details for each column."
msgstr "Показать подробности для каждой колонки."

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_embed_metadata.py:27
msgid ""
"\n"
"%prog embed_metadata [options] book_id\n"
"\n"
"Update the metadata in the actual book files stored in the calibre library from\n"
"the metadata in the calibre database.  Normally, metadata is updated only when\n"
"exporting files from calibre, this command is useful if you want the files to\n"
"be updated in place. Note that different file formats support different amounts\n"
"of metadata. You can use the special value 'all' for book_id to update metadata\n"
"in all books. You can also specify many book ids separated by spaces and id ranges\n"
"separated by hyphens. For example: %prog embed_metadata 1 2 10-15 23"
msgstr "\n%prog embed_metadata [параметры] book_id\n\nОбновление метаданных в файлах текущей книги, хранящейся в библиотеке calibre, из \nметаданных в базе данных calibre.  Обычно метаданные обновляются только во время\nэкспорта файлов из calibre, эта команда полезна, если вы хотите, чтобы файлы были\nобновлены на месте. Заметьте, что различные форматы файлов поддерживают разное количество\nметаданных. Вы можете использовать специальное значение 'all' для book_id, чтобы обновить метаданные\nво всех книгах. Вы можете также задать несколько идентификаторов книг, разделённых пробелами, и диапазон идентификаторов,\nразделённых дефисами. Напр.: %prog embed_metadata 1 2 10-15 23"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_embed_metadata.py:44
msgid ""
"Only update metadata in files of the specified format. Specify it multiple "
"times for multiple formats. By default, all formats are updated."
msgstr "Обновлять только метаданные в файлах заданного формата. Задайте несколько раз для нескольких форматов. По умолчанию, обновляются все форматы."

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_embed_metadata.py:61
#, python-brace-format
msgid "Processed {0} ({1} of {2})"
msgstr "Обработано {0} ({1} из {2})"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_embed_metadata.py:65
#, python-brace-format
msgid "No book with id: {}"
msgstr "Нет книги с идентификатором: {}"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_export.py:52
msgid ""
"%prog export [options] ids\n"
"\n"
"Export the books specified by ids (a comma separated list) to the filesystem.\n"
"The export operation saves all formats of the book, its cover and metadata (in\n"
"an OPF file). Any extra data files associated with the book are also saved.\n"
"You can get id numbers from the search command.\n"
msgstr "%prog export [options] ids\n\nЭкспортировать книги, указанные идентификаторами (список, разделённый запятыми), в файловую систему.\nОперация экспорта сохраняет все форматы книги, её обложку и метаданные (в\nOPF-файл). Любые дополнительные файлы данных, связанные с книгой, также сохраняются.\nВы можете получить номера идентификаторов с помощью команды поиска (search).\n"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_export.py:62
msgid "Export all books in database, ignoring the list of ids."
msgstr "Экспортировать все книги в базу данных, игнорируя список id."

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_export.py:63
msgid "Export books to the specified folder. Default is"
msgstr "Экспорт книг в указанную папку. По умолчанию"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_export.py:64
msgid "Export all books into a single folder"
msgstr "Экспорт всех книг в одну папку"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_export.py:65
msgid "Report progress"
msgstr "Прогресс отчёта"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_export.py:74
msgid "Specifying this switch will turn this behavior off."
msgstr "Указание этого переключателя отключит данный режим."

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_export.py:127
#, python-format
msgid "You must specify some ids or the %s option"
msgstr "Вы должны указать id или опцию %s"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_fts_index.py:33
#: /__w/calibre/calibre/src/calibre/db/cli/cmd_fts_index.py:46
msgid "Full text indexing is not enabled on this library"
msgstr "В этой библиотеке не включено полнотекстовое индексирование."

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_fts_index.py:59
#, python-brace-format
msgid ""
"%prog fts_index [options] {enable}/{disable}/{status}/{reindex}\n"
"\n"
"Control the Full text search indexing process.\n"
"\n"
"{enable}\n"
"    Turns on FTS indexing for this library\n"
"{disable}\n"
"    Turns off FTS indexing for this library\n"
"{status}\n"
"    Shows the current indexing status\n"
"{reindex}\n"
"    Can be used to re-index either particular books or\n"
"    the entire library. To re-index particular books\n"
"    specify the book ids as additional arguments after the\n"
"    {reindex} command. If no book ids are specified the\n"
"    entire library is re-indexed.\n"
msgstr "%prog fts_index [параметры] {enable}/{disable}/{status}/{reindex}\n\nУправление индексом для полнотекстового поиска.\n\n{enable}\n    Включить индексирование для данной библиотеки\n{disable}\n    Включить индексирование для данной библиотеки\n{status}\n    Показать состояние индексирования\n{reindex}\n    Переиндексировать отдельные книги или\n    библиотеку целиком. Для отдельных книг, укажите\n    их идентификаторы после команды {reindex}.\n    Если идентификаторы не указаны, то переиндексируется\n    вся библиотека.\n"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_fts_index.py:83
msgid ""
"Wait till all books are indexed, showing indexing progress periodically"
msgstr "Ждать, пока все книги будут проиндексированы, периодически показывая ход индексации."

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_fts_index.py:90
msgid ""
"The speed of indexing. Use fast for fast indexing using all your computers "
"resources and slow for less resource intensive indexing. Note that the speed"
" is reset to slow after every invocation."
msgstr "Скорость индексации. Быстрое индексирование использует максимум ресурсов компьютера, медленное - менее ресурсоёмко. Скорость сбрасывается на медленную после каждого вызова."

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_fts_index.py:112
#, python-brace-format
msgid "{0} of {1} book files indexed, {2}"
msgstr "{0} из {1} проиндексированных файлов книг, {2}"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_fts_index.py:155
msgid "Error: You must specify the indexing action"
msgstr "Ошибка: Нужно указать действие с индексом"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_fts_index.py:161
msgid "FTS Indexing is enabled"
msgstr "Полнотекстовый поиск включён"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_fts_index.py:162
#: /__w/calibre/calibre/src/calibre/db/cli/cmd_fts_index.py:170
#: /__w/calibre/calibre/src/calibre/db/cli/cmd_fts_index.py:197
#, python-brace-format
msgid "{0} of {1} books files indexed"
msgstr "Проиндексировано файлов книг: {0} из {1}"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_fts_index.py:164
msgid "FTS Indexing is disabled"
msgstr "Полнотекстовый поиск отключен"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_fts_index.py:169
msgid "FTS indexing has been enabled"
msgstr "Полнотекстовый индекс включён"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_fts_index.py:175
msgid "Re-indexing the entire library can take a long time. Are you sure?"
msgstr "Повторное индексирование всей библиотеки может занять много времени. Продолжить?"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_fts_index.py:178
#: /__w/calibre/calibre/src/calibre/db/cli/cmd_fts_index.py:203
#, python-brace-format
msgid "Type {} to proceed, anything else to abort"
msgstr "Введите {} чтобы продолжить, или что-нибудь еще для отмены"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_fts_index.py:200
#: /__w/calibre/calibre/src/calibre/gui2/fts/scan.py:155
msgid ""
"Disabling indexing will mean that all books will have to be re-checked when "
"re-enabling indexing. Are you sure?"
msgstr "Отключение индексации будет означать, что все книги нужно будет перепроверить при повторном включении индексации. Вы уверены?"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_fts_index.py:212
msgid "FTS indexing has been disabled"
msgstr "Индексация FTS отключена"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_fts_index.py:219
msgid "Waiting for FTS indexing to complete, press Ctrl-C to abort..."
msgstr "Ожидание завершения индексирования, нажмите Ctrl-C для отмены..."

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_fts_index.py:228
msgid "All books indexed!"
msgstr "Все книги проиндексированы!"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_fts_search.py:19
msgid ""
"Full text searching is not enabled on this library. Use the calibredb "
"fts_index enable --wait-until-complete command to enable it"
msgstr "Полнотекстовый поиск не включен для данной библиотеки. Чтобы его включить, используйте команду calibredb fts_index enable --wait-until-complete"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_fts_search.py:23
#, python-brace-format
msgid "{0} files out of {1} are not yet indexed, searching is disabled"
msgstr "{0} из {1} файлов еще не проиндексированы, поиск недоступен"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_fts_search.py:64
msgid ""
"%prog fts_search [options] search expression\n"
"\n"
"Do a full text search on the entire library or a subset of it.\n"
"\n"
msgstr "%prog fts_search [параметры] выражение поиска\n\nПолнотекстовый поиск в библиотеке или ее фрагменте.\n\n"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_fts_search.py:76
msgid ""
"Include snippets of the text surrounding each match. Note that this makes "
"searching much slower."
msgstr "Выводить фрагменты текста вокруг совпадений. Это существенно замедлит поиск."

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_fts_search.py:81
msgid ""
"The marker used to indicate the start of a matched word inside a snippet"
msgstr "Маркер начала совпавшего слова во фрагменте"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_fts_search.py:86
msgid "The marker used to indicate the end of a matched word inside a snippet"
msgstr "Маркер конца совпавшего слова во фрагменте"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_fts_search.py:93
msgid ""
"Only match on exact words not related words. So correction will not match "
"correcting."
msgstr "Точное совпадение вместо родственных слов, напр. correction не совпадает с correcting."

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_fts_search.py:99
msgid ""
"Restrict the searched books, either using a search expression or ids. For "
"example: ids:1,2,3 to restrict by ids or search:tag:foo to restrict to books"
" having the tag foo."
msgstr "Ограничьте искомые книги, используя поисковое выражение или идентификаторы. Напр.: ids:1,2,3 для ограничения по идентификаторам или search:tag:foo для ограничения книг с тегом foo."

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_fts_search.py:107
msgid ""
"The format to output the search results in. Either \"text\" for plain text "
"or \"json\" for JSON output."
msgstr "Формат вывода результатов: «text» для обычного текста или «json»."

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_fts_search.py:114
msgid ""
"How much of the library must be indexed before searching is allowed, as a "
"percentage. Defaults to 90"
msgstr "Сколько процентов библиотеки должно быть проиндексировано для включения полнотекстового поиска. По умолчанию 90"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_fts_search.py:131
#: /__w/calibre/calibre/src/calibre/db/cli/cmd_fts_search.py:143
#: /__w/calibre/calibre/src/calibre/gui2/actions/copy_to_library.py:316
#, python-brace-format
msgid "{0} by {1}"
msgstr "{1} — {0}"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_fts_search.py:164
#: /__w/calibre/calibre/src/calibre/db/cli/cmd_search.py:50
msgid "Error: You must specify the search expression"
msgstr "Ошибка: Вы должны указать поисковое выражение"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_list.py:95
msgid "No template specified"
msgstr "Шаблон не задан"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_list.py:95
msgid "Template not allowed"
msgstr "Шаблон не разрешен"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_list.py:183
msgid ""
"The use of templates is disallowed when connecting to remote servers for "
"security reasons"
msgstr "Использование шаблонов запрещено при подключении к удаленным серверам"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_list.py:189
msgid "You must provide a template"
msgstr "Вы должны предоставить шаблон"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_list.py:277
msgid ""
"%prog list [options]\n"
"\n"
"List the books available in the calibre database.\n"
msgstr "%prog список [options]\n\nСписок книг в базе данных calibre.\n"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_list.py:289
#, python-format
msgid ""
"The fields to display when listing books in the database. Should be a comma separated list of fields.\n"
"Available fields: %s\n"
"Default: %%default. The special field \"all\" can be used to select all fields. In addition to the builtin fields above, custom fields are also available as *field_name, for example, for a custom field #rating, use the name: *rating"
msgstr "Поля, отображаемые при перечислении книг в базе данных. Должен быть разделённый запятыми список полей.\nДоступные поля: %s\nПо умолчанию: %%default. Специальное поле \"all\" можно использовать для выбора всех полей. В дополнение к встроенным полям, пользовательские поля также доступны как *field_name, напр., для настраиваемого поля #rating, используйте имя: *rating"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_list.py:303
#, python-brace-format
msgid ""
"The field by which to sort the results. You can specify multiple fields by separating them with commas.\n"
"Available fields: {0}\n"
"Default: {1}. In addition to the builtin fields above, custom fields are also available as *field_name, for example, for a custom field #rating, use the name: *rating"
msgstr "Поле, по которому будут отсортированы результаты. Вы можете указать несколько полей, разделяя их запятыми.\nДоступные поля: {0}\nЗначение по умолчанию: {1}. В дополнение к встроенным полям, указанным выше, пользовательские поля также доступны в виде *field_name, напр., для пользовательского поля #rating используйте имя: *rating"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_list.py:310
msgid "Sort results in ascending order"
msgstr "Сортировать результаты по возрастанию"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_list.py:316
msgid ""
"Filter the results by the search query. For the format of the search query, "
"please see the search related documentation in the User Manual. Default is "
"to do no filtering."
msgstr "Фильтровать результаты запроса. С форматом запроса можно ознакомиться в соответствующей документации в руководстве пользователя. По умолчанию не фильтровать."

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_list.py:326
#: /__w/calibre/calibre/src/calibre/db/cli/cmd_list_categories.py:60
msgid ""
"The maximum width of a single line in the output. Defaults to detecting "
"screen size."
msgstr "Максимальная ширина строки вывода. По умолчанию - размер экрана."

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_list.py:328
msgid "The string used to separate fields. Default is a space."
msgstr "Разделитель полей. По умолчанию это пробел."

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_list.py:332
msgid ""
"The prefix for all file paths. Default is the absolute path to the library "
"folder."
msgstr "Префикс для всех путей. По умолчанию — абсолютный путь к папке библиотеки."

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_list.py:334
msgid "The maximum number of results to display. Default: all"
msgstr "Максимальное число результатов для отображения. По умолчанию: все"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_list.py:339
msgid ""
"Generate output in JSON format, which is more suitable for machine parsing. "
"Causes the line width and separator options to be ignored."
msgstr "Генерирует вывод в формате JSON, более подходящем для машинного разбора. Игнорирует настройки ширины строки и разделителя."

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_list.py:344
#, python-brace-format
msgid ""
"The template to run if \"{}\" is in the field list. Note that templates are "
"ignored while connecting to a calibre server. Default: None"
msgstr "Шаблон, который нужно запустить, если в списке полей есть «{}». Обратите внимание, что шаблоны игнорируются при подключении к серверу Calibre. По умолчанию: Нет"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_list.py:352
#, python-brace-format
msgid ""
"Path to a file containing the template to run if \"{}\" is in the field "
"list. Default: None"
msgstr "Путь к файлу, содержащему шаблон для запуска, если в списке полей есть '{}'. По умолчанию: Нет"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_list.py:357
#, python-format, python-brace-format
msgid ""
"Heading for the template column. Default: %default. This option is ignored "
"if the option {} is set"
msgstr "Заголовок столбца шаблона. По умолчанию: %default. Этот параметр игнорируется, если установлен параметр {}"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_list_categories.py:25
msgid ""
"%prog list_categories [options]\n"
"\n"
"Produce a report of the category information in the database. The\n"
"information is the equivalent of what is shown in the Tag browser.\n"
msgstr "%prog list_categories [настройки]\n\nГенерирует отчёт по категориям в базе данных. \nИнформация соответствует той, что отображается в Браузере тегов.\n"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_list_categories.py:39
msgid ""
"Output only the number of items in a category instead of the counts per item"
" within the category"
msgstr "Выводить только общее число записей в категории вместо поэлементного подсчёта."

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_list_categories.py:46
#, python-brace-format
msgid "The type of CSV file to produce. Choices: {}"
msgstr "Тип файла CSV для создания. Варианты: {}"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_list_categories.py:53
msgid "Comma-separated list of category lookup names. Default: all"
msgstr "Разделённый запятыми список имён поиска категорий. По умолчанию: all"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_list_categories.py:163
msgid "CATEGORY ITEMS"
msgstr "ЭЛЕМЕНТЫ КАТЕГОРИИ"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_remove.py:22
msgid ""
"%prog remove ids\n"
"\n"
"Remove the books identified by ids from the database. ids should be a comma separated list of id numbers (you can get id numbers by using the search command). For example, 23,34,57-85 (when specifying a range, the last number in the range is not included).\n"
msgstr "%prog remove ids\n\nУдалить книги, с определёнными идентификаторами из базы данных. Id должен быть разделенным запятыми списком идентификационных номеров (вы можете получить номера идентификаторов с помощью команды поиска). Напр., 23,34,57-85 (при указании диапазона последнее число в диапазоне не включено).\n"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_remove.py:31
#, python-brace-format
msgid "Do not use the {}"
msgstr "Не использовать {}"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_remove.py:37
msgid "You must specify at least one book to remove"
msgstr "Вы должны указать хотя бы одну книгу для удаления"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_remove_custom_column.py:22
msgid ""
"%prog remove_custom_column [options] label\n"
"\n"
"Remove the custom column identified by label. You can see available\n"
"columns with the custom_columns command.\n"
"    "
msgstr "%prog remove_custom_column [options] labelУдалить пользовательский столбец, идентифицированный меткой. Вы можете увидеть доступные столбцы с командой custom_columns.    "

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_remove_custom_column.py:30
msgid "Do not ask for confirmation"
msgstr "Не запрашивать подтверждение"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_remove_custom_column.py:43
#, python-format
msgid "You will lose all data in the column: %s. Are you sure (y/n)? "
msgstr "Вы потеряете все данные в столбце %s. Вы уверены (да/нет)? "

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_remove_custom_column.py:44
msgid "y"
msgstr "д"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_remove_custom_column.py:49
#, python-format
msgid ""
"No column named %s found. You must use column labels, not titles. Use "
"calibredb custom_columns to get a list of labels."
msgstr "Не найден столбец %s. Вы должны использовать системное название, а не видимое. Для получения списка названий столбцов используйте функцию calibredb custom_columns."

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_remove_custom_column.py:55
msgid "Error: You must specify a column label"
msgstr "Ошибка: Вы должны указать заголовок столбца"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_remove_format.py:22
msgid ""
"\n"
"%prog remove_format [options] id fmt\n"
"\n"
"Remove the format fmt from the logical book identified by id. You can get id by using the search command. fmt should be a file extension like LRF or TXT or EPUB. If the logical book does not have fmt available, do nothing.\n"
msgstr "\n%prog remove_format [параметры] id fmt\n\nУдалить формат fmt из логической книги с идентификатором id. Получить id — команда search. fmt должен быть расширением файла, напр. LRF, или TXT, или EPUB. Если логическая книга не имеет доступного fmt не делать ничего.\n"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_remove_format.py:36
msgid "You must specify an id and a format"
msgstr "Вы должны указать ИД и формат"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_restore_database.py:20
msgid ""
"%prog restore_database [options]\n"
"\n"
"Restore this database from the metadata stored in OPF files in each\n"
"folder of the calibre library. This is useful if your metadata.db file\n"
"has been corrupted.\n"
"\n"
"WARNING: This command completely regenerates your database. You will lose\n"
"all saved searches, user categories, plugboards, stored per-book conversion\n"
"settings, and custom recipes. Restored metadata will only be as accurate as\n"
"what is found in the OPF files.\n"
"    "
msgstr "%prog restore_database [параметры]\n\nВосстановить эту базу данных из метаданных, хранящихся в файлах OPF в каждом\nпапка библиотеки calibre. Это полезно, если ваш файл metadata.db\nбыл поврежден.\n\nВНИМАНИЕ: Эта команда полностью регенерирует вашу базу данных. Теряются\nвсе сохранённые поисковые запросы, категории пользователей, плагины, сохранённые конвертации для каждой книги\nнастройки и пользовательские рецепты. Восстановленные метаданные будут иметь точность как\nв файлах OPF."

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_restore_database.py:40
msgid ""
"Really do the recovery. The command will not run unless this option is "
"specified."
msgstr "Действительно выполнить восстановление. Команда не запустится пока эта опция не определена."

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_restore_database.py:58
#, python-format
msgid "You must provide the %s option to do a recovery"
msgstr "Вы должны указать параметр %s, чтобы выполнить восстановление"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_saved_searches.py:35
msgid ""
"%prog saved_searches [options] (list|add|remove)\n"
"\n"
"Manage the saved searches stored in this database.\n"
"If you try to add a query with a name that already exists, it will be\n"
"replaced.\n"
"\n"
"Syntax for adding:\n"
"\n"
"%prog saved_searches add search_name search_expression\n"
"\n"
"Syntax for removing:\n"
"\n"
"%prog saved_searches remove search_name\n"
"    "
msgstr "%prog saved_searches [options] (list|add|remove)\nУправление сохраненными в этой базе данных поисками.\nПри добавлении запроса с уже существующим именем, он будет\nзаменён.\n\nСинтаксис для добавления:\n\n%prog saved_searches add search_name search_expression\n\nСинтаксис для удаления:\n\n%prog saved_searches remove search_name"

#: /__w/calibre/calibre/src/calibre/db/cli/cmd_saved_searches.py:59
#: /__w/calibre/calibre/src/calibre/gui2/llm.py:586
