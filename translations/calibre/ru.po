#: /__w/calibre/calibre/src/calibre/gui2/css_transform_rules.py:41
#, python-brace-format
msgid "{preamble} {property} {match_type} {query}"
msgstr "{preamble} {property} {match_type} {query}"

#: /__w/calibre/calibre/src/calibre/gui2/css_transform_rules.py:47
msgid "If the &property:"
msgstr "Если &свойство:"

#: /__w/calibre/calibre/src/calibre/gui2/css_transform_rules.py:52
msgid ""
"The name of a CSS property, for example: font-size\n"
"Do not use shorthand properties, they will not work.\n"
"For instance use margin-top, not margin."
msgstr "Название свойства CSS, напр. font-size.\nНе используйте сокращения свойств, они не будут работать.\nНапр., используйте margin-top, а не margin."

#: /__w/calibre/calibre/src/calibre/gui2/css_transform_rules.py:72
#, python-brace-format
msgid "{action} {action_data}"
msgstr "{action} {action_data}"

#: /__w/calibre/calibre/src/calibre/gui2/css_transform_rules.py:105
msgid "The CSS property value"
msgstr "Значение свойства CSS"

#: /__w/calibre/calibre/src/calibre/gui2/css_transform_rules.py:112
msgid ""
"Either a CSS length, such as 10pt or a unit less number. If a unit less "
"number is used it will be compared with the CSS value using whatever unit "
"the value has. Note that comparison automatically converts units, except for"
" relative units like percentage or em, for which comparison fails if the "
"units are different."
msgstr "Введите длину CSS, такую как 10 пт или число без единицы измерения. Если используется просто число, оно будет сравниваться со значением CSS в независимости от единиц измерения. Сравнение автопреобразует единицы измерения, кроме зависимых, напр. процентов или em. Для последних сравнение не сработает, если единицы измерения различны."

#: /__w/calibre/calibre/src/calibre/gui2/css_transform_rules.py:123
msgid ""
"CSS properties to add to the rule that contains the matching style. You can "
"specify more than one property, separated by semi-colons, for example: "
"color:red; font-weight: bold"
msgstr "Свойства CSS для добавления в правило, которое содержит подходящий стиль. Вы можете задать несколько свойств, разделённых точкой с запятой, напр.: color:red; font-weight: bold"

#: /__w/calibre/calibre/src/calibre/gui2/css_transform_rules.py:128
