#: /__w/calibre/calibre/src/calibre/gui2/preferences/coloring.py:402
msgid ""
"You can add icons to columns in the book list by creating \"rules\" that "
"tell calibre what icon to use."
msgstr "Вы можете добавлять значки в столбцы списка книг, создавая «правила», которые сообщают calibre, какой значок использовать."

#: /__w/calibre/calibre/src/calibre/gui2/preferences/coloring.py:406
msgid "Cover grid emblem"
msgstr "Эмблема сетки обложек"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/coloring.py:407
