msgstr "Нечёткий"

#: /__w/calibre/calibre/src/calibre/gui2/tweak_book/search.py:249
#: /__w/calibre/calibre/src/calibre/gui2/tweak_book/text_search.py:24
#: /__w/calibre/calibre/src/calibre/gui2/viewer/search.py:514
msgid "Regex"
msgstr "Регулярное выражение"

