msgid "Invalid image"
msgstr "Neplatný obrázok"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/images.py:17
msgid ""
"An invalid image is an image that could not be loaded, typically because it "
"is corrupted. You should replace it with a good image or remove it."
msgstr "Neplatný obrázok je obrázok, ktorý sa nepodarilo načítať, zvyčajne preto, že je poškodený. Mali by ste ho nahradiť dobrým obrázkom alebo ho odstrániť."

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/images.py:25
msgid ""
"Reader devices based on Adobe Digital Editions cannot display images whose "
"colors are specified in the CMYK colorspace. You should convert this image "
"to the RGB colorspace, for maximum compatibility."
msgstr "Čítacie zariadenia založené na Adobe Digital Editions nedokážu zobraziť obrázky, ktorých farby sú zadané v farebnom priestore CMYK. Mali by ste tento obrázok konvertovať do farebného priestoru RGB pre maximálnu kompatibilitu."

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/images.py:29
msgid "Convert image to RGB automatically"
msgstr "Konvertovať obrázok do RGB automaticky"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/images.py:66
msgid "Image is in the CMYK colorspace"
msgstr "Obrázok je v farebnom priestore CMYK"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/links.py:22
msgid ""
"The resource pointed to by this link does not exist. You should either fix, "
"or remove the link."
msgstr "Zdroj, na ktorý tento odkaz smeruje, neexistuje. Mali by ste odkaz buď opraviť, alebo odstrániť."

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/links.py:27
msgid "Link points to a folder"
msgstr "Odkaz smeruje na priečinok"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/links.py:31
msgid "Invalid character in link"
msgstr "Neplatný znak v odkaze"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/links.py:32
msgid ""
"Windows computers do not allow the : character in filenames. For maximum "
"compatibility it is best to not use these in filenames/links to files."
msgstr "Počítače Windows nepovoľujú znak : v názvoch súborov. Pre maximálnu kompatibilitu je najlepšie ho nepoužívať v názvoch súborov/odkazoch na súbory."

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/links.py:36
msgid "Malformed URL"
msgstr "Deformovaná URL"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/links.py:37
msgid "This URL could not be parsed."
msgstr "Túto URL adresu nebolo možné spracovať."

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/links.py:42
msgid "Case of link does not match case of file"
msgstr "Prípad spojenia nezodpovedá prípadu súboru"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/links.py:45
#, python-brace-format
msgid "The linked to resource {0} does not exist"
msgstr "Odkazovaný zdroj {0} neexistuje"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/links.py:47
#, python-brace-format
msgid ""
"The case of the link {0} and the case of the actual file it points to {1} do"
" not agree. You should change either the case of the link or rename the "
"file."
msgstr "Veľkosť písmen odkazu {0} a veľkosť písmen skutočného súboru, na ktorý odkazuje {1}, sa nezhodujú. Mali by ste zmeniť buď veľkosť písmen odkazu, alebo premenovať súbor."

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/links.py:50
msgid "Change the case of the link to match the actual file"
msgstr "Zmeniť veľkosť písmen odkazu tak, aby zodpovedala skutočnému súboru"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/links.py:79
msgid "Link points to a file that is not a text document"
msgstr "Odkaz smeruje na súbor, ktorý nie je textovým dokumentom"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/links.py:81
#, python-brace-format
msgid ""
"The link \"{0}\" points to a file <i>{1}</i> that is not a text (HTML) "
"document. Many e-book readers will be unable to follow such a link. You "
"should either remove the link or change it to point to a text document. For "
"example, if it points to an image, you can create small wrapper document "
"that contains the image and change the link to point to that."
msgstr "Odkaz \"{0}\" ukazuje na súbor <i>{1}</i>, ktorý nie je textovým (HTML) dokumentom. Mnohé čítačky e-kníh nebudú schopné takýto odkaz sledovať. Mali by ste buď odkaz odstrániť, alebo ho zmeniť tak, aby ukazoval na textový dokument. Ak napríklad ukazuje na obrázok, môžete vytvoriť malý obalový dokument, ktorý obsahuje obrázok, a zmeniť odkaz tak, aby ukazoval naň."

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/links.py:94
msgid "Link points to a location not present in the target file"
msgstr "Odkaz smeruje na umiestnenie, ktoré nie je v cieľovom súbore"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/links.py:97
#, python-brace-format
msgid ""
"The link \"{0}\" points to a location <i>{1}</i> in the file {2} that does "
"not exist. You should either remove the location so that the link points to "
"the top of the file, or change the link to point to the correct location."
msgstr "Odkaz \"{0}\" ukazuje na miesto <i>{1}</i> v súbore {2}, ktoré neexistuje. Mali by ste buď odstrániť miesto tak, aby odkaz ukazoval na začiatok súboru, alebo zmeniť odkaz tak, aby ukazoval na správne miesto."

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/links.py:104
msgid "Link uses the file:// URL scheme"
msgstr "Link používa schému file:// URL"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/links.py:106
msgid ""
"This link uses the file:// URL scheme. This does not work with many e-book "
"readers. Remove the file:// prefix and make sure the link points to a file "
"inside the book."
msgstr "Tento odkaz používa schému URL file://. Toto nefunguje s mnohými čítačkami e-kníh. Odstráňte predponu file:// a uistite sa, že odkaz smeruje na súbor vnútri knihy."

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/links.py:112
msgid "Link points to a file outside the book"
msgstr "Odkaz odkazuje na súbor mimo knihy"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/links.py:114
msgid ""
"This link points to a file outside the book. It will not work if the book is"
" read on any computer other than the one it was created on. Either fix or "
"remove the link."
msgstr "Tento odkaz smeruje na súbor mimo knihy. Nebude fungovať, ak sa kniha číta na inom počítači, ako na ktorom bola vytvorená. Odkaz buď opravte, alebo odstráňte."

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/links.py:121
msgid "Empty link"
msgstr "Prázdny odkaz"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/links.py:122
msgid ""
"This link is empty. This is almost always a mistake. Either fill in the link"
" destination or remove the link tag."
msgstr "Tento odkaz je prázdny. To je takmer vždy chyba. Buď zadajte cieľ odkazu, alebo zmažte tag odkazu."

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/links.py:126
msgid "File is not referenced"
msgstr "Súbor nie je odkazovaný"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/links.py:128
msgid ""
"This file is included in the book but not referred to by any document in the"
" spine. This means that the file will not be viewable on most e-book "
"readers. You should  probably remove this file from the book or add a link "
"to it somewhere."
msgstr "Tento súbor je zahrnutý v knihe, ale žiadny dokument v hlavnom toku (spine) sa naň neodkazuje. To znamená, že súbor nebude viditeľný vo väčšine čítačiek e-kníh. Mali by ste tento súbor pravdepodobne z knihy odstrániť alebo naň niekde pridať odkaz."

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/links.py:134
#, python-format
msgid "The file %s is not referenced"
msgstr "Na súbor %s sa neodkazuje"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/links.py:138
msgid "File is not in the spine"
msgstr "Súbor nie je v chrbte"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/links.py:139
msgid ""
"This file is not in the book spine. All content documents must be in the "
"spine. You should probably add it to the spine."
msgstr "Tento súbor nie je v chrbte knihy. Všetky obsahové dokumenty musia byť v chrbte. Pravdepodobne by ste ho mali do chrbta pridať."

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/links.py:140
msgid "Append this file to the spine"
msgstr "Pripojiť tento súbor do chrbta"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/links.py:158
msgid "File is not listed in the manifest"
msgstr "Súbor nie je uvedený v manifeste"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/links.py:160
msgid ""
"This file is not listed in the book manifest. While not strictly necessary "
"it is good practice to list all files in the manifest. Either list this file"
" in the manifest or remove it from the book if it is an unnecessary file."
msgstr "Tento súbor nie je uvedený v manifeste knihy. Aj keď to nie je striktne nutné, je dobrým zvykom uviesť všetky súbory v manifeste. Buď tento súbor uveďte v manifeste, alebo ho odstráňte z knihy, ak je nepotrebný."

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/links.py:166
#, python-format
msgid "The file %s is not listed in the manifest"
msgstr "Súbor %s nie je uvedený v manifeste"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/links.py:169
#, python-format
msgid "Add %s to the manifest"
msgstr "Pridať %s do manifestu"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/links.py:169
#, python-format
msgid "Remove %s from the book"
msgstr "Odstrániť %s z knihy"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/links.py:183
msgid "Linked resource does not exist"
msgstr "Prepojený zdroj neexistuje"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/links.py:187
#, python-format
msgid "Remove all references to %s from the HTML and CSS in the book"
msgstr "Odstrániť všetky odkazy na %s z HTML a CSS v knihe"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/links.py:195
msgid "Bookmarks file present"
msgstr "Súbor so záložkami"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/links.py:197
msgid ""
"This file stores the bookmarks and last opened information from the calibre "
"E-book viewer. You can remove it if you do not need that information, or "
"don't want to share it with other people you send this book to."
msgstr "Tento súbor ukladá záložky a informácie o poslednom otvorení zo Zobrazovača E-knih calibre. Môžete ho odobrať, pokiaľ tieto informácie nepotrebujete, alebo ich nechcete zdielať s inými ľuďmi, ktorým posielate túto knihu."

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/links.py:202
#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/parsing.py:31
msgid "Remove this file"
msgstr "Odstrániť tento súbor"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/links.py:206
msgid "The bookmarks file used by the calibre E-book viewer is present"
msgstr "Je prítomný súbor záložiek používaný Zobrazovačom E-knih calibre"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/links.py:214
msgid "MIME type does not match file extension"
msgstr "Typ MIME sa nezhoduje s príponou súboru"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/links.py:220
#, python-format
msgid "The file %s has a MIME type that does not match its extension"
msgstr "Súbor %s má typ MIME, ktorý nezodpovedá jeho prípone"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/links.py:223
#, python-brace-format
msgid ""
"The file {0} has its MIME type specified as {1} in the OPF file. The "
"recommended MIME type for files with the extension \"{2}\" is {3}. You "
"should change either the file extension or the MIME type in the OPF."
msgstr "Súbor {0} má v súbore OPF zadaný typ MIME ako {1}. Odporúčaný typ MIME pre súbory s príponou \"{2}\" je {3}. Mali by ste zmeniť buď príponu súboru, alebo typ MIME v OPF."

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/links.py:228
msgid "Change the file extension to .xhtml"
msgstr "Zmeniť príponu súboru na .xhtml"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/links.py:231
#, python-format
msgid "Change the MIME type for this file in the OPF to %s"
msgstr "Zmeniť typ MIME pre tento súbor v OPF na %s"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/links.py:354
msgid "The link is empty"
msgstr "Odkaz je prázdny"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/links.py:369
#, python-format
msgid "The linked resource %s is a folder"
msgstr "Odkazovaný zdroj %s je priečinok"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/links.py:377
#, python-format
msgid "The linked resource %s does not exist"
msgstr "Odkazovaný zdroj %s neexistuje"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/links.py:382
#, python-brace-format
msgid "The URL {} could not be parsed"
msgstr "URL adresu {} nebolo možné spracovať"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/links.py:385
#, python-format
msgid "The link %s is a file:// URL"
msgstr "Odkaz %s je URL adresa file://"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/links.py:387
#, python-format
msgid "The link %s points to a file outside the book"
msgstr "Odkaz %s smeruje na súbor mimo knihy"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/links.py:391
#, python-format
msgid ""
"The link %s contains a : character, this will cause errors on Windows "
"computers"
msgstr "Odkaz %s obsahuje znak :, čo spôsobí chyby na počítačoch Windows"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/opf.py:16
msgid "The OPF does not have the correct root element"
msgstr "OPF nemá správny koreňový prvok"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/opf.py:17
#, python-brace-format
msgid ""
"The OPF must have the root element <package> in namespace {0}, like this: "
"<package xmlns=\"{0}\">"
msgstr "OPF musí mať koreňový prvok <package> v mennom priestore {0}, takto: <package xmlns=\"{0}\">"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/opf.py:22
msgid "The OPF does not have a version"
msgstr "OPF nemá verziu"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/opf.py:24
msgid ""
"The <package> tag in the OPF must have a version attribute. This is usually "
"version=\"2.0\" for EPUB2 and AZW3 and version=\"3.0\" for EPUB3"
msgstr "Značka <package> v OPF musí mať atribút version. Zvyčajne je to version=\"2.0\" pre EPUB2 a AZW3 a version=\"3.0\" pre EPUB3"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/opf.py:29
msgid "Missing section in the OPF"
msgstr "Chýbajúca časť v OPF"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/opf.py:32
#, python-format
msgid "The <%s> section is missing from the OPF"
msgstr "V OPF chýba sekcia <%s>"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/opf.py:33
#, python-format
msgid "The <%s> section is required in the OPF file. You have to create one."
msgstr "Sekcia <%s> je v súbore OPF povinná. Musíte ju vytvoriť."

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/opf.py:38
msgid "Empty id attributes are invalid"
msgstr "Prázdne atribúty id sú neplatné"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/opf.py:39
msgid "Empty ID attributes are invalid in OPF files."
msgstr "Prázdne atribúty ID sú v súboroch OPF neplatné."

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/opf.py:43
msgid "idref points to unknown id"
msgstr "idref ukazuje na neznáme ID"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/opf.py:46
#, python-format
msgid "idref=\"%s\" points to unknown id"
msgstr "idref=\"%s\" odkazuje na neznáme id"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/opf.py:47
#, python-format
msgid "The idref=\"%s\" points to an id that does not exist in the OPF"
msgstr "idref=\"%s\" odkazuje na id, ktoré v OPF neexistuje"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/opf.py:52
msgid "The meta cover tag points to an non-existent item"
msgstr "Značka meta cover odkazuje na neexistujúcu položku"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/opf.py:53
#, python-format
msgid ""
"The meta cover tag points to an item with id=\"%s\" which does not exist in "
"the manifest"
msgstr "Značka meta cover odkazuje na položku s id=\"%s\", ktorá v manifeste neexistuje"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/opf.py:58
msgid ""
"Some e-book readers such as the Nook fail to recognize covers if the content"
" attribute comes before the name attribute. For maximum compatibility move "
"the name attribute before the content attribute."
msgstr "Niektoré čítačky e-kníh, ako Nook, nedokážu rozpoznať obálky, ak atribút content predchádza atribútu name. Pre maximálnu kompatibilitu presuňte atribút name pred atribút content."

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/opf.py:62
msgid "Move the name attribute before the content attribute"
msgstr "Presunúť atribút name pred atribút content"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/opf.py:65
msgid "The meta cover tag has content before name"
msgstr "Značka meta cover má obsah pred názvom"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/opf.py:75
msgid "Incorrect Table of Contents item"
msgstr "Nesprávna položka obsahu"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/opf.py:79
#, python-format
msgid "The item identified as the Table of Contents (%s) does not exist"
msgstr "Položka identifikovaná ako obsah (%s) neexistuje"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/opf.py:80
#, python-format
msgid "There is no item with id=\"%s\" in the manifest."
msgstr "V manifeste nie je žiadna položka s id=\"%s\"."

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/opf.py:82
#, python-format
msgid ""
"The item identified as the Table of Contents has an incorrect media-type "
"(%s)"
msgstr "Položka identifikovaná ako obsah má nesprávny media-type (%s)"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/opf.py:83
#, python-format
msgid "The media type for the Table of Contents must be %s"
msgstr "Typ média pre obsah musí byť %s"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/opf.py:88
msgid ""
"This manifest entry has no href attribute. Either add the href attribute or "
"remove the entry."
msgstr "Táto položka manifestu nemá atribút href. Buď pridajte atribút href, alebo odstráňte položku."

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/opf.py:89
msgid "Remove this manifest entry"
msgstr "Odstrániť túto položku manifestu"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/opf.py:92
msgid "Item in manifest has no href attribute"
msgstr "Položka v manifeste nemá atribút href"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/opf.py:107
msgid ""
"The <spine> tag has no reference to the NCX table of contents file. Without "
"this reference, the table of contents will not work in most readers. The "
"reference should look like <spine toc=\"id of manifest item for the ncx "
"file\">."
msgstr "Značka <spine> neobsahuje odkaz na súbor obsahu NCX. Bez tohto odkazu nebude obsah fungovať vo väčšine čítačiek. Odkaz by mal vyzerať takto: <spine toc=\"id položky manifestu pre súbor ncx\">."

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/opf.py:111
msgid "Add the reference to the NCX file"
msgstr "Pridať odkaz do súboru NCX"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/opf.py:114
msgid "Missing reference to the NCX Table of Contents"
msgstr "Chýba odkaz na obsah NCX"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/opf.py:129
msgid ""
"This book has no Navigation document. According to the EPUB 3 specification,"
" a navigation document is required. The Navigation document contains the "
"Table of Contents. Use the Table of Contents tool to add a Table of Contents"
" to this book."
msgstr "Táto kniha nemá navigačný dokument. Podľa špecifikácie EPUB 3 je navigačný dokument povinný. Navigačný dokument obsahuje obsah (table of contents). Na pridanie obsahu do knihy použite nástroj Obsah."

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/opf.py:135
msgid "Missing navigation document"
msgstr "Chýba navigačný dokument"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/opf.py:140
msgid ""
"The nav document for this book contains no table of contents, or an empty "
"table of contents. Use the Table of Contents tool to add a Table of Contents"
" to this book."
msgstr "Navigačný dokument tejto knihy neobsahuje obsah alebo obsahuje prázdny obsah. Na pridanie obsahu do tejto knihy použite nástroj Obsah."

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/opf.py:146
msgid "Missing ToC in navigation document"
msgstr "Chýbajúce ToC (Obsah) v navigačnom dokumente"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/opf.py:150
msgid "Item in manifest is missing"
msgstr "Chýba položka v manifeste"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/opf.py:151
msgid ""
"A file listed in the manifest is missing, you should either remove it from "
"the manifest or add the missing file to the book."
msgstr "Chýba súbor uvedený v manifeste, mali by ste ho buď odstrániť z manifestu, alebo pridať chýbajúci súbor do knihy."

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/opf.py:154
#, python-format
msgid "Item (%s) in manifest is missing"
msgstr "Položka (%s) chýba v manifeste"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/opf.py:156
#, python-format
msgid "Remove the entry for %s from the manifest"
msgstr "Odstrániť položku pre %s z manifestu"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/opf.py:170
msgid ""
"There are items marked as non-linear in the <spine>. These will be displayed"
" in random order by different e-book readers. Some will ignore the non-"
"linear attribute, some will display them at the end or the beginning of the "
"book and some will fail to display them at all. Instead of using non-linear "
"items simply place the items in the order you want them to be displayed."
msgstr "V <spine> sú položky označené ako nelineárne (non-linear). Rôzne čítačky e-kníh ich zobrazia v náhodnom poradí. Niektoré ignorujú atribút non-linear, niektoré ich zobrazia na konci alebo na začiatku knihy a niektoré ich vôbec nedokážu zobraziť. Namiesto používania nelineárnych položiek jednoducho umiestnite položky v poradí, v akom ich chcete zobraziť."

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/opf.py:179
msgid "Mark all non-linear items as linear"
msgstr "Označiť všetky nelineárne položky ako lineárne"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/opf.py:182
msgid "Non-linear items in the spine"
msgstr "Nelineárne položky v chrbte"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/opf.py:192
msgid "Duplicate item in manifest or spine"
msgstr "Duplikovaný predmet v manifeste alebo chrbte"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/opf.py:195
msgid "Remove all but the first duplicate item"
msgstr "Odstrániť všetky duplicitné položky okrem prvej"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/opf.py:199
#, python-brace-format
msgid "Duplicate item in {0}: {1}"
msgstr "Duplicitná položka v {0}: {1}"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/opf.py:200
#, python-brace-format
msgid ""
"The item {0} is present more than once in the {2} in {1}. This is not "
"allowed."
msgstr "Položka {0} sa vyskytuje viackrát v {2} v {1}. Toto nie je povolené."

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/opf.py:215
msgid ""
"There is more than one <meta name=\"cover\"> tag defined. There should be "
"only one."
msgstr "Je definovaná viac ako jedna značka <meta name=\"cover\">. Mala by byť len jedna."

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/opf.py:216
msgid "Remove all but the first meta cover tag"
msgstr "Odstrániť všetky značky meta cover okrem prvej"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/opf.py:219
msgid "There is more than one cover defined"
msgstr "Je definovaných viac ako jeden obal"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/opf.py:230
msgid ""
"The OPF must have an unique identifier, i.e. a <dc:identifier> element whose"
" id is referenced by the <package> element"
msgstr "OPF musí mať jedinečný identifikátor, t. j. prvok <dc:identifier>, na ktorého id odkazuje prvok <package>"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/opf.py:231
msgid "Auto-generate a unique identifier"
msgstr "Automaticky vygenerovať jedinečný identifikátor"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/opf.py:234
msgid "The OPF has no unique identifier"
msgstr "OPF nemá jedinečný identifikátor"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/opf.py:256
msgid "The <dc:identifier> element must not be empty."
msgstr "Element<dc:identifier> nesmie byť prázdny."

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/opf.py:257
msgid "Remove empty identifiers"
msgstr "Odstrániť prázdne identifikátory"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/opf.py:260
msgid "Empty identifier element"
msgstr "Prázdny prvok identifikátora"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/opf.py:272
msgid "Incorrect media-type for spine item"
msgstr "Nesprávny media-type pre položku chrbta"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/opf.py:274
#, python-brace-format
msgid ""
"The item {0} present in the spine has the media-type {1}.  Most e-book "
"software cannot handle non-HTML spine items.  If the item is actually HTML, "
"you should change its media-type to {2}. If it is not-HTML you should "
"consider replacing it with an HTML item, as it is unlikely to work in most "
"readers."
msgstr "Položka {0} prítomná v hlavnom toku (spine) má media-type {1}. Väčšina softvéru na čítanie e-kníh nedokáže spracovať iné ako HTML položky spine. Ak je položka v skutočnosti HTML, mali by ste zmeniť jej media-type na {2}. Ak nie je HTML, mali by ste zvážiť jej nahradenie položkou HTML, keďže je nepravdepodobné, že bude fungovať vo väčšine čítačiek."

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/opf.py:281
#, python-format
msgid "Change the media-type to %s"
msgstr "Zmeniť media-type na %s"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/parsing.py:29
msgid "Empty file"
msgstr "Prázdny súbor"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/parsing.py:30
msgid ""
"This file is empty, it contains nothing, you should probably remove it."
msgstr "Tento súbor je prázdny, nič neobsahuje, asi by ste ho mali odstrániť."

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/parsing.py:34
#, python-format
msgid "The file %s is empty"
msgstr "Súbor %s je prázdny"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/parsing.py:45
msgid ""
"A decoding errors means that the contents of the file could not be "
"interpreted as text. This usually happens if the file has an incorrect "
"character encoding declaration or if the file is actually a binary file, "
"like an image or font that is mislabelled with an incorrect media type in "
"the OPF."
msgstr "Chyba dekódovania znamená, že obsah súboru sa nedal interpretovať ako text. Toto sa bežne stáva, ak má súbor nesprávne deklarované kódovanie znakov, alebo ak je súbor v skutočnosti binárny súbor, ako obrázok alebo písmo, nesprávne označené nesprávnym typom médií v OPF."

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/parsing.py:53
#, python-format
msgid "Parsing of %s failed, could not decode"
msgstr "Analýza %s zlyhala, nepodarilo sa dekódovať"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/parsing.py:60
msgid ""
"A parsing error in an XML file means that the XML syntax in the file is "
"incorrect. Such a file will most probably not open in an e-book reader. "
"These errors can  usually be fixed automatically, however, automatic fixing "
"can sometimes  \"do the wrong thing\"."
msgstr "Chyba spracovania v súbore XML znamená, že syntax XML v súbore je nesprávna. Takýto súbor sa s najväčšou pravdepodobnosťou neotvorí v čítačke e-kníh. Tieto chyby sa dajú zvyčajne opraviť automaticky, avšak automatická oprava môže niekedy \"urobiť nesprávnu vec\"."

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/parsing.py:77
msgid ""
"A parsing error in an HTML file means that the HTML syntax is incorrect. "
"Most readers will automatically ignore such errors, but they may result in  "
"incorrect display of content. These errors can usually be fixed "
"automatically, however, automatic fixing can sometimes \"do the wrong "
"thing\"."
msgstr "Chyba spracovania v súbore HTML znamená, že syntax HTML je nesprávna. Väčšina čítačiek takéto chyby automaticky ignoruje, ale môžu spôsobiť nesprávne zobrazenie obsahu. Tieto chyby sa dajú zvyčajne opraviť automaticky, avšak automatická oprava môže niekedy \"urobiť nesprávnu vec\"."

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/parsing.py:86
msgid ""
"This HTML file uses private entities. These are not supported. You can try "
"running \"Fix HTML\" from the Tools menu, which will try to automatically "
"resolve the private entities."
msgstr "Tento súbor HTML používa súkromné entity. Tie nie sú podporované. Môžete skúsiť spustiť \"Opraviť HTML\" z ponuky Nástroje, čo sa pokúsi automaticky vyriešiť súkromné entity."

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/parsing.py:94
msgid ""
"Replace all named entities with their character equivalents in this book"
msgstr "Nahradiť všetky pomenované entity ich znakovými ekvivalentmi v tejto knihe"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/parsing.py:96
msgid ""
"Named entities are often only incompletely supported by various book reading"
" software. Therefore, it is best to not use them, replacing them with the "
"actual characters they represent. This can be done automatically."
msgstr "Pomenované entity sú softvérom na čítanie kníh často podporované iba čiastočne. Preto je najlepšie ich nepoužívať a nahradiť ich skutočnými znakmi, ktoré reprezentujú. Toto sa dá vykonať automaticky."

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/parsing.py:102
msgid "Named entities present"
msgstr "Prítomné pomenované entity"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/parsing.py:133
msgid "Filename contains unsafe characters"
msgstr "Názov súboru obsahuje nebezpečné znaky"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/parsing.py:138
#, python-brace-format
msgid ""
"The filename {0} contains unsafe characters, that must be escaped, like this"
" {1}. This can cause problems with some e-book readers. To be absolutely "
"safe, use only the English alphabet [a-z], the numbers [0-9], underscores "
"and hyphens in your file names. While many other characters are allowed, "
"they may cause problems with some software."
msgstr "Názov súboru {0} obsahuje nebezpečné znaky, ktoré musia byť escapované, napríklad takto: {1}. Toto môže spôsobiť problémy s niektorými čítačkami e-kníh. Pre absolútnu bezpečnosť používajte v názvoch súborov iba anglickú abecedu [a-z], čísla [0-9], podčiarkovníky a pomlčky. Aj keď je povolených mnoho ďalších znakov, môžu spôsobiť problémy s niektorým softvérom."

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/parsing.py:144
#, python-brace-format
msgid "Rename the file {0} to {1}"
msgstr "Premenovať súbor {0} na {1}"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/parsing.py:163
msgid "File too large"
msgstr "Súbor je príliš veľký"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/parsing.py:165
#, python-brace-format
msgid ""
"This HTML file is larger than {}. Too large HTML files can cause performance"
" problems on some e-book readers. Consider splitting this file into smaller "
"sections."
msgstr "Tento súbor HTML je väčší ako {}. Príliš veľké súbory HTML môžu spôsobiť problémy s výkonom na niektorých čítačkách e-kníh. Zvážte rozdelenie tohto súboru na menšie časti."

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/parsing.py:171
msgid "Invalid entity"
msgstr "Neplatná entita"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/parsing.py:172
msgid ""
"This is an invalid (unrecognized) entity. Replace it with whatever text it "
"is supposed to have represented."
msgstr "Toto je neplatná (nerozpoznaná) entita. Nahraďte ju akýmkoľvek textom, ktorý mala predstavovať."

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/parsing.py:175
#, python-format
msgid "Invalid entity: %s"
msgstr "Neplatná entita: %s"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/parsing.py:179
msgid ""
"Run fix HTML on this file, which will automatically insert the correct "
"namespace"
msgstr "Spustiť opravu HTML na tomto súbore, čo automaticky vloží správny menný priestor"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/parsing.py:182
msgid "Invalid or missing namespace"
msgstr "Neplatný alebo chýbajúci menný priestor"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/parsing.py:185
#, python-brace-format
msgid ""
"This file has {0}. Its namespace must be {1}. Set the namespace by defining "
"the xmlns attribute on the <html> element, like this <html xmlns=\"{1}\">"
msgstr "Tento súbor má {0}. Jeho menný priestor musí byť {1}. Nastavte menný priestor definovaním atribútu xmlns na prvku <html>, takto: <html xmlns=\"{1}\">"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/parsing.py:187
#, python-format
msgid "incorrect namespace %s"
msgstr "nesprávny menný priestor %s"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/parsing.py:187
msgid "no namespace"
msgstr "žiadny menný priestor"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/parsing.py:198
msgid "Change this file's encoding to UTF-8"
msgstr "Zmeniť kódovanie tohto súboru na UTF-8"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/parsing.py:201
msgid "Non UTF-8 encoding declaration"
msgstr "Deklarácia kódovania iného ako UTF-8"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/parsing.py:203
#, python-format
msgid ""
"This file has its encoding declared as %s. Some reader software cannot "
"handle non-UTF8 encoded files. You should change the encoding to UTF-8."
msgstr "Tento súbor má deklarované kódovanie ako %s. Niektorý softvér čítačiek nedokáže spracovať súbory s kódovaním iným ako UTF-8. Mali by ste zmeniť kódovanie na UTF-8."

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/parsing.py:276
msgid "Private entities found"
msgstr "Nájdené súkromné entity"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/parsing.py:315
msgid "Duplicate id"
msgstr "Duplikát ID"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/parsing.py:318
msgid "Remove the duplicate ids from all but the first element"
msgstr "Odstrániť duplicitné id zo všetkých prvkov okrem prvého"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/parsing.py:321
#, python-format
msgid "Duplicate id: %s"
msgstr "Duplicitné id: %s"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/parsing.py:322
#, python-brace-format
msgid ""
"The id {0} is present on more than one element in {1}. This is not allowed. "
"Remove the id from all but one of the elements"
msgstr "Id {0} sa nachádza na viacerých prvkoch v {1}. Toto nie je povolené. Odstráňte id zo všetkých prvkov okrem jedného"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/parsing.py:350
msgid "Invalid id"
msgstr "Neplatné ID"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/parsing.py:352
msgid "Replace this id with a valid id"
msgstr "Nahraďte toto ID platným ID"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/parsing.py:355
#, python-format
msgid "Invalid id: %s"
msgstr "Neplatné id: %s"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/parsing.py:358
#, python-brace-format
msgid ""
"The id {0} is not a valid id. IDs must start with a letter ([A-Za-z]) and "
"may be followed by any number of letters, digits ([0-9]), hyphens (\"-\"), "
"underscores (\"_\"), colons (\":\"), and periods (\".\"). This is to ensure "
"maximum compatibility with a wide range of devices."
msgstr "Id {0} nie je platné id. Id musia začínať písmenom ([A-Za-z]) a môže za nimi nasledovať ľubovoľný počet písmen, číslic ([0-9]), pomlčiek (\"-\"), podčiarkovníkov (\"_\"), dvojbodiek (\":\") a bodiek (\".\"). Toto zabezpečuje maximálnu kompatibilitu so širokou škálou zariadení."

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/parsing.py:365
msgid ""
"Fixing this will replace the id in all HTML files that use it, along with "
"links and CSS selectors that refer to it. References in JavaScript are not "
"updated."
msgstr "Oprava tohto nahradí id vo všetkých HTML súboroch, ktoré ho používajú, spolu s odkazmi a CSS selektormi, ktoré sa naň odvolávajú. Odkazy v JavaScripte nie sú aktualizované."

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/parsing.py:402
msgid "Wrap the bare text in a p tag"
msgstr "Obaliť holý text do značky p"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/parsing.py:403
msgid ""
"You cannot have bare text inside the body tag. The text must be placed "
"inside some other tag, such as p or div"
msgstr "V značke body nemôže byť holý text. Text musí byť umiestnený vnútri inej značky, ako napríklad p alebo div"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/check/parsing.py:407
msgid "Bare text in body tag"
msgstr "Holý text v značke body"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/container.py:1604
msgid ""
"This MOBI file does not contain a KF8 format book. KF8 is the new format "
"from Amazon. calibre can only edit MOBI files that contain KF8 books. Older "
"MOBI files without KF8 are not editable."
msgstr "Tento súbor MOBI neobsahuje knihu vo formáte KF8. KF8 je nový formát od Amazonu. calibre dokáže upraviť iba súbory MOBI obsahujúce knihy KF8. Staršie súbory MOBI bez KF8 nie sú upraviteľné."

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/container.py:1612
msgid ""
"This MOBI file contains both KF8 and older Mobi6 data. calibre can only edit"
" MOBI files that contain only KF8 data."
msgstr "Tento súbor MOBI obsahuje údaje KF8 aj staršie údaje Mobi6. calibre dokáže upraviť iba súbory MOBI obsahujúce iba údaje KF8."

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/cover.py:35
#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/cover.py:533
msgid "Cover inserted"
msgstr "Obal vložený"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/cover.py:35
#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/cover.py:533
msgid "Cover updated"
msgstr "Obal aktualizovný"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/css.py:266
#, python-brace-format
msgid "Removed one unused CSS style rule"
msgid_plural "Removed {} unused CSS style rules"
msgstr[0] "Odstránené jedno nepoužité pravidlo štýlu CSS"
msgstr[1] "Odstránené {} nepoužité pravidlá štýlu CSS"
msgstr[2] "Odstránených {} nepoužítých pravidiel štýlu CSS"
msgstr[3] "Odstránených {} nepoužítých pravidiel štýlu CSS"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/css.py:269
#, python-brace-format
msgid "Removed one unused CSS selector"
msgid_plural "Removed {} unused CSS selectors"
msgstr[0] "Odstránený jeden nevyužitý selektor CSS"
msgstr[1] "Odstránené {} nepoužité selektory CSS"
msgstr[2] "Odstránených {} nepoužitých selektorov CSS"
msgstr[3] "Odstránených {} nepoužitých selektorov CSS"

