msgstr "Neplatné heslo"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/server.py:556
msgid "Further &restrict access to books in this library that match:"
msgstr "Ďalej &obmedziť prístup ku knihám v tejto knižnici, ktoré zodpovedajú:"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/server.py:559
