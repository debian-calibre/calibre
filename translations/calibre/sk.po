#: /__w/calibre/calibre/src/calibre/utils/config_base.py:570
msgid "Path to the database in which books are stored"
msgstr "Cesta k databáze, v ktorej sú uložené knihy"

#: /__w/calibre/calibre/src/calibre/utils/config_base.py:575
msgid "Pattern to guess metadata from filenames"
msgstr "Šablóna na odvodenie metadát z názvov súborov"

#: /__w/calibre/calibre/src/calibre/utils/config_base.py:577
msgid "Access key for isbndb.com"
msgstr "Prístupový kľúč k isbndb.com"

#: /__w/calibre/calibre/src/calibre/utils/config_base.py:578
msgid "Default timeout for network operations (seconds)"
msgstr "Štandardný časový limit pre sieťové operácie (v sekundách)"

#: /__w/calibre/calibre/src/calibre/utils/config_base.py:579
msgid "Path to folder in which your library of books is stored"
msgstr "Cesta k priečinku, v ktorom je uložená vaša knižnica kníh"

#: /__w/calibre/calibre/src/calibre/utils/config_base.py:580
msgid "The language in which to display the user interface"
msgstr "Jazyk používateľského rozhrania"

#: /__w/calibre/calibre/src/calibre/utils/config_base.py:585
msgid ""
"The default output format for e-book conversions. When auto-converting to "
"send to a device this can be overridden by individual device preferences. "
"These can be changed by right clicking the device icon in calibre and "
"choosing \"Configure\"."
msgstr "Predvolený výstupný formát pre konverziu e-kníh. Pri automatickej konverzii na účely odoslania do zariadenia je možné toto nastavenie prepisovať pomocou individuálnych nastavení zariadenia. Tieto je možné zmeniť kliknutím pravým tlačidlom myši na ikonu zariadenia v calibre a výberom možnosti „Konfigurovať“."

#: /__w/calibre/calibre/src/calibre/utils/config_base.py:612
msgid "Ordered list of formats to prefer for input."
msgstr "Usporiadaný zoznam uprednostňovaných formátov pre vstup"

#: /__w/calibre/calibre/src/calibre/utils/config_base.py:614
msgid "Read metadata from files"
msgstr "Čítať metadáta zo súborov"

#: /__w/calibre/calibre/src/calibre/utils/config_base.py:619
msgid ""
"The priority of worker processes. A higher priority means they run faster "
"and consume more resources. Most tasks like conversion/news download/adding "
"books/etc. are affected by this setting."
msgstr "Priorita spracovania úlohy. Vyššia priorita znamená rýchlejší beh a väčšiu spotrebu zdrojov. Toto nastavenie ovplyvňuje väčšinu úloh, napr. konverzie/sťahovanie správ/pridávanie kníh/atď."

#: /__w/calibre/calibre/src/calibre/utils/config_base.py:625
msgid "Swap author first and last names when reading metadata"
msgstr "Vymeniť pri načítaní metadát krstné meno a priezvisko autora"

#: /__w/calibre/calibre/src/calibre/utils/config_base.py:626
msgid "Add new formats to existing book records"
msgstr "Pridať k existujúcim záznamom knihy nové formáty"

#: /__w/calibre/calibre/src/calibre/utils/config_base.py:627
msgid "Check for duplicates when copying to another library"
msgstr "Kontrolovať duplikáty pri kopírovaní do inej knižnice"

#: /__w/calibre/calibre/src/calibre/utils/config_base.py:629
msgid "Tags to apply to books added to the library"
msgstr "Značky pre knihy pridané do knižnice"

#: /__w/calibre/calibre/src/calibre/utils/config_base.py:633
msgid ""
"Make the tags to apply to books added to the library also apply when copying"
" books to another library"
msgstr "Spôsobí, že sa značky, ktoré sa majú priradiť ku knihám pridaným do knižnice, uplatnia aj pri kopírovaní kníh do inej knižnice"

#: /__w/calibre/calibre/src/calibre/utils/config_base.py:638
msgid ""
"Mark newly added books. The mark is a temporary mark that is automatically "
"removed when calibre is restarted."
msgstr "Označiť novo pridané knihy. Značka je dočasná a automaticky sa odstráni pri reštarte calibre."

#: /__w/calibre/calibre/src/calibre/utils/config_base.py:643
msgid "List of named saved searches"
msgstr "Zoznam pomenovaných uložených hľadaní"

#: /__w/calibre/calibre/src/calibre/utils/config_base.py:644
msgid "User-created Tag browser categories"
msgstr "Používateľom vytvorené kategórie prehliadača značiek"

#: /__w/calibre/calibre/src/calibre/utils/config_base.py:645
msgid "How and when calibre updates metadata on the device."
msgstr "Ako a kedy calibre aktualizuje metadáta v zariadení."

#: /__w/calibre/calibre/src/calibre/utils/config_base.py:650
msgid ""
"When searching for text without using lookup prefixes, as for example, Red "
"instead of title:Red, limit the columns searched to those named below."
msgstr "Obmedziť prehľadávané stĺpce pri hľadaní textu bez zadania vyhľadávacích prefixov (napr. Red namiesto title:Red) na nasledujúce."

#: /__w/calibre/calibre/src/calibre/utils/config_base.py:657
msgid ""
"Choose columns to be searched when not using prefixes, as for example, when "
"searching for Red instead of title:Red. Enter a list of search/lookup names "
"separated by commas. Only takes effect if you set the option to limit search"
" columns above."
msgstr "Vyberte polia, ktoré budú prehľadávané ak nebudú udané prefixy, napr. pri hľadaní Červený namiesto title:Červený. Zadajte zoznam názvov pre prehľadávanie oddelených čiarkami. Má význam ak zapnete voľbu Obmedziť prehľadávané metadáta vyššie."

#: /__w/calibre/calibre/src/calibre/utils/config_base.py:668
#, python-brace-format
msgid ""
"Characters typed in the search box will match their accented versions, based"
" on the language you have chosen for the calibre interface. For example, in "
"English, searching for n will match both {} and n, but if your language is "
"Spanish it will only match n. Note that this is much slower than a simple "
"search on very large libraries. Also, this option will have no effect if you"
" turn on case-sensitive searching."
msgstr "Znaky napísané do vyhľadávacieho poľa budú zodpovedať aj ich verziám s diakritikou, na základe jazyka, ktorý ste zvolili pre rozhranie calibre. Napríklad v angličtine bude vyhľadávanie n zodpovedať {} aj n, ale ak je vaším jazykom španielčina, bude zodpovedať iba n. Upozorňujeme, že toto je oveľa pomalšie ako jednoduché vyhľadávanie vo veľmi veľkých knižniciach. Táto voľba tiež nebude mať žiadny účinok, ak zapnete vyhľadávanie rozlišujúce veľkosť písmen."

#: /__w/calibre/calibre/src/calibre/utils/config_base.py:678
msgid "Make searches case-sensitive"
msgstr "Rozlišovať veľkosť písmen pri vyhľadávaní"

#: /__w/calibre/calibre/src/calibre/utils/config_base.py:683
msgid ""
"Recognize numbers inside text when sorting. Setting this means that when "
"sorting on text fields like title the text \"Book 2\"will sort before the "
"text \"Book 100\". Note that setting this can cause problems with text that "
"starts with numbers and is a little slower."
msgstr "Rozpoznávať čísla v texte pri zoraďovaní. Nastavenie tejto voľby znamená, že pri zoraďovaní podľa textových polí, ako je názov, sa text \"Kniha 2\" zoradí pred text \"Kniha 100\". Upozorňujeme, že nastavenie tejto voľby môže spôsobiť problémy s textom, ktorý začína číslami, a je o niečo pomalšie."

