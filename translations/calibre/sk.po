msgstr "&Spustiť server"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/server.py:361
msgid "St&op server"
msgstr "Zas&taviť server"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/server.py:362
msgid "&Test server"
msgstr "&Testovať server"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/server.py:363
msgid "Show server &logs"
msgstr "Zobraziť &záznamy servera"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/server.py:393
msgid "Do not start calibre automatically when computer is started"
msgstr "Nespúšťať calibre automaticky pri spustení počítača"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/server.py:393
msgid "Start calibre when the computer is started"
msgstr "Spustiť calibre pri spustení počítača"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/server.py:398
msgid ""
"Currently calibre is set to run automatically when the\n"
"            computer starts.  Use this button to disable that."
msgstr "calibre je momentálne nastavené na automatické spustenie pri\n            spustení počítača. Toto tlačidlo použite na zakázanie."

#: /__w/calibre/calibre/src/calibre/gui2/preferences/server.py:401
msgid ""
"Start calibre in the system tray automatically when the computer starts"
msgstr "Spustiť calibre v systémovej lište automaticky pri spustení počítača"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/server.py:418
#, python-format
