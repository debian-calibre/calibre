#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/main.py:55
#, python-format, python-brace-format
msgid ""
"<p><i>Polishing books</i> is all about putting the shine of perfection onto\n"
"your carefully crafted e-books.</p>\n"
"\n"
"<p>Polishing tries to minimize the changes to the internal code of your e-book.\n"
"Unlike conversion, it <i>does not</i> flatten CSS, rename files, change font\n"
"sizes, adjust margins, etc. Every action performs only the minimum set of\n"
"changes needed for the desired effect.</p>\n"
"\n"
"<p>You should use this tool as the last step in your e-book creation process.</p>\n"
"{0}\n"
"<p>Note that polishing only works on files in the %s formats.</p>"
msgstr "<p><i>Leštenie kníh</i> je o tom, ako dať lesk dokonalosti\nvašim starostlivo vytvoreným e-knihám.</p>\n\n<p>Leštenie sa snaží minimalizovať zmeny vo vnútornom kóde vašej e-knihy.\nNa rozdiel od konverzie <i>nemení</i> CSS, nepremenúva súbory, nemení veľkosti\npísma, neupravuje okraje atď. Každá akcia vykoná iba minimálnu sadu\nzmien potrebných na dosiahnutie požadovaného efektu.</p>\n\n<p>Tento nástroj by ste mali použiť ako posledný krok v procese vytvárania e-knihy.</p>\n{0}\n<p>Upozorňujeme, že leštenie funguje iba na súboroch vo formátoch %s.</p>"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/main.py:69
#: /__w/calibre/calibre/src/calibre/gui2/actions/polish.py:509
#: /__w/calibre/calibre/src/calibre/gui2/actions/toc_edit.py:98
#: /__w/calibre/calibre/src/calibre/gui2/actions/tweak_epub.py:105
#: /__w/calibre/calibre/src/calibre/gui2/viewer/search.py:632
#: /__w/calibre/calibre/src/calibre/gui2/viewer/ui.py:899
msgid " or "
msgstr " alebo "

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/main.py:70
msgid ""
"<p>Embed all fonts that are referenced in the document and are not already embedded.\n"
"This will scan your computer for the fonts, and if they are found, they will be\n"
"embedded into the document.</p>\n"
"<p>Please ensure that you have the proper license for embedding the fonts used in this document.</p>\n"
msgstr "<p>Vloží všetky písma, na ktoré sa v dokumente odkazuje a ktoré ešte nie sú vložené.\nToto prehľadá váš počítač na písma, a ak sa nájdu, vložia sa\ndo dokumentu.</p>\n<p>Uistite sa, že máte príslušnú licenciu na vloženie písiem použitých v tomto dokumente.</p>\n"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/main.py:76
msgid ""
"<p>Subsetting fonts means reducing an embedded font to contain\n"
"only the characters used from that font in the book. This\n"
"greatly reduces the size of the font files (halving the font\n"
"file sizes is common).</p>\n"
"\n"
"<p>For example, if the book uses a specific font for headers,\n"
"then subsetting will reduce that font to contain only the\n"
"characters present in the actual headers in the book. Or if the\n"
"book embeds the bold and italic versions of a font, but bold\n"
"and italic text is relatively rare, or absent altogether, then\n"
"the bold and italic fonts can either be reduced to only a few\n"
"characters or completely removed.</p>\n"
"\n"
"<p>The only downside to subsetting fonts is that if, at a later\n"
"date you decide to add more text to your books, the newly added\n"
"text might not be covered by the subset font.</p>\n"
msgstr "<p>Podmnožina písma znamená zredukovanie vloženého písma\niba na znaky z tohto písma použité v knihe. \nToto výrazne znižuje veľkosť súborov písma (polovičné písmo\nveľkosť súborov je bežná).</p>\n\n<p>Ak napríklad kniha používa konkrétne písmo pre hlavičky,\npotom podsúbor zredukuje písmo, ktoré bude obsahovať len\nznaky prítomné v aktuálnych hlavičkách knihy. Alebo ak\nkniha obsahuje tučné a kurzíva verzie písma, ale tučné\na text kurzívou sú relatívne vzácne, alebo úplne chýba\npotom tučné a kurzívne písma môžu byť zredukované iba na pár\nznakov alebo úplne odstránené.</p>\n\n<p>Jedinou nevýhodou pre podsúbor písma je, že ak sa neskôr\nrozhodnete pridať ďalší text do vašich kníh, novo pridaný \ntext nemusí byť pokrytý podmnožinou písma.</p>\n"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/main.py:94
msgid ""
"<p>Insert a \"book jacket\" page at the start of the book that contains\n"
"all the book metadata such as title, tags, authors, series, comments,\n"
"etc. Any previous book jacket will be replaced.</p>"
msgstr "<p>Vloží stránku \"obalu knihy\" na začiatok knihy, ktorá obsahuje\nvšetky metadáta knihy, ako názov, značky, autorov, sériu, komentáre\natď. Akýkoľvek predchádzajúci obal knihy sa nahradí.</p>"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/main.py:98
msgid "<p>Remove a previous inserted book jacket page.</p>\n"
msgstr "<p>Odstrániť predtým vloženú stranu obalu knihy.</p>\n"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/main.py:101
msgid ""
"<p>Convert plain text dashes, ellipsis, quotes, multiple hyphens, etc. into their\n"
"typographically correct equivalents.</p>\n"
"<p>Note that the algorithm can sometimes generate incorrect results, especially\n"
"when single quotes at the start of contractions are involved.</p>\n"
msgstr "<p>Konvertuje obyčajné textové pomlčky, výpustky, úvodzovky, viacnásobné spojovníky atď. na ich\ntypograficky správne ekvivalenty.</p>\n<p>Upozorňujeme, že algoritmus môže niekedy vygenerovať nesprávne výsledky, obzvlášť\nak ide o jednoduché úvodzovky na začiatku skratiek (kontrakcií).</p>\n"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/main.py:107
msgid ""
"<p>Remove all unused CSS rules from stylesheets and &lt;style&gt; tags. Some books\n"
"created from production templates can have a large number of extra CSS rules\n"
"that don't match any actual content. These extra rules can slow down readers\n"
"that need to parse them all.</p>\n"
msgstr "<p>Odstráni všetky nepoužité pravidlá CSS zo šablón štýlov a značiek &lt;style&gt;.\nNiektoré knihy vytvorené z produkčných šablón môžu mať veľký počet CSS pravidiel navyše,\nktoré nezodpovedajú žiadnemu skutočnému obsahu.\nTieto extra pravidlá môžu spomaľovať čítačky, ktoré ich musia všetky spracovať.</p>\n"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/main.py:113
msgid ""
"<p>Losslessly compress images in the book, to reduce the filesize, without\n"
"affecting image quality.</p>\n"
msgstr "<p>Bezstratovo komprimovať obrázky v knihe na zmenšenie veľkosti súboru bez\novplyvnenia kvality obrázka.</p>\n"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/main.py:117
msgid ""
"<p>Upgrade the internal structures of the book, if possible. For instance,\n"
"upgrades EPUB 2 books to EPUB 3 books.</p>\n"
msgstr "<p>Aktualizovať vnútorné štruktúry knihy, ak je to možné. Napríklad\naktualizuje knihy EPUB 2 na knihy EPUB 3.</p>\n"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/main.py:121
msgid ""
"<p>Add soft hyphens to all words in the book. This allows the book to be rendered\n"
"better when the text is justified, in readers that do not support hyphenation.</p>\n"
msgstr "<p>Pridať mäkké spojovníky do všetkých slov v knihe. Toto umožňuje lepšie\nvykreslenie knihy pri zarovnaní textu do bloku v čítačkách, ktoré nepodporujú delenie slov.</p>\n"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/main.py:125
msgid "<p>Remove soft hyphens from all text in the book.</p>\n"
msgstr "<p>Odstrániť mäkké spojovníky z celého textu v knihe.</p>\n"

#: /__w/calibre/calibre/src/calibre/ebooks/oeb/polish/main.py:128
msgid ""
"<p>Download external resources such as images, stylesheets, etc. that point to URLs instead of files in the book.\n"
"All such resources will be downloaded and added to the book so that the book no longer references any external resources.\n"
"</p>\n"
msgstr "<p>Stiahne externé zdroje, ako obrázky, štýly atď., ktoré ukazujú na URL adresy namiesto súborov v knihe.\nVšetky takéto zdroje sa stiahnu a pridajú do knihy, takže kniha už neodkazuje na žiadne externé zdroje.\n</p>\n"

