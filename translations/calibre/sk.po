#: /__w/calibre/calibre/src/calibre/library/catalogs/bibtex.py:24
msgid "BIBTEX catalog generator"
msgstr "Generátor katalógu BIBTEX"

#: /__w/calibre/calibre/src/calibre/library/catalogs/bibtex.py:37
#, python-format
msgid ""
"The fields to output when cataloging books in the database.  Should be a comma-separated list of fields.\n"
"Available fields: %(fields)s.\n"
"plus user-created custom fields.\n"
"Example: %(opt)s=title,authors,tags\n"
"Default: '%%default'\n"
"Applies to: BIBTEX output format"
msgstr "Zoznam vypisovaných polí oddelených čiarkou pri katalogizácii kníh v databáze. \nPoužiteľné polia: %(fields)s.\nplus užívateľom definované vlastné polia.\nPríklad: %(opt)s=title,authors,tags\nŠtandardne: '%%default'\nPlatí pre: výstupný formát BIBTEX"

#: /__w/calibre/calibre/src/calibre/library/catalogs/bibtex.py:53
#, python-format
msgid ""
"Output field to sort on.\n"
"Available fields: author_sort, id, rating, size, timestamp, title.\n"
"Default: '%default'\n"
"Applies to: BIBTEX output format"
msgstr "Výstupné polia, podľa ktorých triediť.\nPoužiteľné polia: author_sort, id, rating, size, timestamp, title.\nŠtandardne: '%default'\nPlatí pre: výstupný formát BIBTEX"

#: /__w/calibre/calibre/src/calibre/library/catalogs/bibtex.py:64
#, python-format
msgid ""
"Create a citation for BibTeX entries.\n"
"Boolean value: True, False\n"
"Default: '%default'\n"
"Applies to: BIBTEX output format"
msgstr "Vytvoriť citácie pre záznamy BibTeX.\nLogicné hodnota: Pravda, Nepravda\nŠtandardne: '%default'\nPlatí pre: výstupný formát BIBTEX"

#: /__w/calibre/calibre/src/calibre/library/catalogs/bibtex.py:72
#, python-format
msgid ""
"Create a file entry if formats is selected for BibTeX entries.\n"
"Boolean value: True, False\n"
"Default: '%default'\n"
"Applies to: BIBTEX output format"
msgstr "Vytvoriť položky súborov, sú pre BibTeX položky vybrané formáty.\nLogicné hodnota: Pravda, Nepravda\nŠtandardne: '%default'\nPlatí pre: výstupný formát BIBTEX"

#: /__w/calibre/calibre/src/calibre/library/catalogs/bibtex.py:84
#, python-format, python-brace-format
msgid ""
"The template for citation creation from database fields.\n"
"Should be a template with {} enclosed fields.\n"
"Available fields: %s.\n"
"Default: '%%default'\n"
"Applies to: BIBTEX output format"
msgstr "Šablóna pre vytvorenie citácií z databázových polí.\nMala by byť šablóna z poliami uzatvorenými v {}.\nPoužiteľné polia: %s.\nŠtadnardne: '%%default'\nPlatí pre: výstupný formát BIBTEX"

#: /__w/calibre/calibre/src/calibre/library/catalogs/bibtex.py:97
#, python-format
msgid ""
"BibTeX file encoding output.\n"
"Available types: utf8, cp1252, ascii.\n"
"Default: '%default'\n"
"Applies to: BIBTEX output format"
msgstr "Kódovanie výstupného súboru BibTeX.\nPoužiteľné typy: utf8, cp1252, ascii.\nŠtandardne: '%default'\nPlatí pre: výstupný formát BIBTEX"

#: /__w/calibre/calibre/src/calibre/library/catalogs/bibtex.py:105
#, python-format
msgid ""
"BibTeX file encoding flag.\n"
"Available types: strict, replace, ignore, backslashreplace.\n"
"Default: '%default'\n"
"Applies to: BIBTEX output format"
msgstr "Príznak kódovania súboru BibTeX.\nPoužiteľné typy: strict, replace, ignore, backslashreplace.\nŠtandardne: '%default'\nPlatí pre: výstupný formát BIBTEX"

#: /__w/calibre/calibre/src/calibre/library/catalogs/bibtex.py:116
#, python-format
msgid ""
"Entry type for BibTeX catalog.\n"
"Available types: book, misc, mixed.\n"
"Default: '%default'\n"
"Applies to: BIBTEX output format"
msgstr "Typ položky pre katalóg BibTeX.\nPoužiteľné typy: book, misc, mixed.\nŠtandardne: '%default'\nPlatí pre: výstupný formát BIBTEX"

#: /__w/calibre/calibre/src/calibre/library/catalogs/csv_xml.py:20
msgid "CSV/XML catalog generator"
msgstr "Generátor katalógu CSV/XML"

#: /__w/calibre/calibre/src/calibre/library/catalogs/csv_xml.py:33
#, python-format
msgid ""
"The fields to output when cataloging books in the database.  Should be a comma-separated list of fields.\n"
"Available fields: %(fields)s,\n"
"plus user-created custom fields.\n"
"Example: %(opt)s=title,authors,tags\n"
"Default: '%%default'\n"
"Applies to: CSV, XML output formats"
msgstr "Zoznam polí oddlelených čiarkou, ktoré treba vypísať pri katalogizovaní kníh v databáze. \nPoužiteľné polia: %(fields)s,\nplus užívateľom definované vlastné polia.\nPríklad: %(opt)s=title,authors,tags\nŠtandardne: '%%default'\nPlatí pre: výstupné formáty CSV a XML"

#: /__w/calibre/calibre/src/calibre/library/catalogs/csv_xml.py:49
#, python-format
msgid ""
"Output field to sort on.\n"
"Available fields: author_sort, id, rating, size, timestamp, title_sort\n"
"Default: '%default'\n"
"Applies to: CSV, XML output formats"
msgstr "Pole výstupu, podľa ktorého sa má triediť.\nPoužieľné polia: author_sort, id, rating, size, timestamp, title_sort\nŠtandardne: '%default'\nPlatí pre: výstupné formáty CSV a XML"

#: /__w/calibre/calibre/src/calibre/library/catalogs/epub_mobi.py:24
msgid "AZW3/EPUB/MOBI catalog generator"
msgstr "Generátor katalógu AZW3/EPUB/MOBI"

#: /__w/calibre/calibre/src/calibre/library/catalogs/epub_mobi.py:40
#, python-format
msgid ""
"Title of generated catalog used as title in metadata.\n"
"Default: '%default'\n"
"Applies to: AZW3, EPUB, MOBI output formats"
msgstr "Názov vygenerovaného katalógu použitý ako názov v metadátach.\nPredvolené: '%default'\nPlatí pre: výstupné formáty AZW3, EPUB, MOBI"

#: /__w/calibre/calibre/src/calibre/library/catalogs/epub_mobi.py:48
#, python-format
msgid ""
"Create cross-references in Authors section for books with multiple authors.\n"
"Default: '%default'\n"
"Applies to: AZW3, EPUB, MOBI output formats"
msgstr "Vytvoriť krížové odkazy v sekcii Autori pre knihy s viacerými autormi.\nPredvolené: '%default'\nPlatí pre: výstupné formáty AZW3, EPUB, MOBI"

#: /__w/calibre/calibre/src/calibre/library/catalogs/epub_mobi.py:57
#, python-format
msgid ""
"Save the output from different stages of the conversion pipeline to the specified folder. Useful if you are unsure at which stage of the conversion process a bug is occurring.\n"
"Default: '%default'\n"
"Applies to: AZW3, EPUB, MOBI output formats"
msgstr "Uloží výstup z rôznych fáz konverzného reťazca do zadaného priečinka. Užitočné, ak si nie ste istí, v ktorej fáze procesu konverzie sa vyskytuje chyba.\nPredvolené: '%default'\nPlatí pre: výstupné formáty AZW3, EPUB, MOBI"

#: /__w/calibre/calibre/src/calibre/library/catalogs/epub_mobi.py:71
#, python-format
msgid ""
"Regex describing tags to exclude as genres.\n"
"Default: '%default' excludes bracketed tags, e.g. '[Project Gutenberg]', and '+', the default tag for read books.\n"
"Applies to: AZW3, EPUB, MOBI output formats"
msgstr "Regulárny výraz opisujúci značky, ktoré sa majú vylúčiť ako žánre.\nPredvolené: '%default' vylučuje značky v zátvorkách, napr. '[Project Gutenberg]', a '+', predvolenú značku pre prečítané knihy.\nPlatí pre: výstupné formáty AZW3, EPUB, MOBI"

#: /__w/calibre/calibre/src/calibre/library/catalogs/epub_mobi.py:82
#, python-format
msgid ""
"Specifies the rules used to exclude books from the generated catalog.\n"
"The model for an exclusion rule is either\n"
"('<rule name>','Tags','<comma-separated list of tags>') or\n"
"('<rule name>','<custom column>','<pattern>').\n"
"For example:\n"
"(('Archived books','#status','Archived'),)\n"
"will exclude a book with a value of 'Archived' in the custom column 'status'.\n"
"When multiple rules are defined, all rules will be applied.\n"
"Default: \n"
"\"%default\"\n"
"Applies to: AZW3, EPUB, MOBI output formats"
msgstr "Určuje pravidlá používané na vylúčenie kníh z generovaného katalógu.\nModel pravidla vylúčenia je buď\n('<názov pravidla>','Značky','<zoznam značiek oddelených čiarkami>') alebo\n('<názov pravidla>','<vlastný stĺpec>','<vzor>').\nNapríklad:\n(('Archivované knihy','#status','Archivované'),)\nvylúči knihu s hodnotou 'Archivované' vo vlastnom stĺpci 'status'.\nAk je definovaných viac pravidiel, použijú sa všetky.\nPredvolené: \n\"%default\"\nPlatí pre: výstupné formáty AZW3, EPUB, MOBI"

#: /__w/calibre/calibre/src/calibre/library/catalogs/epub_mobi.py:98
#, python-format
msgid ""
"Include 'Authors' section in catalog.\n"
"Default: '%default'\n"
"Applies to: AZW3, EPUB, MOBI output formats"
msgstr "Zahrnúť sekciu 'Autori' do katalógu.\nPredvolené: '%default'\nPlatí pre: výstupné formáty AZW3, EPUB, MOBI"

#: /__w/calibre/calibre/src/calibre/library/catalogs/epub_mobi.py:105
#, python-format
msgid ""
"Include 'Descriptions' section in catalog.\n"
"Default: '%default'\n"
"Applies to: AZW3, EPUB, MOBI output formats"
msgstr "Zahrnúť sekciu 'Popisy' do katalógu.\nPredvolené: '%default'\nPlatí pre: výstupné formáty AZW3, EPUB, MOBI"

#: /__w/calibre/calibre/src/calibre/library/catalogs/epub_mobi.py:112
#, python-format
msgid ""
"Include 'Genres' section in catalog.\n"
"Default: '%default'\n"
"Applies to: AZW3, EPUB, MOBI output formats"
msgstr "Zahrnúť sekciu 'Žánre' do katalógu.\nPredvolené: '%default'\nPlatí pre: výstupné formáty AZW3, EPUB, MOBI"

#: /__w/calibre/calibre/src/calibre/library/catalogs/epub_mobi.py:119
#, python-format
msgid ""
"Include 'Titles' section in catalog.\n"
"Default: '%default'\n"
"Applies to: AZW3, EPUB, MOBI output formats"
msgstr "Zahrnúť sekciu 'Názvy' do katalógu.\nPredvolené: '%default'\nPlatí pre: výstupné formáty AZW3, EPUB, MOBI"

#: /__w/calibre/calibre/src/calibre/library/catalogs/epub_mobi.py:126
#, python-format
msgid ""
"Include 'Series' section in catalog.\n"
"Default: '%default'\n"
"Applies to: AZW3, EPUB, MOBI output formats"
msgstr "Zahrnúť sekciu 'Séria' do katalógu.\nPredvolené: '%default'\nPlatí pre: výstupné formáty AZW3, EPUB, MOBI"

#: /__w/calibre/calibre/src/calibre/library/catalogs/epub_mobi.py:133
#, python-format
msgid ""
"Include 'Recently Added' section in catalog.\n"
"Default: '%default'\n"
"Applies to: AZW3, EPUB, MOBI output formats"
msgstr "Zahrnúť sekciu 'Nedávno pridané' do katalógu.\nPredvolené: '%default'\nPlatí pre: výstupné formáty AZW3, EPUB, MOBI"

#: /__w/calibre/calibre/src/calibre/library/catalogs/epub_mobi.py:140
#, python-format
msgid ""
"Source field for 'Genres' section.\n"
"Default: '%default'\n"
"Applies to: AZW3, EPUB, MOBI output formats"
msgstr "Zdrojové pole pre sekciu 'Žánre'.\nPredvolené: '%default'\nPlatí pre: výstupné formáty AZW3, EPUB, MOBI"

#: /__w/calibre/calibre/src/calibre/library/catalogs/epub_mobi.py:147
#, python-format
msgid ""
"Custom field containing note text to insert in Description header.\n"
"Default: '%default'\n"
"Applies to: AZW3, EPUB, MOBI output formats"
msgstr "Vlastné pole obsahujúce text poznámky na vloženie do hlavičky popisu.\nPredvolené: '%default'\nPlatí pre: výstupné formáty AZW3, EPUB, MOBI"

#: /__w/calibre/calibre/src/calibre/library/catalogs/epub_mobi.py:155
#, python-format
msgid ""
"#<custom field>:[before|after]:[True|False] specifying:\n"
" <custom field> Custom field containing notes to merge with comments\n"
" [before|after] Placement of notes with respect to comments\n"
" [True|False] - A horizontal rule is inserted between notes and comments\n"
"Default: '%default'\n"
"Applies to: AZW3, EPUB, MOBI output formats"
msgstr "#<vlastné pole>:[before|after]:[True|False] určujúce:\n <vlastné pole> vlastné pole obsahujúce poznámky na zlúčenie s komentármi\n [before|after] umiestnenie poznámok vzhľadom na komentáre\n [True|False] - medzi poznámky a komentáre sa vloží vodorovná čiara\nPredvolené: '%default'\nPlatí pre: výstupné formáty AZW3, EPUB, MOBI"

#: /__w/calibre/calibre/src/calibre/library/catalogs/epub_mobi.py:169
#, python-format
msgid ""
"Specifies the output profile. In some cases, an output profile is required to optimize the catalog for the device. For example, 'kindle' or 'kindle_dx' creates a structured Table of Contents with Sections and Articles.\n"
"Default: '%default'\n"
"Applies to: AZW3, EPUB, MOBI output formats"
msgstr "Určuje výstupný profil. V niektorých prípadoch je výstupný profil potrebný na optimalizáciu katalógu pre zariadenie. Napríklad 'kindle' alebo 'kindle_dx' vytvorí štruktúrovaný obsah s časťami a článkami.\nPredvolené: '%default'\nPlatí pre: výstupné formáty AZW3, EPUB, MOBI"

#: /__w/calibre/calibre/src/calibre/library/catalogs/epub_mobi.py:182
#, python-format
msgid ""
"Specifies the rules used to include prefixes indicating read books, wishlist items and other user-specified prefixes.\n"
"The model for a prefix rule is ('<rule name>','<source field>','<pattern>','<prefix>').\n"
"When multiple rules are defined, the first matching rule will be used.\n"
"Default:\n"
"\"%default\"\n"
"Applies to: AZW3, EPUB, MOBI output formats"
msgstr "Určuje pravidlá používané na zahrnutie predpôn označujúcich prečítané knihy, položky zoznamu želaní a iné používateľom zadané predpony.\nModel pravidla predpony je ('<názov pravidla>','<zdrojové pole>','<vzor>','<predpona>').\nAk je definovaných viac pravidiel, použije sa prvé zodpovedajúce pravidlo.\nPredvolené:\n\"%default\"\nPlatí pre: výstupné formáty AZW3, EPUB, MOBI"

#: /__w/calibre/calibre/src/calibre/library/catalogs/epub_mobi.py:195
#, python-format
msgid ""
"Use a named preset created with the GUI catalog builder.\n"
"A preset specifies all settings for building a catalog.\n"
"Default: '%default'\n"
"Applies to: AZW3, EPUB, MOBI output formats"
msgstr "Použiť pomenovanú predvoľbu vytvorenú nástrojom na tvorbu katalógu GUI.\nPredvoľba určuje všetky nastavenia na vytvorenie katalógu.\nPredvolené: '%default'\nPlatí pre: výstupné formáty AZW3, EPUB, MOBI"

#: /__w/calibre/calibre/src/calibre/library/catalogs/epub_mobi.py:206
#, python-format
msgid ""
"Replace existing cover when generating the catalog.\n"
"Default: '%default'\n"
"Applies to: AZW3, EPUB, MOBI output formats"
msgstr "Nahradiť existujúcu obálku pri generovaní katalógu.\nPredvolené: '%default'\nPlatí pre: výstupné formáty AZW3, EPUB, MOBI"

#: /__w/calibre/calibre/src/calibre/library/catalogs/epub_mobi.py:213
#, python-format
msgid ""
"Size hint (in inches) for book covers in catalog.\n"
"Range: 1.0 - 2.0\n"
"Default: '%default'\n"
"Applies to: AZW3, EPUB, MOBI output formats"
msgstr "Odhad veľkosti (v palcoch) pre obálky kníh v katalógu.\nRozsah: 1.0 - 2.0\nPredvolené: '%default'\nPlatí pre: výstupné formáty AZW3, EPUB, MOBI"

