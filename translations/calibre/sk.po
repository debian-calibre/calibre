msgstr "Svet bez názvu"

#: /__w/calibre/calibre/src/calibre/gui2/cyoa/world.py:1076
msgid ""
"A world you created previously. Select it to play in it without re-"
"generating it."
msgstr "Svet, ktorý ste predtým vytvorili. Vyberte ho, ak v ňom chcete hrať bez jeho opätovného generovania."

#: /__w/calibre/calibre/src/calibre/gui2/cyoa/world.py:1093
