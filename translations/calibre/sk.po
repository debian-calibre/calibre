#: /__w/calibre/calibre/src/calibre/gui2/toc/main.py:1247
msgid "No items were found that could be added to the Table of Contents."
msgstr "Nenašli sa žiadne položky, ktoré by bolo možné pridať do obsahu."

#: /__w/calibre/calibre/src/calibre/gui2/toc/main.py:1260
msgid "No links were found that could be added to the Table of Contents."
