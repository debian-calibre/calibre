#: /__w/calibre/calibre/src/calibre/gui2/dialogs/metadata_bulk_ui.py:823
msgid "Test result"
msgstr "Výsledok testu"

#: /__w/calibre/calibre/src/calibre/gui2/dialogs/metadata_bulk_ui.py:824
