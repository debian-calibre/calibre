#: /__w/calibre/calibre/src/calibre/debug.py:34
#, python-brace-format
msgid ""
"{0}\n"
"\n"
"Various command line interfaces useful for debugging calibre. With no options,\n"
"this command starts an embedded Python interpreter. You can also run the main\n"
"calibre GUI, the calibre E-book viewer and the calibre editor in debug mode.\n"
"\n"
"It also contains interfaces to various bits of calibre that do not have\n"
"dedicated command line tools, such as font subsetting, the E-book diff tool and so\n"
"on.\n"
"\n"
"You can also use %prog to run standalone scripts. To do that use it like this:\n"
"\n"
"    {1}\n"
"\n"
"Everything after the -- is passed to the script. You can also use calibre-debug\n"
"as a shebang in scripts, like this:\n"
"\n"
"    {2}\n"
msgstr "{0}\n\nRôzne rozhrania príkazového riadka užitočné na ladenie calibre. Bez volieb\ntento príkaz spustí vstavaný interpreter Pythonu. Môžete tiež spustiť hlavné\nGUI calibre, prehliadač e-kníh calibre a editor calibre v režime ladenia.\n\nObsahuje aj rozhrania k rôznym častiam calibre, ktoré nemajú\nvyhradené nástroje príkazového riadka, ako je napríklad podmnožina písiem, nástroj na porovnávanie e-kníh a podobne.\n\nPomocou %prog môžete tiež spúšťať samostatné skripty. Použite to takto:\n\n    {1}\n\nVšetko za -- sa odovzdá skriptu. calibre-debug môžete použiť aj\nako shebang v skriptoch, takto:\n\n    {2}\n"

#: /__w/calibre/calibre/src/calibre/debug.py:54
msgid "%prog [options]"
msgstr "%prog [options]"

#: /__w/calibre/calibre/src/calibre/debug.py:59
msgid "Run Python code."
msgstr "Spustiť kód jazyka Python."

#: /__w/calibre/calibre/src/calibre/debug.py:60
msgid "Run the Python code in file."
msgstr "Spustiť kód jazyka Python v súbore."

#: /__w/calibre/calibre/src/calibre/debug.py:66
msgid ""
"Subset the specified font. Use -- after this option to pass option to the "
"font subsetting program."
msgstr "Redukovať zadané písmo. Použite -- po tejto voľbe pre predanie možnosti programu pre čiastočné vkladanie písma. "

#: /__w/calibre/calibre/src/calibre/debug.py:68
#: /__w/calibre/calibre/src/calibre/gui2/device.py:548
#: /__w/calibre/calibre/src/calibre/gui2/preferences/device_debug.py:21
msgid "Debug device detection"
msgstr "Analyzovať chyby pri identifikácii zariadenia"

#: /__w/calibre/calibre/src/calibre/debug.py:75
msgid ""
"Run the GUI with debugging enabled. Debug output is printed to stdout and "
"stderr. To pass command line arguments use -- followed by the arguments, for"
" example: calibre-debug -g -- /path/to/ebook"
msgstr "Spustí GUI s povoleným ladením. Ladiaci výstup sa vypisuje do stdout a stderr. Na odovzdanie argumentov príkazového riadka použite -- nasledované argumentmi, napríklad: calibre-debug -g -- /cesta/k/eknihe"

#: /__w/calibre/calibre/src/calibre/debug.py:84
msgid ""
"Run the GUI with a debug console, logging to the specified path. For "
"internal use only, use the -g option to run the GUI in debug mode"
msgstr "Spustiť diagnostiku grafického rozhrania v terminále a zaznamenať výsledky na určené miesto. Len pre interné účely použite možnosť -g, na diagnostiku grafického rozhrania."

#: /__w/calibre/calibre/src/calibre/debug.py:86
msgid "Don't run with the DEBUG flag set"
msgstr "Nespúšťať s nastaveným príznakom DEBUG"

#: /__w/calibre/calibre/src/calibre/debug.py:92
msgid ""
"Run the E-book viewer in debug mode. As with -g use -- to pass command line "
"arguments."
msgstr "Spustiť prehliadač e-kníh v ladiacom režime. Ako pri -g použite -- na odovzdanie argumentov príkazového riadka."

#: /__w/calibre/calibre/src/calibre/debug.py:98
msgid "Output the paths necessary to setup the calibre environment"
msgstr "Výstup ciest potrebných pre nastavenie prostredia calibre"

#: /__w/calibre/calibre/src/calibre/debug.py:103
msgid ""
"Add a simple plugin (i.e. a plugin that consists of only a .py file), by "
"specifying the path to the py file containing the plugin code."
msgstr "Vložiť jednoduchý doplnok (napr. doplnok obsahujúci len .py súbor) zadaním cesty ku súboru py, ktorý obsahuje kód doplnku."

#: /__w/calibre/calibre/src/calibre/debug.py:110
msgid "Inspect the MOBI file(s) at the specified path(s)"
msgstr "Skontrolovať súbor (súbory) MOBI zo zadanej cesty (zadaných ciest)"

#: /__w/calibre/calibre/src/calibre/debug.py:116
msgid ""
"Launch the calibre \"Edit book\" tool in debug mode. As with -g use -- to "
"pass command line arguments."
msgstr "Spustiť nástroj calibre \"Upraviť knihu\" v ladiacom režime. Ako pri -g použite -- na odovzdanie argumentov príkazového riadka."

#: /__w/calibre/calibre/src/calibre/debug.py:124
msgid ""
"Explode the book into the specified folder.\n"
"Usage: -x file.epub output_dir\n"
"Exports the book as a collection of HTML files and metadata, which you can edit using standard HTML editing tools. Works with EPUB, AZW3, HTMLZ and DOCX files."
msgstr "Rozbalí knihu do zadaného priečinka.\nPoužitie: -x súbor.epub výstupný_priečinok\nExportuje knihu ako súbor súborov HTML a metadát, ktoré môžete upravovať pomocou štandardných nástrojov na úpravu HTML. Funguje so súbormi EPUB, AZW3, HTMLZ a DOCX."

#: /__w/calibre/calibre/src/calibre/debug.py:137
msgid ""
"Implode a previously exploded book.\n"
"Usage: -i output_dir file.epub\n"
"Imports the book from the files in output_dir which must have been created by a previous call to --explode-book. Be sure to specify the same file type as was used when exploding."
msgstr "Zabalí predtým rozbalenú knihu.\nPoužitie: -i výstupný_priečinok súbor.epub\nImportuje knihu zo súborov vo výstupnom_priečinku, ktoré musia byť vytvorené predchádzajúcim volaním --explode-book. Nezabudnite zadať rovnaký typ súboru, aký sa použil pri rozbaľovaní."

#: /__w/calibre/calibre/src/calibre/debug.py:148
msgid ""
"Export all calibre data (books/settings/plugins). Normally, you will be asked for the export folder and the libraries to export. You can also specify them as command line arguments to skip the questions. Use absolute paths for the export folder and libraries. The special keyword \"all\" can be used to export all libraries. Examples:\n"
"\n"
"  calibre-debug --export-all-calibre-data  # for interactive use\n"
"  calibre-debug --export-all-calibre-data /path/to/empty/export/folder /path/to/library/folder1 /path/to/library2\n"
"  calibre-debug --export-all-calibre-data /export/folder all  # export all known libraries"
msgstr "Exportuje všetky údaje calibre (knihy/nastavenia/doplnky). Bežne sa vás opýta na exportný priečinok a knižnice na export. Môžete ich zadať aj ako argumenty príkazového riadka, aby ste sa otázkam vyhli. Pre exportný priečinok a knižnice použite absolútne cesty. Špeciálne kľúčové slovo „all“ sa dá použiť na export všetkých knižníc. Príklady:\n\n  calibre-debug --export-all-calibre-data  # pre interaktívne použitie\n  calibre-debug --export-all-calibre-data /cesta/k/prázdnemu/exportnému/priečinku /cesta/ku/knižnici/priecinok1 /cesta/ku/knižnici2\n  calibre-debug --export-all-calibre-data /export/priecinok all  # export všetkých známych knižníc"

#: /__w/calibre/calibre/src/calibre/debug.py:158
msgid "Import previously exported calibre data"
msgstr "Importovať predtým exportované dáta calibre"

#: /__w/calibre/calibre/src/calibre/debug.py:165
#: /__w/calibre/calibre/src/calibre/gui2/main.py:69
msgid ""
"Cause a running calibre instance, if any, to be shutdown. Note that if there"
" are running jobs, they will be silently aborted, so use with care."
msgstr "Spôsobí, že akákoľvek bežiaca inštancia bude ukončená. Uvedomte si, že ak sa práve spracúvajú úlohy, budú potichu prerušené, takže používajte opatrne."

#: /__w/calibre/calibre/src/calibre/debug.py:168
msgid "Test binary modules in build"
msgstr "Testovať binárne moduly v zostavovaní"

#: /__w/calibre/calibre/src/calibre/debug.py:173
msgid ""
"Run a plugin that provides a command line interface. For example:\n"
"calibre-debug -r \"Plugin name\" -- file1 --option1\n"
"Everything after the -- will be passed to the plugin as arguments."
msgstr "Spustí doplnok, ktorý poskytuje rozhranie príkazového riadka. Napríklad:\ncalibre-debug -r \"Názov doplnku\" -- súbor1 --volba1\nVšetko za -- sa odovzdá doplnku ako argumenty."

#: /__w/calibre/calibre/src/calibre/debug.py:182
msgid ""
"Run the named test(s). Use the special value \"all\" to run all tests. If "
"the test name starts with a period it is assumed to be a module name. If the"
" test name starts with @ it is assumed to be a category name."
msgstr "Spustí pomenované testy. Použite špeciálnu hodnotu „all“ na spustenie všetkých testov. Ak názov testu začína bodkou, predpokladá sa, že ide o názov modulu. Ak názov testu začína @, predpokladá sa, že ide o názov kategórie."

#: /__w/calibre/calibre/src/calibre/debug.py:191
msgid ""
"Run the calibre diff tool. For example:\n"
"calibre-debug --diff file1 file2"
msgstr "Spustiť rozdielový nástroj calibre. Napríklad:\ncalibre-debug --diff súbor1 súbor2"

#: /__w/calibre/calibre/src/calibre/debug.py:197
msgid "(Un)register calibre from Windows Default Programs."
msgstr "(Od)registrovať calibre vo východzích programoch Windows."

#: /__w/calibre/calibre/src/calibre/debug.py:203
msgid ""
"Convert the specified EPUB file to KEPUB without doing a full conversion. "
"This is what the Kobo driver does when sending files to the device."
msgstr "Konvertuje zadaný súbor EPUB na KEPUB bez vykonania úplnej konverzie. Presne to robí ovládač Kobo pri odosielaní súborov do zariadenia."

#: /__w/calibre/calibre/src/calibre/debug.py:210
msgid ""
"Convert the specified KEPUB file to EPUB without doing a full conversion. "
"This is what the Kobo driver does when importing files from the device."
msgstr "Konvertuje zadaný súbor KEPUB na EPUB bez vykonania úplnej konverzie. Presne to robí ovládač Kobo pri importe súborov zo zariadenia."

#: /__w/calibre/calibre/src/calibre/debug.py:218
msgid ""
"Clear the calibre cache folder and delete the downloaded Camoufox browser "
"and browserforge data, if any. A Camoufox browser provided by the system is "
"never deleted."
msgstr "Vymažte priečinok calibre cache a vymažte stiahnuté Camoufox prehliadače a dáta z Browserforge, ak nejaké sú. Prehliadač Camoufox poskytovaný systémom sa nikdy neodstraňuje."

