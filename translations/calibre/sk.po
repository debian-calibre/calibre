msgstr "Obsahový server počúva na: %s"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/server.py:430
msgid "Remember to create at least one user account in the \"User accounts\" tab"
msgstr "Nezabudnite vytvoriť aspoň jeden používateľský účet na karte \"Používateľské účty\""

#: /__w/calibre/calibre/src/calibre/gui2/preferences/server.py:433
msgid ""
"Requiring a username/password prevents unauthorized people from accessing "
"your calibre library. It is also needed for some features such as making any"
" changes to the library as well as last read position/annotation syncing."
msgstr "Vyžadovanie používateľského mena/hesla zabraňuje neoprávneným osobám v prístupe k vašej knižnici calibre. Je tiež potrebné pre niektoré funkcie, ako je vykonávanie akýchkoľvek zmien v knižnici, ako aj synchronizácia poslednej pozície čítania/anotácií."

#: /__w/calibre/calibre/src/calibre/gui2/preferences/server.py:456
msgid "Re&start server"
msgstr "&Reštartovať server"

