#, python-brace-format
msgid ""
"\n"
"Read/Write metadata from/to e-book files.\n"
"\n"
"Supported formats for reading metadata: {0}\n"
"\n"
"Supported formats for writing metadata: {1}\n"
"\n"
"Different file types support different kinds of metadata. If you try to set\n"
"some metadata on a file type that does not support it, the metadata will be\n"
"silently ignored.\n"
msgstr "\nČíta/zapisuje metadáta zo/do súborov e-kníh.\n\nPodporované formáty na čítanie metadát: {0}\n\nPodporované formáty na zápis metadát: {1}\n\nRôzne typy súborov podporujú rôzne druhy metadát. Ak sa pokúsite nastaviť\nnejaké metadáta na typ súboru, ktorý ich nepodporuje, metadáta sa\nbez upozornenia ignorujú.\n"

#: /__w/calibre/calibre/src/calibre/ebooks/metadata/cli.py:20
msgid "%prog ebook_file [options]\n"
msgstr "%prog súbor_eknihy [voľby]\n"

#: /__w/calibre/calibre/src/calibre/ebooks/metadata/cli.py:39
msgid ""
"Set the authors. Multiple authors should be separated by the & character. "
"Author names should be in the order Firstname Lastname."
msgstr "Nastaviť autorov. Viac autorov by mali byť oddelené & znakom. Mená autorov by mali byť v poradí Meno Priezvisko."

#: /__w/calibre/calibre/src/calibre/ebooks/metadata/cli.py:44
msgid ""
"The version of the title to be used for sorting. If unspecified, and the "
"title is specified, it will be auto-generated from the title."
msgstr "Verzia názvu vhodná pre triedenie. Ak nie je zadaná a názov je, bude z neho automaticky odvodená."

#: /__w/calibre/calibre/src/calibre/ebooks/metadata/cli.py:49
msgid ""
"String to be used when sorting by author. If unspecified, and the author(s) "
"are specified, it will be auto-generated from the author(s)."
msgstr "Reťazec, ktorý bude použitý pri triedení podľa autora. Ak je nešpecifikovaný, a autor (i) sú uvedení, bude auto-generovaný z autora (ov)."

#: /__w/calibre/calibre/src/calibre/ebooks/metadata/cli.py:51
msgid "Set the cover to the specified file."
msgstr "Nastavte obal na špecifikovaný súbor."

#: /__w/calibre/calibre/src/calibre/ebooks/metadata/cli.py:54
msgid "Set the book category."
msgstr "Nastaviť kategóriu knihy."

#: /__w/calibre/calibre/src/calibre/ebooks/metadata/cli.py:64
#, python-brace-format
msgid ""
"Set the identifiers for the book, can be specified multiple times. For "
"example: --identifier uri:{} --identifier isbn:12345 To remove an "
"identifier, specify no value, --identifier isbn: Note that for EPUB files, "
"an identifier marked as the package identifier cannot be removed."
msgstr "Nastaví identifikátory pre knihu, dá sa zadať viackrát. Napríklad: --identifier uri:{} --identifier isbn:12345 Na odstránenie identifikátora nezadajte hodnotu, --identifier isbn: Upozorňujeme, že pri súboroch EPUB sa identifikátor označený ako identifikátor balíka nedá odstrániť."

#: /__w/calibre/calibre/src/calibre/ebooks/metadata/cli.py:73
msgid "Set the published date."
msgstr "Nastaviť dátum publikovania"

#: /__w/calibre/calibre/src/calibre/ebooks/metadata/cli.py:75
msgid "Get the cover from the e-book and save it at as the specified file."
msgstr "Získať obálku z e-knihy a uložiť ju ako zadaný súbor."

#: /__w/calibre/calibre/src/calibre/ebooks/metadata/cli.py:80
msgid ""
"For formats like EPUB that use a \"default cover\" of the first page "
"rendered, disallow such default covers"
msgstr "Pre formáty ako EPUB, ktoré používajú \"predvolenú obálku\" prvej vykreslenej strany, zakázať takéto predvolené obálky"

#: /__w/calibre/calibre/src/calibre/ebooks/metadata/cli.py:83
msgid ""
"Specify the name of an OPF file. The metadata will be written to the OPF "
"file."
msgstr "Špecifikácia mena OPF súboru. Metadáta budú zapísané do OPF súboru."

#: /__w/calibre/calibre/src/calibre/ebooks/metadata/cli.py:88
