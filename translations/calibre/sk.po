msgid ""
"No matches for %(text)s found in the current file [%(current)s]. Do you want"
" to search in the %(which)s file [%(next)s]?"
msgstr "Nenašli sa žiadne zhody pre %(text)s v aktuálnom súbore [%(current)s]. Chcete hľadať v súbore %(which)s [%(next)s]?"

#: /__w/calibre/calibre/src/calibre/gui2/toc/location.py:393
