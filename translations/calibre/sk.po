#: /__w/calibre/calibre/src/calibre/gui2/css_transform_rules.py:44
#, python-brace-format
msgid "{preamble} {property} {match_type} {query}"
msgstr "{preamble} {property} {match_type} {query}"

#: /__w/calibre/calibre/src/calibre/gui2/css_transform_rules.py:50
msgid "If the &property:"
msgstr "Ak &vlastnosť:"

#: /__w/calibre/calibre/src/calibre/gui2/css_transform_rules.py:55
msgid ""
"The name of a CSS property, for example: font-size\n"
"Do not use shorthand properties, they will not work.\n"
"For instance use margin-top, not margin."
msgstr "Názov vlastnosti CSS, napríklad: font-size\nNepoužívajte skrátené vlastnosti, nebudú fungovať.\nNapríklad použite margin-top, nie margin."

