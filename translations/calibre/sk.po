msgid "<b>{} is allowed access to all libraries"
msgstr "<b>{} má povolený prístup ku všetkým knižniciam"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/server.py:708
#, python-brace-format
msgid ""
"{} is allowed access only to the libraries whose names <b>match</b> one of "
