msgstr "Všetky okrem zadaných knižníc"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/server.py:606
msgid "All libraries"
msgstr "Všetky knižnice"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/server.py:606
