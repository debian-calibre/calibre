#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/bookshelf_view.py:138
msgid "Rounded corners"
msgstr "Zaoblené rohy"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/bookshelf_view.py:139
msgid "Gravestone"
msgstr "Náhrobný kameň"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/bookshelf_view.py:140
msgid "Hidden"
msgstr "Skryté"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/bookshelf_view.py:149
msgid "Full"
msgstr "Celá"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/bookshelf_view.py:150
msgid "Cropped"
msgstr "Orezané"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/bookshelf_view.py:151
msgid "Edge"
msgstr "Okraj"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/bookshelf_view.py:156
msgid ""
"<p><i>Full</i> - shows the full cover on the spine.\n"
"<p><i>Cropped</i> - shows only as much of the cover as will fit on the spine.\n"
"<p><i>Edge</i> - same as <i>Cropped</i> except only part of the spine is covered, the rest is a solid color.\n"
"<p><i>Disable</i> - The spine will be only the dominant color from the cover."
msgstr "<p><i>Celá</i> – zobrazí celú obálku na chrbte.\n<p><i>Orezaná</i> – zobrazí len toľko obálky, koľko sa zmestí na chrbát.\n<p><i>Okraj</i> – rovnaké ako <i>Orezaná</i>, ale pokrytá je len časť chrbta, zvyšok je jednofarebný.\n<p><i>Vypnuté</i> – chrbát bude len dominantnou farbou z obálky."

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/bookshelf_view.py:167
msgid "Shift books on the shelf to make room"
msgstr "Posunúť knihy na poličke, aby sa uvoľnilo miesto"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/bookshelf_view.py:168
msgid "Above other books on the shelf"
msgstr "Nad ostatnými knihami na poličke"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/bookshelf_view.py:181
msgid "Inherit global setting"
msgstr "Zdediť globálne nastavenie"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/bookshelf_view.py:196
#, python-brace-format
msgid ""
"\n"
"<p>The template used to calculate a width for the displayed spine.\n"
"The template must evaluate to a decimal number between 0.0 and 1.0, which will be used to set the width of the books spine.\n"
"An empty template means a fixed spine size for all books.\n"
"<p>The special template {2} calculates the number of pages in the book and uses that. Note that\n"
"the page size calculation happens in the background, so until the count is completed, the\n"
"book size is used as a proxy.\n"
"<p>The special template {0} uses the book size to estimate a spine size.\n"
"The special template {1} uses a random size.\n"
"You can also use a number between 0.0 and 1.0 to pick a fixed size.\n"
"<p>Note that this setting is per-library, which means that you have to set it again for every\n"
"different calibre library you use."
msgstr "\n<p>Šablóna používaná na výpočet šírky zobrazeného chrbta.\nŠablóna sa musí vyhodnotiť na desatinné číslo medzi 0,0 a 1,0, ktoré sa použije na nastavenie šírky chrbta knihy.\nPrázdna šablóna znamená pevnú veľkosť chrbta pre všetky knihy.\n<p>Špeciálna šablóna {2} vypočíta počet strán knihy a použije ho. Upozorňujeme, že\nvýpočet veľkosti strán prebieha na pozadí, takže kým sa počítanie nedokončí, ako\nnáhrada sa používa veľkosť knihy.\n<p>Špeciálna šablóna {0} používa veľkosť knihy na odhad veľkosti chrbta.\nŠpeciálna šablóna {1} používa náhodnú veľkosť.\nMôžete tiež použiť číslo medzi 0,0 a 1,0 na výber pevnej veľkosti.\n<p>Toto nastavenie je platné pre jednotlivú knižnicu, čo znamená, že ho musíte znova nastaviť pre každú\nďalšiu knižnicu calibre, ktorú používate."

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/bookshelf_view.py:210
msgid "Edit template for title"
msgstr "Upraviť šablónu pre názov"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/bookshelf_view.py:211
msgid "Edit template for author"
msgstr "Upraviť šablónu pre autora"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/bookshelf_view.py:212
msgid "Edit template for book size"
msgstr "Upraviť šablónu pre veľkosť knihy"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/bookshelf_view.py:283
msgid ""
"This will cause calibre to rescan all books in your library and update page "
"counts and stored file sizes, where changed. The scanning happens in the "
"background and can take up to an hour per thousand books depending on the "
"size of the books and the power of your computer. This is typically never "
"needed and is present mainly to aid debugging and testing. Are you sure?"
msgstr "Toto spôsobí, že calibre znova prehľadá všetky knihy vo vašej knižnici a aktualizuje počty strán a uložené veľkosti súborov tam, kde sa zmenili. Prehľadávanie prebieha na pozadí a môže trvať až hodinu na tisíc kníh, v závislosti od veľkosti kníh a výkonu vášho počítača. Toto sa zvyčajne nikdy nevyžaduje a slúži hlavne na pomoc pri ladení a testovaní. Naozaj chcete pokračovať?"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/bookshelf_view.py:290
msgid "Re-count &unchanged as well"
msgstr "Znova spočítať aj &nezmenené"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/bookshelf_view.py:307
#, python-brace-format
msgid "pending recount: {}"
msgstr "čaká na prepočítanie: {}"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/bookshelf_view.py:334
msgid "Choose a column for pages"
msgstr "Zvoľte stĺpec pre stránky"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/bookshelf_view.py:335
msgid ""
"Choose a column from which to get the page count for the book, such as "
"generated by the Count Pages plugin"
msgstr "Vyberte stĺpec, z ktorého sa má získať počet strán knihy, napríklad generovaný zásuvným modulom Count Pages"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/bookshelf_view.py:347
msgid "Text on &light spine background"
msgstr "Text na &svetlom pozadí chrbta"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/bookshelf_view.py:348
msgid "Text on &dark spine background"
msgstr "Text na &tmavom pozadí chrbta"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/bookshelf_view.py:349
msgid "&Outline on light spine background"
msgstr "&Obrys na svetlom pozadí chrbta"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/bookshelf_view.py:350
msgid "Outli&ne on dark spine background"
msgstr "Obr&ys na tmavom pozadí chrbta"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/bookshelf_view.py:351
msgid "Divider &background"
msgstr "&Pozadie oddeľovača"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/bookshelf_view.py:352
msgid "&Line on the divider"
msgstr "&Čiara na oddeľovači"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/bookshelf_view.py:353
msgid "Text on the &divider"
msgstr "Text na &oddeľovači"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/bookshelf_view.py:354
msgid "The &current book highlight"
msgstr "&Zvýraznenie aktuálnej knihy"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/bookshelf_view.py:355
msgid "The &selected books highlight"
msgstr "&Zvýraznenie vybraných kníh"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/bookshelf_view.py:356
msgid "&The current and selected book highlight"
msgstr "&Zvýraznenie aktuálnej a vybranej knihy"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/bookshelf_view_ui.py:306
msgid "Shelf &height:"
msgstr "&Výška police:"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/bookshelf_view_ui.py:307
msgid ""
"Control the height of the book shelves, in pixels. The default is to choose "
"a height automatically based on the size of the screen. Note that if you "
"change the height, the cover thumbnail cache will need to be re-populated so"
" scrolling might be a little slow to start with."
msgstr "Ovládajte výšku knižných políc v pixeloch. Predvolene sa výška volí automaticky podľa veľkosti obrazovky. Upozorňujeme, že ak zmeníte výšku, bude potrebné znova naplniť vyrovnávaciu pamäť miniatúr obálok, takže posúvanie môže byť spočiatku o niečo pomalšie."

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/bookshelf_view_ui.py:310
msgid "Book &height variation:"
msgstr "&Variácia výšky knihy:"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/bookshelf_view_ui.py:311
msgid ""
"Control how the height of book spines varies on the shelf. \"Constant\" "
"makes all books the same height. \"Constant per group\" makes all books in "
"the same group the same height. \"Variable\" gives each book a unique "
"height."
msgstr "Ovládajte, ako sa mení výška chrbtov kníh na polici. „Konštantná“ nastaví rovnakú výšku všetkým knihám. „Konštantná v rámci skupiny“ nastaví rovnakú výšku všetkým knihám v rovnakej skupine. „Premenlivá“ dá každej knihe jedinečnú výšku."

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/bookshelf_view_ui.py:312
msgid "Duration of hover &animation:"
msgstr "Trvanie &animácie pri prejdení myšou:"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/bookshelf_view_ui.py:314
msgid " milliseconds"
msgstr " milisekúnd"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/bookshelf_view_ui.py:315
msgid "&Expand the hovered cover:"
msgstr "&Zväčšiť obálku pod kurzorom:"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/bookshelf_view_ui.py:316
msgid "Control what happens when the mouse hovers over the spine of a book."
msgstr "Ovládať, čo sa stane, keď myš prejde nad chrbtom knihy."

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/bookshelf_view_ui.py:317
msgid "Show &shadow for hovered cover"
msgstr "Zobraziť &tieň pre obálku pod kurzorom"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/bookshelf_view_ui.py:318
msgid "Group divider &style:"
msgstr "&Štýl oddeľovača skupín:"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/bookshelf_view_ui.py:319
msgid "Control the style to use for the group divider"
msgstr "Ovládať štýl, ktorý sa má použiť pre oddeľovač skupín"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/bookshelf_view_ui.py:320
msgid ""
"Control whether the text of the group divider is aligned to the right or "
"left"
msgstr "Ovládať, či je text oddeľovača skupín zarovnaný vpravo alebo vľavo"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/bookshelf_view_ui.py:321
msgid "Text &aligned to the right"
msgstr "Text &zarovnaný vpravo"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/bookshelf_view_ui.py:322
msgid ""
"When grouping books and a group extends to more than one shelf, place a "
"group divider at the beginning of the additional shelves"
msgstr "Pri zoskupovaní kníh, kde sa skupina rozprestiera na viac ako jednu policu, umiestniť oddeľovač skupiny na začiatok ďalších políc"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/bookshelf_view_ui.py:323
msgid "&Start shelves with divider"
msgstr "&Začínať police oddeľovačom"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/bookshelf_view_ui.py:324
msgid "Have calibre re-count the pages in all books in the current library."
msgstr "Nechať calibre znova spočítať strany vo všetkých knihách v aktuálnej knižnici."

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/bookshelf_view_ui.py:325
msgid "&Recount pages"
msgstr "&Znova spočítať strany"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/bookshelf_view_ui.py:326
msgid "Show count &failure log"
msgstr "Zobraziť &záznam chýb počtu"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/bookshelf_view_ui.py:327
msgid "Book spine"
msgstr "Chrbát knihy"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/bookshelf_view_ui.py:328
msgid "Show &cover:"
msgstr "Zobraziť &obálku:"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/bookshelf_view_ui.py:329
msgid "&Opacity:"
msgstr "&Nepriehľadnosť:"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/bookshelf_view_ui.py:330
msgid ""
"<p>How much to blend the cover into the spine. Higher values decrease "
"blending."
msgstr "<p>Do akej miery sa obálka prelína s chrbtom. Vyššie hodnoty znižujú prelínanie."

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/bookshelf_view_ui.py:332
msgid "Template for &first line:"
msgstr "Šablóna pre &prvý riadok:"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/bookshelf_view_ui.py:333
msgid ""
"<p>The template used to generate the main text on the spine. This template uses the same syntax as save templates. Defaults to just the book title. Note that this setting is per-library, which means that you have to set it again for every different calibre library you use.\n"
"<p>For example, if you want the first line to be the book title in upper case, you can use the template: <code>{title:uppercase()}</code>"
msgstr "<p>Šablóna používaná na vygenerovanie hlavného textu na chrbte. Táto šablóna používa rovnakú syntax ako ukladacie šablóny. Predvolene sa použije len názov knihy. Toto nastavenie je platné pre jednotlivú knižnicu, čo znamená, že ho musíte znova nastaviť pre každú ďalšiu knižnicu calibre, ktorú používate.\n<p>Ak chcete napríklad, aby bol prvý riadok názvom knihy veľkými písmenami, môžete použiť šablónu: <code>{title:uppercase()}</code>"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/bookshelf_view_ui.py:335
#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/bookshelf_view_ui.py:338
#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/bookshelf_view_ui.py:340
#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/cover_view_ui.py:101
#: /__w/calibre/calibre/src/calibre/gui2/preferences/save_template_ui.py:56
msgid "Template &editor"
msgstr "Editor &šablón"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/bookshelf_view_ui.py:336
msgid "Template for &second line:"
msgstr "Šablóna pre &druhý riadok:"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/bookshelf_view_ui.py:337
#, python-brace-format
msgid ""
"<p>The template used to generate an optional second line of text on the "
"spine. This template uses the same syntax as save templates. Defaults to no "
"second line. For example, use the value {authors} to show the book authors. "
"Note that this setting is per-library, which means that you have to set it "
"again for every different calibre library you use.</p>"
msgstr "<p>Šablóna používaná na vygenerovanie voliteľného druhého riadku textu na chrbte. Táto šablóna používa rovnakú syntax ako ukladacie šablóny. Predvolene sa druhý riadok nezobrazuje. Napríklad použitím hodnoty {authors} zobrazíte autorov knihy. Toto nastavenie je platné pre jednotlivú knižnicu, čo znamená, že ho musíte znova nastaviť pre každú ďalšiu knižnicu calibre, ktorú používate.</p>"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/bookshelf_view_ui.py:339
msgid "Template for &width:"
msgstr "Šablóna pre &šírku:"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/bookshelf_view_ui.py:341
msgid "Use a custom &pages column"
msgstr "Použiť vlastný stĺpec &strán"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/bookshelf_view_ui.py:343
msgid "&Font size:"
msgstr "&Veľkosť písma:"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/bookshelf_view_ui.py:344
msgid "&Minimum:"
msgstr "&Minimum:"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/bookshelf_view_ui.py:345
msgid ""
"The minimum font size for text on the spine. It is a fraction of the base "
"font size."
msgstr "Minimálna veľkosť písma pre text na chrbte. Je to zlomok základnej veľkosti písma."

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/bookshelf_view_ui.py:346
msgid "Ma&ximum:"
msgstr "&Maximum:"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/bookshelf_view_ui.py:347
msgid ""
"The maximum font size for text on the spine. It is a multiple of the base "
"font size."
msgstr "Maximálna veľkosť písma pre text na chrbte. Je to násobok základnej veľkosti písma."

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/bookshelf_view_ui.py:348
msgid "&Outline"
msgstr "&Obrys"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/bookshelf_view_ui.py:349
msgid ""
"<p>Set the thickness, in pixels, of the outline (border) around text on the "
"spine. A value of zero means no outline. An outline helps the text standout "
"against the spine, especially when the spine has a colorful cover."
msgstr "<p>Nastavte hrúbku obrysu (orámovania) okolo textu na chrbte, v pixeloch. Nulová hodnota znamená bez obrysu. Obrys pomáha textu vyniknúť na chrbte, obzvlášť keď má chrbát farebnú obálku."

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/bookshelf_view_ui.py:352
msgid ""
"Control whether the text shown on book spines goes upwards or downwards"
msgstr "Ovládať, či text zobrazený na chrbtoch kníh smeruje nahor alebo nadol"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/bookshelf_view_ui.py:353
msgid "Spine text &downwards"
msgstr "Text chrbta &nadol"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/bookshelf_view_ui.py:354
msgid ""
"<p>When showing a second line in the spine, for very narrow books, "
"artificially widen the book to make space for the second line. Without this,"
" the second line will not be displayed for narrow books, with it, narrow "
"books will appear artificially wider than they really are."
msgstr "<p>Pri zobrazovaní druhého riadku na chrbte pre veľmi úzke knihy umelo rozšíri knihu, aby vznikol priestor pre druhý riadok. Bez tejto voľby sa druhý riadok pri úzkych knihách nezobrazí, s touto voľbou budú úzke knihy vyzerať umelo širšie, ako v skutočnosti sú."

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/bookshelf_view_ui.py:355
msgid "Make &space for second line"
msgstr "Vytvoriť &priestor pre druhý riadok"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/bookshelf_view_ui.py:356
msgid "Use default font"
msgstr "Použiť predvolené písmo"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/bookshelf_view_ui.py:358
msgid "Restore &default"
msgstr "Obnoviť &predvolené"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/bookshelf_view_ui.py:360
msgid "&Dark/light:"
msgstr "&Tmavé/svetlé:"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/bookshelf_view_ui.py:361
msgid "Control the color theme to use for the bookshelf view"
msgstr "Ovládať farebnú tému pre zobrazenie poličky"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/bookshelf_view_ui.py:362
msgid "Use a custom background, either color or image"
msgstr "Použiť vlastné pozadie, buď farbu alebo obrázok"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/bookshelf_view_ui.py:363
msgid "Use a custom &background"
msgstr "Použiť vlastné &pozadie"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/bookshelf_view_ui.py:364
msgid "Use customs &colors"
msgstr "Použiť vlastné &farby"

