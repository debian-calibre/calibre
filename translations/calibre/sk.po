msgstr "Umiestnenie, na ktoré táto položka odkazuje, neexistuje:\n%s"

#: /__w/calibre/calibre/src/calibre/gui2/toc/main.py:1246
#: /__w/calibre/calibre/src/calibre/gui2/toc/main.py:1259
#: /__w/calibre/calibre/src/calibre/gui2/toc/main.py:1270
msgid "No items found"
