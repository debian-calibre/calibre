msgid "&Replace with:"
msgstr "&Nahradiť za:"

#: /__w/calibre/calibre/src/calibre/gui2/dialogs/metadata_bulk_ui.py:800
msgid ""
"The replacement text. The matched search text will be replaced with this "
"string"
msgstr "Nahradzovaný text. Týmto bude nahradený text vyhovujúci hľadanému"

#: /__w/calibre/calibre/src/calibre/gui2/dialogs/metadata_bulk_ui.py:801
msgid "&Apply function after replace:"
msgstr "Použiť po n&ahradení funkciu:"

#: /__w/calibre/calibre/src/calibre/gui2/dialogs/metadata_bulk_ui.py:802
msgid ""
"Specify how the text is to be processed after matching and replacement. In character mode, the entire\n"
"field is processed. In regular expression mode, only the matched text is processed"
msgstr "Zvoľte ako sa bude po nájdení a náhrade text spracovávať. V znakovom režime sa spracuje celé pole.\nV režime regulárnych výrazov sa spracuje len vyhovujúca časť textu."

#: /__w/calibre/calibre/src/calibre/gui2/dialogs/metadata_bulk_ui.py:804
msgid "&Destination field:"
msgstr "&Cieľové pole:"

#: /__w/calibre/calibre/src/calibre/gui2/dialogs/metadata_bulk_ui.py:805
msgid ""
"The field that the text will be put into after all replacements.\n"
"If blank, the source field is used if the field is modifiable"
msgstr "Pole, do ktorého sa bude vkladať text po všetkých nahradeniach.\nAk nezadáte, použije sa zdrojové pole - ak je upravovateľné"

#: /__w/calibre/calibre/src/calibre/gui2/dialogs/metadata_bulk_ui.py:807
msgid "M&ode:"
msgstr "&Režim:"

#: /__w/calibre/calibre/src/calibre/gui2/dialogs/metadata_bulk_ui.py:808
msgid "Specify how the text should be copied into the destination."
msgstr "Zvoľte spôsob kopírovania textu do cieľa."

