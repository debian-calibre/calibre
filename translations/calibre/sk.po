msgid ""
"Enter a template to generate collections. The result of the template will be"
" combined with the values from Collections column. The template should "
"return a list of collection names separated by ':@:' (without quotes)."
msgstr "Zadajte šablónu na generovanie kolekcií. Výsledok šablóny sa skombinuje s hodnotami zo stĺpca Kolekcie. Šablóna by mala vrátiť zoznam názvov kolekcií oddelených znakom „:@:“ (bez úvodzoviek)."

#: /__w/calibre/calibre/src/calibre/devices/kobo/kobotouch_config.py:579
msgid "Create collections"
msgstr "Vytvoriť zbierky"

#: /__w/calibre/calibre/src/calibre/devices/kobo/kobotouch_config.py:584
msgid "Delete empty collections"
msgstr "Odstrániť prázdne kolekcie"

#: /__w/calibre/calibre/src/calibre/devices/kobo/kobotouch_config.py:585
msgid ""
"Delete any empty collections from the Kobo when syncing is finished. This is"
" only for firmware V2.0.0 or later."
msgstr "Po dokončení synchronizácie odstráňte z čítačky Kobo všetky prázdne zbierky. Toto platí len pre verziu firmvéru V2.0.0 alebo novšiu."

#: /__w/calibre/calibre/src/calibre/devices/kobo/kobotouch_config.py:589
msgid "Ignore collections:"
msgstr "Ignorovať zbierky:"

#: /__w/calibre/calibre/src/calibre/devices/kobo/kobotouch_config.py:594
msgid ""
"List the names of collections to be ignored by the collection management. "
"The collections listed will not be changed. Names are separated by commas."
msgstr "Urobte zoznam názvov zbierok, ktoré majú byť správcom zbierok ignorované. Zbierky zo zoznamu nebudú zmenené. Názvy sú oddelené čiarkami."

#: /__w/calibre/calibre/src/calibre/devices/kobo/kobotouch_config.py:639
msgid "Kobo configuration: Invalid collection column names"
msgstr "Nastavenie Kobo: Neplatné názvy stĺpcov zbierky"

#: /__w/calibre/calibre/src/calibre/devices/kobo/kobotouch_config.py:640
#, python-brace-format
msgid "Collection column names that don't exist in the library: {0}"
msgstr "Názvy stĺpcov kolekcií, ktoré v knižnici neexistujú: {0}"

#: /__w/calibre/calibre/src/calibre/devices/kobo/kobotouch_config.py:688
msgid "Upload covers"
msgstr "Uploadovať obálky"

#: /__w/calibre/calibre/src/calibre/devices/kobo/kobotouch_config.py:696
msgid ""
"Upload cover images from the calibre library when sending books to the "
"device."
msgstr "Uploadovať obrázky obálok z knižnice calibre pri odosielaní kníh do zariadenia."

#: /__w/calibre/calibre/src/calibre/devices/kobo/kobotouch_config.py:700
msgid "Convert covers to grayscale when uploading."
msgstr "Konvertovať obaly do čierno-bielej pri nahrávaní."

#: /__w/calibre/calibre/src/calibre/devices/kobo/kobotouch_config.py:705
msgid "Upload dithered covers"
msgstr "Nahrať obaly s ditheringom"

#: /__w/calibre/calibre/src/calibre/devices/kobo/kobotouch_config.py:707
msgid ""
"Dither cover images to the appropriate 16c grayscale palette for an eInk "
"screen. This usually ensures greater accuracy and avoids banding, making "
"sleep covers look better. On FW >= 4.11, Nickel itself may sometimes do a "
"decent job of it. Has no effect without \"Upload black and white covers\"!"
msgstr "Obrázky obalov je potrebné previesť do zodpovedajúcej palety 16 odtieňov šedej pre eInk displej. To zvyčajne zabezpečí väčšiu presnosť a zabraňuje vzniku pruhov, vďaka čomu obaly vyzerajú lepšie. Vo verzii firmvéru 4.11 a vyššej to niekedy dokáže celkom dobre zvládnuť samotný program Nickel. Bez nastavenia „Nahrať čierno-biele obaly“ to nemá žiadny účinok!"

#: /__w/calibre/calibre/src/calibre/devices/kobo/kobotouch_config.py:721
msgid "Keep cover aspect ratio"
msgstr "Zachovať pomer strán obálky"

#: /__w/calibre/calibre/src/calibre/devices/kobo/kobotouch_config.py:722
msgid ""
"When uploading covers, do not change the aspect ratio when resizing for the "
"device. This is for firmware versions 2.3.1 and later."
msgstr "Pri uploadovaní obálok nemeniť pomer strán pri zmene veľkostí pre zariadenie. Toto je pre firmware verzie 2.3.1 a novší."

#: /__w/calibre/calibre/src/calibre/devices/kobo/kobotouch_config.py:727
msgid "Letterbox full-screen covers"
msgstr "Obálky na celú obrazovku s okrajmi"

#: /__w/calibre/calibre/src/calibre/devices/kobo/kobotouch_config.py:729
msgid ""
"Do it on our end, instead of letting Nickel handle it. Provides pixel-"
"perfect results on devices where Nickel does not do extra processing. "
"Obviously has no effect without \"Keep cover aspect ratio\". This is "
"probably undesirable if you disable the \"Show book covers full screen\" "
"setting on your device."
msgstr "Vykonať to na našej strane namiesto toho, aby to spracoval Nickel. Poskytuje bezchybné výsledky na zariadeniach, kde Nickel nevykonáva dodatočné spracovanie. Bez „Zachovať pomer strán obálky“ to samozrejme nemá žiadny efekt. Toto je pravdepodobne nežiaduce, ak máte na zariadení vypnuté nastavenie „Zobraziť obálky kníh na celú obrazovku“."

#: /__w/calibre/calibre/src/calibre/devices/kobo/kobotouch_config.py:739
msgid ""
"Choose the color to use when letterboxing the cover. The default color is "
"black (#000000)"
msgstr "Vyberte farbu, ktorá sa použije pri letterboxingu obalu. Predvolená farba je čierna (#000000)"

#: /__w/calibre/calibre/src/calibre/devices/kobo/kobotouch_config.py:750
msgid "Save covers as PNG"
msgstr "Uložiť obaly ako PNG"

#: /__w/calibre/calibre/src/calibre/devices/kobo/kobotouch_config.py:752
msgid ""
"Use the PNG image format instead of JPG. Higher quality, especially with "
"\"Upload dithered covers\" enabled, which will also help generate "
"potentially smaller files. Behavior completely unknown on old (< 3.x) Kobo "
"firmwares, known to behave on FW >= 4.8. Has no effect without \"Upload "
"black and white covers\"!"
msgstr "Používajte formát obrázkov PNG namiesto JPG. Ponúka vyššiu kvalitu, najmä ak je zapnutá funkcia „Nahrať obaly s ditheringom“, čo zároveň pomôže vytvoriť potenciálne menšie súbory. Správanie je úplne neznáme na starých verziách firmvéru Kobo (< 3.x), pri verziách FW >= 4.8 je však známe. Bez nastavenia „Nahrať čierno-biele obaly“ to nemá žiadny účinok!"

#: /__w/calibre/calibre/src/calibre/devices/kobo/kobotouch_config.py:808
msgid "Show as on device"
msgstr "Zobraziť ako na zariadení"

#: /__w/calibre/calibre/src/calibre/devices/kobo/kobotouch_config.py:817
msgid ""
"Kobo shows recommendations on the device.  In some cases these have files "
"but in other cases they are just pointers to the web site to buy. Enable if "
"you wish to see/delete them."
msgstr "Kobo teraz zobrazuje odporúčania v zariadení.  Niekedy sú to súbory, inokedy len odkazy na web stránku s možnosťou nákupu. Povoľte, ak ich chcete vidieť, resp. zmazať."

#: /__w/calibre/calibre/src/calibre/devices/kobo/kobotouch_config.py:825
msgid "Show archived books"
msgstr "Ukázať archivované knihy"

#: /__w/calibre/calibre/src/calibre/devices/kobo/kobotouch_config.py:827
msgid ""
"Archived books are listed on the device but need to be downloaded to read. "
"Use this option to show these books and match them with books in the calibre"
" library."
msgstr "Zoznam archivovaných kníh sa nachádza na zariadení, ale pre čítanie musia byť stiahnuté. Použite túto možnosť na zobrazenie týchto kníh a spárujte ich s knihami v knižnici calibre."

#: /__w/calibre/calibre/src/calibre/devices/kobo/kobotouch_config.py:862
msgid "Advanced options"
msgstr "Pokročilé možnosti"

#: /__w/calibre/calibre/src/calibre/devices/kobo/kobotouch_config.py:872
msgid ""
"Kobo routinely updates the firmware and the database version. With this "
"option calibre will attempt to perform full read-write functionality - Here "
"be Dragons!! Enable only if you are comfortable with restoring your kobo to "
"factory defaults and testing software. This driver supports firmware V2.x.x "
"and DBVersion up to "
msgstr "Kobo pravidelne aktualizuje verziu firmvéru a databázy. S touto voľbou sa calibre pokúsi aktivovať plnú funkčnosť na čítanie a zápis – pozor, tu číhajú nebezpečenstvá!! Túto voľbu aktivujte len vtedy, ak vám nevadí obnovenie továrenských nastavení vášho zariadenia Kobo a testovanie softvéru. Tento ovládač podporuje firmvér verzie V2.x.x a verziu databázy až do "

#: /__w/calibre/calibre/src/calibre/devices/kobo/kobotouch_config.py:884
msgid "Title to test when debugging"
msgstr "Titul pre test počas diagnostiky"

#: /__w/calibre/calibre/src/calibre/devices/kobo/kobotouch_config.py:886
#: /__w/calibre/calibre/src/calibre/devices/kobo/kobotouch_config.py:896
msgid ""
"Part of title of a book that can be used when doing some tests for "
"debugging. The test is to see if the string is contained in the title of a "
"book. The better the match, the less extraneous output."
msgstr "Časť titulu knihy, ktorá môže byť použitá na testy diagnostiky. Testuje sa, či je reťazec obsiahnutý v titule knihy. Čím lepšia zhoda, tým menej nadbytočný výstup."

#: /__w/calibre/calibre/src/calibre/devices/kobo/kobotouch_config.py:892
msgid "Title to test when debugging:"
msgstr "Názov na testovanie pri ladení:"

#: /__w/calibre/calibre/src/calibre/devices/kobo/kobotouch_config.py:920
msgid "Update metadata on the device"
msgstr "Aktualizovať metadáta v zariadení"

#: /__w/calibre/calibre/src/calibre/devices/kobo/kobotouch_config.py:931
msgid ""
"Update the metadata on the device when it is connected. Be careful when "
"doing this as it will take time and could make the initial connection take a"
" long time."
msgstr "Aktualizovať metadáta v zariadení, pokiaľ je pripojené. Buďte opatrní, pokiaľ to robíte, pretože to bude nejakú dobu trvať a mohlo by to spôsobiť, že počiatočné pripojenie bude trvať dlho."

#: /__w/calibre/calibre/src/calibre/devices/kobo/kobotouch_config.py:938
msgid "Set series information"
msgstr "Nastaviť informácie o sérii"

#: /__w/calibre/calibre/src/calibre/devices/kobo/kobotouch_config.py:940
msgid ""
"The book lists on the Kobo devices can display series information. This is "
"not read by the device from the sideloaded books. Series information can "
"only be added to the device after the book has been processed by the device."
" Enable if you wish to set series information."
msgstr "Zoznam kníh na zariadeniach Kobo môže zobrazovať informácie o sérii. Toto nenačítalo zariadenie z nahratých kníh. Informácie o sérii môžu byť pridané do zariadenia až potom, čo bola kniha spracovaná zariadením. Povoľte, pokiaľ chcete nastaviť informácie o sérii. "

#: /__w/calibre/calibre/src/calibre/devices/kobo/kobotouch_config.py:949
msgid "Force series ID"
msgstr "Vynútiť ID série"

#: /__w/calibre/calibre/src/calibre/devices/kobo/kobotouch_config.py:951
msgid ""
"Kobo devices use a SeriesID to distinguish between different series. "
"Purchased books have a SeriesID assigned by Kobo. Sideloaded books have a "
"SeriesID assigned by calibre, which is usually different. This causes a "
"series to be shown twice on the Kobo device. Enable if you wish to force all"
" the SeriesID for books in a series to the same value."
msgstr "Zariadenia Kobo používajú identifikátor SeriesID na rozlišovanie medzi rôznymi sériami. Zakúpeným knihám priraďuje identifikátor SeriesID spoločnosť Kobo. Knihy nahrané z iného zdroja majú identifikátor SeriesID priradený programom calibre, ktorý sa zvyčajne líši. To má za následok, že sa séria na zariadení Kobo zobrazuje dvakrát. Túto funkciu zapnite, ak chcete vynútiť, aby mali všetky knihy v sérii rovnakú hodnotu identifikátora SeriesID."

#: /__w/calibre/calibre/src/calibre/devices/kobo/kobotouch_config.py:961
msgid "Series number template:"
msgstr "Šablóna čísla série:"

#: /__w/calibre/calibre/src/calibre/devices/kobo/kobotouch_config.py:962
msgid ""
"Use a template to generate what the Kobo displays for the series number."
msgstr "Použite šablónu na vytvorenie toho, čo Kobo zobrazuje ako číslo série."

#: /__w/calibre/calibre/src/calibre/devices/kobo/kobotouch_config.py:970
#, python-brace-format
msgid ""
"The Kobo can display a series number (book number) when books are in a "
"series. To do this, the Kobo uses two values, the \"series number\" (a "
"floating point value) and the \"series text\" (a string). The series number "
"is used for sorting. The series text is what is displayed. Normally the "
"series text is the same as the series number. This option lets you choose a "
"different value for the series text.</p><p>A common use is to change the "
"series text to the empty string when the series number is zero. This General"
" Program Mode template does that: {0}You can do more complicated things such"
" as have an omnibus display \"5 to 9\". How you do this depends on how you "
"have set up the series in calibre."
msgstr "Čítačka Kobo môže zobrazovať číslo série (číslo knihy), ak sú knihy súčasťou série. Na tento účel čítačka Kobo používa dve hodnoty: „číslo série“ (hodnota s desatinnou čiarkou) a „text série“ (reťazec znakov). Číslo série sa používa na triedenie. Text série je to, čo sa zobrazuje. Zvyčajne je text série rovnaký ako číslo série. Táto možnosť vám umožňuje zvoliť inú hodnotu pre text série. </p><p> Bežným použitím je zmena textu série na prázdny reťazec, keď je číslo série nula. Táto šablóna všeobecného programového režimu robí toto: {0}Môžete robiť zložitejšie veci, ako napríklad zobraziť v omnibusovej knihe „5 až 9“. Ako to urobíte, závisí od toho, ako ste sériu nastavili v programe calibre."

#: /__w/calibre/calibre/src/calibre/devices/kobo/kobotouch_config.py:988
msgid "Update metadata on Book Details pages"
msgstr "Aktualizovať metadáta na stránkach podrobností knihy"

#: /__w/calibre/calibre/src/calibre/devices/kobo/kobotouch_config.py:990
msgid ""
"This will update the metadata in the device database when the device is "
"connected. The metadata updated is displayed on the device in the library "
"and the Book details page. This is the title, authors, comments/synopsis, "
"series name and number, publisher and published Date, ISBN and language. If "
"a metadata plugboard exists for the device and book format, this will be "
"used to set the metadata."
msgstr "Toto aktualizuje metadáta v databáze zariadenia pri pripojení zariadenia. Aktualizované metadáta sa zobrazujú na zariadení v knižnici a na stránke Podrobnosti o knihe. Ide o názov, autorov, komentáre/synopsu, názov a číslo série, vydavateľa, dátum vydania, ISBN a jazyk. Ak pre zariadenie a formát knihy existuje ovládací panel metadát, použije sa na nastavenie metadát."

#: /__w/calibre/calibre/src/calibre/devices/kobo/kobotouch_config.py:999
msgid "Update purchased books"
msgstr "Aktualizovať zakúpené knihy"

#: /__w/calibre/calibre/src/calibre/devices/kobo/kobotouch_config.py:1000
msgid "Update books purchased from Kobo and downloaded to the device."
msgstr "Aktualizujte knihy zakúpené v obchode Kobo a stiahnuté do zariadenia."

#: /__w/calibre/calibre/src/calibre/devices/kobo/kobotouch_config.py:1004
msgid "Subtitle"
msgstr "Podnadpis"

#: /__w/calibre/calibre/src/calibre/devices/kobo/kobotouch_config.py:1004
msgid "Update the subtitle on the device using a template."
msgstr "Aktualizovať podnázov na zariadení pomocou šablóny."

#: /__w/calibre/calibre/src/calibre/devices/kobo/kobotouch_config.py:1009
msgid ""
"Enter a template to use to set the subtitle. If the template is empty, the "
"subtitle will be cleared."
msgstr "Zadajte šablónu na nastavenie podnázvu. Ak je šablóna prázdna, podnázov sa vymaže."

#: /__w/calibre/calibre/src/calibre/devices/kobo/kobotouch_config.py:1011
msgid "Book stats"
msgstr "Štatistiky knihy"

#: /__w/calibre/calibre/src/calibre/devices/kobo/kobotouch_config.py:1011
msgid "Update the book stats "
msgstr "Aktualizovať štatistiky knihy "

#: /__w/calibre/calibre/src/calibre/devices/kobo/kobotouch_config.py:1015
msgid "Words:"
msgstr "Slová:"

#: /__w/calibre/calibre/src/calibre/devices/kobo/kobotouch_config.py:1016
msgid ""
"Enter a template to use to set the word count for the book. If the template "
"is empty, the word count will be cleared."
msgstr "Zadajte šablónu na nastavenie počtu slov knihy. Ak je šablóna prázdna, počet slov sa vymaže."

#: /__w/calibre/calibre/src/calibre/devices/kobo/kobotouch_config.py:1019
#: /__w/calibre/calibre/src/calibre/gui2/library/models.py:243
#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/bookshelf_view.py:329
#: /__w/calibre/calibre/src/calibre/library/field_metadata.py:269
msgid "Pages"
msgstr "Strany"

#: /__w/calibre/calibre/src/calibre/devices/kobo/kobotouch_config.py:1021
msgid "Pages:"
msgstr "Strany:"

#: /__w/calibre/calibre/src/calibre/devices/kobo/kobotouch_config.py:1022
msgid ""
"Enter a template to use to set the page count for the book. If the template "
"is empty, the page count will be cleared."
msgstr "Zadajte šablónu na nastavenie počtu strán knihy. Ak je šablóna prázdna, počet strán sa vymaže."

#: /__w/calibre/calibre/src/calibre/devices/kobo/kobotouch_config.py:1025
msgid "Hours to read estimates:"
msgstr "Odhady hodín čítania:"

#: /__w/calibre/calibre/src/calibre/devices/kobo/kobotouch_config.py:1027
msgid "Upper estimate"
msgstr "Horný odhad"

#: /__w/calibre/calibre/src/calibre/devices/kobo/kobotouch_config.py:1029
msgid "Upper:"
msgstr "Horný:"

#: /__w/calibre/calibre/src/calibre/devices/kobo/kobotouch_config.py:1031
msgid ""
"Enter a template to use to set the upper estimate of the time to read for "
"the book. The estimate is in hours. If the template is empty, the time will "
"be cleared."
msgstr "Zadajte šablónu na nastavenie horného odhadu času čítania knihy. Odhad je v hodinách. Ak je šablóna prázdna, čas sa vymaže."

#: /__w/calibre/calibre/src/calibre/devices/kobo/kobotouch_config.py:1037
msgid "Lower estimate"
msgstr "Dolný odhad"

#: /__w/calibre/calibre/src/calibre/devices/kobo/kobotouch_config.py:1039
msgid "Lower:"
msgstr "Dolný:"

#: /__w/calibre/calibre/src/calibre/devices/kobo/kobotouch_config.py:1041
msgid ""
"Enter a template to use to set the lower estimate of the time to read for "
"the book. The estimate is in hours. If the template is empty, the time will "
"be cleared."
msgstr "Zadajte šablónu na nastavenie dolného odhadu času čítania knihy. Odhad je v hodinách. Ak je šablóna prázdna, čas sa vymaže."

#: /__w/calibre/calibre/src/calibre/devices/kobo/kobotouch_config.py:1198
