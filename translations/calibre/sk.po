#, python-brace-format
msgid "{action} {action_data}"
msgstr "{action} {action_data}"

#: /__w/calibre/calibre/src/calibre/gui2/css_transform_rules.py:108
msgid "The CSS property value"
msgstr "Hodnota vlastnosti CSS"

#: /__w/calibre/calibre/src/calibre/gui2/css_transform_rules.py:115
msgid ""
"Either a CSS length, such as 10pt or a unit less number. If a unit less "
"number is used it will be compared with the CSS value using whatever unit "
"the value has. Note that comparison automatically converts units, except for"
" relative units like percentage or em, for which comparison fails if the "
"units are different."
msgstr "Buď dĺžka CSS, ako 10pt, alebo číslo bez jednotky. Ak sa použije číslo bez jednotky, porovná sa s hodnotou CSS pomocou tej jednotky, akú má hodnota. Upozorňujeme, že porovnanie automaticky konvertuje jednotky, okrem relatívnych jednotiek, ako percento alebo em, pre ktoré porovnanie zlyhá, ak sú jednotky odlišné."

#: /__w/calibre/calibre/src/calibre/gui2/css_transform_rules.py:126
msgid ""
"CSS properties to add to the rule that contains the matching style. You can "
"specify more than one property, separated by semi-colons, for example: "
"color:red; font-weight: bold"
msgstr "Vlastnosti CSS, ktoré sa majú pridať do pravidla obsahujúceho zodpovedajúci štýl. Môžete zadať viac ako jednu vlastnosť oddelenú bodkočiarkami, napríklad: color:red; font-weight: bold"

