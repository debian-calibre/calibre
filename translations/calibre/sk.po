msgstr "Poškodený uložený svet"

#: /__w/calibre/calibre/src/calibre/gui2/cyoa/world.py:1093
#, python-brace-format
msgid "Failed to load the saved world: {}"
msgstr "Nepodarilo sa načítať uložený svet: {}"

#: /__w/calibre/calibre/src/calibre/gui2/cyoa/world.py:1115
msgid "Characters you can play as"
msgstr "Postavy, za ktoré môžete hrať"

#: /__w/calibre/calibre/src/calibre/gui2/cyoa/world.py:1119
msgid "Other characters in this world"
msgstr "Ostatné postavy v tomto svete"

#: /__w/calibre/calibre/src/calibre/gui2/cyoa/world.py:1149
#, python-brace-format
msgid "Permanently remove the saved world \"{}\"? This cannot be undone."
msgstr "Natrvalo odstrániť uložený svet „{}“? Toto sa nedá vrátiť späť."

#: /__w/calibre/calibre/src/calibre/gui2/cyoa/world.py:1212
msgid ""
"Describe the world you want to play in, or choose one of the pre-made "
