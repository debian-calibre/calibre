msgstr "Odstrániť tento svet zo zoznamu uložených svetov"

#: /__w/calibre/calibre/src/calibre/gui2/cyoa/world.py:1043
msgid "&Load saved game"
msgstr "&Načítať uloženú hru"

#: /__w/calibre/calibre/src/calibre/gui2/cyoa/world.py:1044
msgid ""
"Resume a game you saved earlier, or import one that was exported, instead of"
" starting a new one in a new world"
msgstr "Pokračovať v hre, ktorú ste predtým uložili, alebo importovať tú, ktorá bola exportovaná, namiesto spustenia novej v novom svete"

#: /__w/calibre/calibre/src/calibre/gui2/cyoa/world.py:1074
