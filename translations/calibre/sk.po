#: /__w/calibre/calibre/src/calibre/gui2/toc/location.py:326
msgid ""
"Here you can choose a destination for the Table of Contents' entry to point "
"to. First choose a file from the book in the left-most panel. The file will "
"open in the central panel.<p>Then choose a location inside the file. To do "
"so, simply click on the place in the central panel that you want to use as "
"the destination. As you move the mouse around the central panel, a thick "
"green line appears, indicating the precise location that will be selected "
"when you click."
msgstr "Tu môžete vybrať cieľ, na ktorý má ukazovať položka obsahu. Najprv v ľavom paneli vyberte súbor z knihy. Súbor sa otvorí v strednom paneli.<p>Potom vyberte miesto vnútri súboru. To urobíte jednoduchým kliknutím na miesto v strednom paneli, ktoré chcete použiť ako cieľ. Pri pohybe myšou po strednom paneli sa zobrazuje hrubá zelená čiara, ktorá označuje presné miesto, ktoré sa vyberie po kliknutí."

#: /__w/calibre/calibre/src/calibre/gui2/toc/location.py:340
msgid "Na&me of the ToC entry:"
msgstr "Ná&zov položky obsahu:"

#: /__w/calibre/calibre/src/calibre/gui2/toc/location.py:347
