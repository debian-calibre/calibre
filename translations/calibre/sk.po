#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/tb_icon_rules.py:484
msgid "For children"
msgstr "Pre deti"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/tb_icon_rules.py:504
msgid "This icon shows in the row if the rule is deleted"
msgstr "Táto ikona sa zobrazí v riadku, ak je pravidlo odstránené"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/tb_icon_rules.py:506
msgid ""
"The name of the category. Select a cell in this column to delete a row."
msgstr "Názov kategórie. Vyberte bunku v tomto stĺpci na odstránenie riadku."

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/tb_icon_rules.py:511
msgid ""
"The value in the category the rule is applied to. If the value doesn't exist"
" in the library then an error icon is shown, in which case you can edit the "
"cell to pick the correct value."
msgstr "Hodnota v kategórii, na ktorú sa pravidlo aplikuje. Ak hodnota v knižnici neexistuje, zobrazí sa ikona chyby, v takom prípade môžete upraviť bunku a vybrať správnu hodnotu."

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/tb_icon_rules.py:519
msgid "This icon shows in the row if the icon or template is modified."
msgstr "Táto ikona sa zobrazí v riadku, ak je ikona alebo šablóna upravená."

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/tb_icon_rules.py:521
msgid "The file name of the icon or the text of the template."
msgstr "Názov súboru ikony alebo text šablóny."

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/tb_icon_rules.py:524
msgid "This icon shows in the row if the \"for children\" setting is modified."
msgstr "Táto ikona sa zobrazí v riadku, ak je upravené nastavenie \"pre deti\"."

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/tb_icon_rules.py:526
msgid "Indicates whether the rule applies to child values."
msgstr "Určuje, či sa pravidlo vzťahuje na hodnoty potomkov."

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/tb_icon_rules.py:671
msgid "Delete this rule"
msgstr "Odstrániť toto pravidlo"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/tb_icon_rules.py:674
msgid "Undo delete"
msgstr "Vrátiť odstránenie"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/tb_icon_rules.py:679
msgid "Modify this value"
msgstr "Upraviť túto hodnotu"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/tb_icon_rules.py:682
msgid "Undo modification"
msgstr "Vrátiť úpravu"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/tb_icon_rules_ui.py:71
msgid "Show icons on &categories in the Tag browser"
msgstr "Zobraziť ikony pri &kategóriách v prehliadači značiek"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/tb_icon_rules_ui.py:72
msgid "Show icons on &values in the Tag browser"
msgstr "Zobraziť ikony pri &hodnotách v prehliadači značiek"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/tb_icon_rules_ui.py:73
msgid "Value icon rules"
msgstr "Pravidlá ikon podľa hodnoty"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/tb_icon_rules_ui.py:74
msgid ""
"<p>View all the defined value icon rules, including template rules.\n"
"Rules are defined and edited in the Tag browser context menus. Rules can be deleted in\n"
"this dialog by selecting the Category cell then using the button, the delete key,\n"
"or the context menu. The value icon rules are defined per-user, not per-library.</p>"
msgstr "<p>Zobraziť všetky definované pravidlá ikon hodnôt vrátane šablónových pravidiel.\nPravidlá sa definujú a upravujú v kontextových ponukách prehliadača značiek. Pravidlá je možné odstrániť v\ntomto dialógu výberom bunky kategórie a následným použitím tlačidla, klávesu delete,\nalebo kontextovej ponuky. Pravidlá ikon hodnôt sa definujú pre jednotlivého používateľa, nie pre knižnicu.</p>"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/tb_icon_rules_ui.py:78
msgid "Show only categories and values available in the current library"
msgstr "Zobraziť iba kategórie a hodnoty dostupné v aktuálnej knižnici"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/tb_icon_rules_ui.py:79
msgid ""
"This check box cannot be changed after any other changes have been made.\n"
"Otherwise all edits would be lost."
msgstr "Toto začiarkavacie políčko nemožno zmeniť po vykonaní akýchkoľvek iných zmien.\nInak by sa všetky úpravy stratili."

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/tb_icon_rules_ui.py:81
msgid ""
"Delete the selected rule. The Category cell for the rule must be selected"
msgstr "Odstrániť vybrané pravidlo. Musí byť vybraná bunka kategórie pre pravidlo"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/tb_icon_rules_ui.py:82
msgid "Edit the selected cell"
msgstr "Upraviť vybranú bunku"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/tb_icon_rules_ui.py:83
msgid "Undo changes in the selected cell, if any."
msgstr "Vrátiť zmeny vo vybranej bunke, ak existujú."

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/tb_icon_rules_ui.py:84
msgid ""
"Add a new rule. The rule is added immediately. If you decide you don't\n"
"want it then you must delete it."
msgstr "Pridať nové pravidlo. Pravidlo sa pridá okamžite. Ak sa rozhodnete, že ho\nnechcete, musíte ho odstrániť."

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/tb_partitioning.py:67
msgid "By first letter"
msgstr "Podľa prvého písmena"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/tb_partitioning.py:67
msgid "Partitioned"
msgstr "Rozčlenený"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/tb_partitioning_ui.py:75
msgid "&Category partitioning method:"
msgstr "&Metóda rozdeľovania kategórie:"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/tb_partitioning_ui.py:76
msgid ""
"<p>Choose how Tag browser subcategories are displayed when\n"
"there are more items than the limit. Select by first\n"
"letter to see an A, B, C list. Choose partitioned to\n"
"have a list of fixed-sized groups. Set to disabled\n"
"if you never want subcategories</p>"
msgstr "<p>Vyberte, ako sa majú zobrazovať podkategórie prehliadača značiek, keď\nje viac položiek, ako je limit. Vyberte podľa prvého\npísmena, ak chcete zobraziť zoznam A, B, C. Vyberte rozdelené,\nak chcete zoznam skupín s pevnou veľkosťou. Nastavte na vypnuté,\nak nikdy nechcete podkategórie</p>"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/tb_partitioning_ui.py:81
msgid "Combine letters &when fewer items than:"
msgstr "Zlúčiť písmená, &keď je menej položiek ako:"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/tb_partitioning_ui.py:82
msgid ""
"<p>If collapsing by first letter, combine adjacent letters together if\n"
"there are fewer items under a letter than specified here. If the partition method is\n"
"not set to first letter, this value is ignored. Set to zero to disable.</p>"
msgstr "<p>Pri zbaľovaní podľa prvého písmena spojte susedné písmená, ak je\npod daným písmenom menej položiek, ako je tu určené. Ak metóda rozdelenia\nnie je nastavená na prvé písmeno, táto hodnota sa ignoruje. Nastavením na nulu ju vypnete.</p>"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/tb_partitioning_ui.py:85
msgid "Co&llapse when more items than:"
msgstr "&Zbaliť, keď je viac položiek ako:"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/tb_partitioning_ui.py:86
msgid ""
"<p>If a Tag browser category has more than this number of items, it is divided\n"
"up into subcategories. If the partition method is set to disable, this value is ignored.</p>"
msgstr "<p>Ak má kategória prehliadača značiek viac ako tento počet položiek, rozdelí sa\nna podkategórie. Ak je metóda rozdeľovania nastavená na zakázané, táto hodnota sa ignoruje.</p>"

#: /__w/calibre/calibre/src/calibre/gui2/preferences/look_feel_tabs/tb_partitioning_ui.py:88
msgid ""
"<p>Check the box for categories that are to\n"
"be partitioned using the criteria above. Uncheck the box if you don't want to\n"
"partition a category even if the number of items is larger than\n"
"the value shown above. This option can be used to\n"
"avoid collapsing hierarchical categories that have only\n"
"a few top-level elements.</p>"
msgstr "<p>Začiarknite políčko pri kategóriách, ktoré sa majú\nrozdeliť podľa vyššie uvedených kritérií. Zrušte začiarknutie, ak nechcete\nkategóriu rozdeliť, ani keď je počet položiek väčší ako\nvyššie uvedená hodnota. Táto voľba sa dá použiť na\nzabránenie zbaľovaniu hierarchických kategórií, ktoré majú len\nniekoľko prvkov najvyššej úrovne.</p>"

