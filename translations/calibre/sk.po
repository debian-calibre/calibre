#: /__w/calibre/calibre/src/calibre/gui2/toc/main.py:65
msgid "Create ToC from XPath"
msgstr "Vytvoriť obsah z XPath"

#: /__w/calibre/calibre/src/calibre/gui2/toc/main.py:70
msgid ""
"Specify a series of XPath expressions for the different levels of the Table "
"of Contents. You can use the wizard buttons to help you create XPath "
"expressions."
msgstr "Zadajte sériu výrazov XPath pre rôzne úrovne obsahu. Na pomoc pri vytváraní výrazov XPath môžete použiť tlačidlá sprievodcu."

#: /__w/calibre/calibre/src/calibre/gui2/toc/main.py:79
#, python-format
msgid "Level %s ToC:"
msgstr "Obsah úrovne %s:"

#: /__w/calibre/calibre/src/calibre/gui2/toc/main.py:96
msgid "Do not add duplicate entries at the same level"
msgstr "Nepridávať duplicitné položky na rovnakej úrovni"

#: /__w/calibre/calibre/src/calibre/gui2/toc/main.py:106
msgid "No XPaths"
msgstr "Žiadne XPath"

#: /__w/calibre/calibre/src/calibre/gui2/toc/main.py:106
msgid "No XPaths have been entered"
msgstr "Neboli zadané žiadne XPath"

#: /__w/calibre/calibre/src/calibre/gui2/toc/main.py:146
#, python-format
msgid "The XPath expression %s is not valid."
msgstr "Výraz XPath %s nie je platný."

#: /__w/calibre/calibre/src/calibre/gui2/toc/main.py:196
msgid ""
"You can edit existing entries in the Table of Contents by clicking them in "
"the panel to the left."
msgstr "Existujúce položky v obsahu môžete upraviť kliknutím na ne v paneli vľavo."

#: /__w/calibre/calibre/src/calibre/gui2/toc/main.py:199
msgid ""
"Entries with a green tick next to them point to a location that has been "
"verified to exist. Entries with a red dot are broken and may need to be "
"fixed."
msgstr "Položky so zelenou fajkou vedľa nich odkazujú na overene existujúce umiestnenie. Položky s červenou bodkou sú nefunkčné a možno ich bude potrebné opraviť."

#: /__w/calibre/calibre/src/calibre/gui2/toc/main.py:209
msgid "Create a &new entry"
msgstr "Vytvoriť &novú položku"

#: /__w/calibre/calibre/src/calibre/gui2/toc/main.py:214
msgid "Generate ToC from &major headings"
msgstr "Vygenerovať obsah z &hlavných nadpisov"

#: /__w/calibre/calibre/src/calibre/gui2/toc/main.py:219
msgid ""
"Generate a Table of Contents from the major headings in the book. This will "
"work if the book identifies its headings using HTML heading tags. Uses the "
"<h1>, <h2> and <h3> tags."
msgstr "Vygenerovať obsah z hlavných nadpisov v knihe. Toto bude fungovať, ak kniha identifikuje svoje nadpisy pomocou značiek nadpisov HTML. Používa značky <h1>, <h2> a <h3>."

#: /__w/calibre/calibre/src/calibre/gui2/toc/main.py:226
msgid "Generate ToC from &all headings"
msgstr "Vygenerovať obsah zo &všetkých nadpisov"

#: /__w/calibre/calibre/src/calibre/gui2/toc/main.py:231
msgid ""
"Generate a Table of Contents from all the headings in the book. This will "
"work if the book identifies its headings using HTML heading tags. Uses the "
"<h1-6> tags."
msgstr "Vygenerovať obsah zo všetkých nadpisov v knihe. Toto bude fungovať, ak kniha identifikuje svoje nadpisy pomocou značiek nadpisov HTML. Používa značky <h1-6>."

#: /__w/calibre/calibre/src/calibre/gui2/toc/main.py:239
msgid "Generate ToC from &links"
msgstr "Vygenerovať obsah z &odkazov"

#: /__w/calibre/calibre/src/calibre/gui2/toc/main.py:244
msgid ""
"Generate a Table of Contents from all the links in the book. Links that "
"point to destinations that do not exist in the book are ignored. Also "
"multiple links with the same destination or the same text are ignored."
msgstr "Vygenerovať obsah zo všetkých odkazov v knihe. Odkazy, ktoré ukazujú na ciele neexistujúce v knihe, sa ignorujú. Ignorujú sa aj viacnásobné odkazy s rovnakým cieľom alebo rovnakým textom."

#: /__w/calibre/calibre/src/calibre/gui2/toc/main.py:253
msgid "Generate ToC from &files"
msgstr "Vygenerovať obsah zo &súborov"

#: /__w/calibre/calibre/src/calibre/gui2/toc/main.py:258
msgid ""
"Generate a Table of Contents from individual files in the book. Each entry "
"in the ToC will point to the start of the file, the text of the entry will "
"be the \"first line\" of text from the file."
msgstr "Vygenerovať obsah z jednotlivých súborov v knihe. Každá položka obsahu bude ukazovať na začiatok súboru, textom položky bude „prvý riadok“ textu zo súboru."

#: /__w/calibre/calibre/src/calibre/gui2/toc/main.py:266
msgid "Generate ToC from &XPath"
msgstr "Vygenerovať obsah z &XPath"

#: /__w/calibre/calibre/src/calibre/gui2/toc/main.py:268
msgid "Generate a Table of Contents from arbitrary XPath expressions."
msgstr "Vygenerovať obsah z ľubovoľných výrazov XPath."

#: /__w/calibre/calibre/src/calibre/gui2/toc/main.py:272
msgid "&Flatten ToC"
msgstr "&Splošiť obsah"

#: /__w/calibre/calibre/src/calibre/gui2/toc/main.py:274
msgid "Flatten the Table of Contents, putting all entries at the top level"
msgstr "Splošiť obsah, umiestniť všetky položky na najvyššiu úroveň"

#: /__w/calibre/calibre/src/calibre/gui2/toc/main.py:276
msgid "&Sort ToC"
msgstr "&Zoradiť obsah"

#: /__w/calibre/calibre/src/calibre/gui2/toc/main.py:281
msgid ""
"<p>Sort the Table of Contents by the order in which the destinations appear "
"in the book.<p>Note that sorting does not move items out of their levels or "
"from one section to another."
msgstr "<p>Zoradiť obsah podľa poradia, v akom sa ciele objavujú v knihe.<p>Upozorňujeme, že triedenie nepresúva položky z ich úrovní ani z jednej sekcie do druhej."

#: /__w/calibre/calibre/src/calibre/gui2/toc/main.py:292
msgid ""
"<b>WARNING:</b> calibre only supports the creation of linear ToCs in AZW3 "
"files. In a linear ToC every entry must point to a location after the "
"previous entry. If you create a non-linear ToC it will be automatically re-"
"arranged inside the AZW3 file."
msgstr "<b>UPOZORNENIE:</b> calibre podporuje vytváranie len lineárnych obsahov v súboroch AZW3. V lineárnom obsahu musí každá položka ukazovať na miesto za predchádzajúcou položkou. Ak vytvoríte nelineárny obsah, v súbore AZW3 sa automaticky preusporiada."

#: /__w/calibre/calibre/src/calibre/gui2/toc/main.py:308
msgid ""
"You can move this entry around the Table of Contents by drag and drop or "
"using the up and down buttons to the left"
msgstr "Túto položku môžete presúvať v obsahu presúvaním alebo pomocou tlačidiel hore a dole vľavo"

#: /__w/calibre/calibre/src/calibre/gui2/toc/main.py:327
msgid "Change the &location this entry points to"
msgstr "Zmeniť &umiestnenie, na ktoré táto položka odkazuje"

#: /__w/calibre/calibre/src/calibre/gui2/toc/main.py:330
msgid "&Remove this entry"
msgstr "&Odobrať túto položku"

#: /__w/calibre/calibre/src/calibre/gui2/toc/main.py:340
msgid "New entry &inside this entry"
msgstr "Nová položka &vnútri tejto položky"

#: /__w/calibre/calibre/src/calibre/gui2/toc/main.py:343
msgid "New entry &above this entry"
msgstr "Nová položka &nad touto položkou"

#: /__w/calibre/calibre/src/calibre/gui2/toc/main.py:346
msgid "New entry &below this entry"
msgstr "Nová položka &pod touto položkou"

#: /__w/calibre/calibre/src/calibre/gui2/toc/main.py:350
msgid "&Flatten this entry"
msgstr "&Splošiť túto položku"

#: /__w/calibre/calibre/src/calibre/gui2/toc/main.py:352
msgid ""
"All children of this entry are brought to the same level as this entry."
msgstr "Všetci potomkovia tejto položky sa presunú na rovnakú úroveň ako táto položka."

#: /__w/calibre/calibre/src/calibre/gui2/toc/main.py:362
msgid "&Return to welcome screen"
msgstr "Vrátiť sa na uvítaciu &obrazovku"

#: /__w/calibre/calibre/src/calibre/gui2/toc/main.py:364
msgid "Go back to the top level view"
msgstr "Vrátiť sa na zobrazenie najvyššej úrovne"

#: /__w/calibre/calibre/src/calibre/gui2/toc/main.py:381
msgid "Configure ToC generation"
msgstr "Nastaviť generovanie obsahu"

#: /__w/calibre/calibre/src/calibre/gui2/toc/main.py:385
msgid "Remove &duplicated headings at the same ToC level"
msgstr "Odstrániť &duplicitné nadpisy na rovnakej úrovni obsahu"

#: /__w/calibre/calibre/src/calibre/gui2/toc/main.py:388
msgid "Use the &title attribute for ToC text"
msgstr "Použiť atribút &title pre text obsahu"

#: /__w/calibre/calibre/src/calibre/gui2/toc/main.py:393
msgid ""
"When a heading tag has the \"title\" attribute use its contents as the text "
"for the ToC entry, instead of the text inside the heading tag itself."
msgstr "Keď má nadpisová značka atribút \"title\", použiť jeho obsah ako text pre položku obsahu namiesto textu vnútri samotnej nadpisovej značky."

#: /__w/calibre/calibre/src/calibre/gui2/toc/main.py:445
msgid "This entry points to an existing destination"
msgstr "Táto položka smeruje na existujúci cieľ"

#: /__w/calibre/calibre/src/calibre/gui2/toc/main.py:448
msgid "The location this entry points to does not exist"
msgstr "Umiestnenie, na ktoré táto položka odkazuje, neexistuje"

