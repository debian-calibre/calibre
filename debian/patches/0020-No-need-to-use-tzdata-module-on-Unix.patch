From: YOKOTA Hiroshi <yokota.hgml@gmail.com>
Date: Fri, 5 Dec 2025 15:34:17 +0900
Subject: No need to use tzdata module on Unix

Forwarded: https://github.com/kovidgoyal/calibre/pull/2920

Windows uses tzdata module for zoneinfo, but Unix uses system's zoneinfo
data.

See also:
  https://docs.python.org/3/library/zoneinfo.html#module-zoneinfo
---
 pyproject.toml            | 1 -
 src/calibre/test_build.py | 3 +--
 2 files changed, 1 insertion(+), 3 deletions(-)

diff --git a/pyproject.toml b/pyproject.toml
index bbcff31..4d2c9dd 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -55,7 +55,6 @@ dependencies = [
 	"PyQt6_WebEngine == 6.10.0",
 	"MacFSEvents == 0.8.4; sys_platform == 'darwin'",
 	"xxhash == 3.6.0",
-    "tzdata == 2026.5",
     "tzlocal == 5.4.4",
 	"pystache == 0.6.8",
 
diff --git a/src/calibre/test_build.py b/src/calibre/test_build.py
index 1ba8ab2..f8c5135 100644
--- a/src/calibre/test_build.py
+++ b/src/calibre/test_build.py
@@ -108,10 +108,9 @@ class BuildTest(unittest.TestCase):
         del CHMFile, chmlib
 
     def test_tzdata(self) -> None:
-        import tzdata
         import tzlocal
 
-        del tzlocal, tzdata
+        del tzlocal
 
     def test_chardet(self) -> None:
         from calibre_extensions.uchardet import detect
