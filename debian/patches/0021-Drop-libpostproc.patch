From: YOKOTA Hiroshi <yokota.hgml@gmail.com>
Date: Fri, 27 Feb 2026 14:16:39 +0900
Subject: Drop libpostproc

FFmpeg 8 drops "libpostproc" and move it to source-plugins.
* https://git.ffmpeg.org/gitweb/ffmpeg.git/commit/fd31df43067fe21cc1e4fabd07ee9d6a26cb7264
---
 setup/build_environment.py | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/setup/build_environment.py b/setup/build_environment.py
index 90840da..3b83d32 100644
--- a/setup/build_environment.py
+++ b/setup/build_environment.py
@@ -241,7 +241,7 @@ else:
     libjxl_inc_dirs = pkgconfig_include_dirs('libjxl', 'LIBJXL_INC_DIR', '/usr/include')
     libjxl_lib_dirs = pkgconfig_lib_dirs('libjxl', 'LIBJXL_LIB_DIR', '/usr/lib')
     libjxl_libs = pkgconfig_libs('libjxl', '', 'jxl') + pkgconfig_libs('libjxl_threads', '', 'jxl_threads') + pkgconfig_libs('libjxl_cms', '', 'jxl_cms')
-    for x in ('libavcodec', 'libavformat', 'libavdevice', 'libavfilter', 'libavutil', 'libpostproc', 'libswresample', 'libswscale'):
+    for x in ('libavcodec', 'libavformat', 'libavdevice', 'libavfilter', 'libavutil', 'libswresample', 'libswscale'):
         for inc in pkgconfig_include_dirs(x, '', '/usr/include'):
             if inc and inc not in ffmpeg_inc_dirs:
                 ffmpeg_inc_dirs.append(inc)
